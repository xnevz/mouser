<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ResourceDictionary.ThemeDictionaries>

    <ResourceDictionary x:Key="Dark">
      <SolidColorBrush x:Key="BgApp">#0f0e0c</SolidColorBrush>
      <SolidColorBrush x:Key="BgSidebar">#161411</SolidColorBrush>
      <SolidColorBrush x:Key="BgSurface">#1b1915</SolidColorBrush>
      <SolidColorBrush x:Key="BgRaised">#23201b</SolidColorBrush>
      <SolidColorBrush x:Key="BgInput">#1f1c17</SolidColorBrush>
      <SolidColorBrush x:Key="BgListItem">#1d1a15</SolidColorBrush>
      <SolidColorBrush x:Key="BgSunken">#0a0907</SolidColorBrush>
      <SolidColorBrush x:Key="BgHover">#2b2721</SolidColorBrush>
      <SolidColorBrush x:Key="BgActive">#36312a</SolidColorBrush>
      <SolidColorBrush x:Key="BgPressed">#171512</SolidColorBrush>
      <SolidColorBrush x:Key="BorderSubtle">#1e1a14</SolidColorBrush>
      <SolidColorBrush x:Key="BorderStrong">#2a251c</SolidColorBrush>
      <SolidColorBrush x:Key="ControlStrokeColorDefault">#1e1a14</SolidColorBrush>
      <SolidColorBrush x:Key="CardStrokeColorDefault">#181510</SolidColorBrush>
      <SolidColorBrush x:Key="ControlElevationBorderBrush">Transparent</SolidColorBrush>
      <SolidColorBrush x:Key="TextPrimary">#fdf6e3</SolidColorBrush>
      <SolidColorBrush x:Key="TextSecondary">#eee8d5</SolidColorBrush>
      <SolidColorBrush x:Key="TextMuted">#93a1a1</SolidColorBrush>
      <SolidColorBrush x:Key="TextFaint">#657b83</SolidColorBrush>
      <SolidColorBrush x:Key="Accent">#d97706</SolidColorBrush>
      <SolidColorBrush x:Key="AccentHover">#b45309</SolidColorBrush>
      <SolidColorBrush x:Key="AccentPressed">#92400e</SolidColorBrush>
      <SolidColorBrush x:Key="AccentSoft">#f59e0b</SolidColorBrush>
      <SolidColorBrush x:Key="OnAccent">#ffffff</SolidColorBrush>
      <SolidColorBrush x:Key="Success">#859900</SolidColorBrush>
      <SolidColorBrush x:Key="Warning">#b58900</SolidColorBrush>
      <SolidColorBrush x:Key="Danger">#dc322f</SolidColorBrush>
      <SolidColorBrush x:Key="BannerErrorBg">#2b1111</SolidColorBrush>
      <SolidColorBrush x:Key="BannerErrorText">#fca5a5</SolidColorBrush>
      <SolidColorBrush x:Key="BannerWarningBg">#2b210a</SolidColorBrush>
      <SolidColorBrush x:Key="BannerWarningText">#fde047</SolidColorBrush>
      <SolidColorBrush x:Key="BannerInfoBg">#261e0e</SolidColorBrush>
      <SolidColorBrush x:Key="BannerInfoBorder">#614a1a</SolidColorBrush>
      <SolidColorBrush x:Key="BannerInfoText">#fde68a</SolidColorBrush>
      <SolidColorBrush x:Key="PeerBg">#1b220f</SolidColorBrush>
      <SolidColorBrush x:Key="PeerBorder">#475e1b</SolidColorBrush>
      <SolidColorBrush x:Key="PillBg">#181f0d</SolidColorBrush>
      <SolidColorBrush x:Key="BadgeBg">#282319</SolidColorBrush>
      <SolidColorBrush x:Key="BadgeViolet">#f59e0b</SolidColorBrush>
    </ResourceDictionary>

    <ResourceDictionary x:Key="Light">
      <SolidColorBrush x:Key="BgApp">#fbf7ee</SolidColorBrush>
      <SolidColorBrush x:Key="BgSidebar">#f3ede0</SolidColorBrush>
      <SolidColorBrush x:Key="BgSurface">#fffdf7</SolidColorBrush>
      <SolidColorBrush x:Key="BgRaised">#f5efe4</SolidColorBrush>
      <SolidColorBrush x:Key="BgInput">#ffffff</SolidColorBrush>
      <SolidColorBrush x:Key="BgListItem">#ffffff</SolidColorBrush>
      <SolidColorBrush x:Key="BgSunken">#ece4d3</SolidColorBrush>
      <SolidColorBrush x:Key="BgHover">#e2d9c6</SolidColorBrush>
      <SolidColorBrush x:Key="BgActive">#d6ccb7</SolidColorBrush>
      <SolidColorBrush x:Key="BgPressed">#c7bca5</SolidColorBrush>
      <SolidColorBrush x:Key="BorderSubtle">#dcd2bf</SolidColorBrush>
      <SolidColorBrush x:Key="BorderStrong">#b3a790</SolidColorBrush>
      <SolidColorBrush x:Key="TextPrimary">#073642</SolidColorBrush>
      <SolidColorBrush x:Key="TextSecondary">#586e75</SolidColorBrush>
      <SolidColorBrush x:Key="TextMuted">#657b83</SolidColorBrush>
      <SolidColorBrush x:Key="TextFaint">#839496</SolidColorBrush>
      <SolidColorBrush x:Key="Accent">#b45309</SolidColorBrush>
      <SolidColorBrush x:Key="AccentHover">#92400e</SolidColorBrush>
      <SolidColorBrush x:Key="AccentPressed">#78350f</SolidColorBrush>
      <SolidColorBrush x:Key="AccentSoft">#d97706</SolidColorBrush>
      <SolidColorBrush x:Key="OnAccent">#ffffff</SolidColorBrush>
      <SolidColorBrush x:Key="Success">#687800</SolidColorBrush>
      <SolidColorBrush x:Key="Warning">#916d00</SolidColorBrush>
      <SolidColorBrush x:Key="Danger">#b82522</SolidColorBrush>
      <SolidColorBrush x:Key="BannerErrorBg">#fdeced</SolidColorBrush>
      <SolidColorBrush x:Key="BannerErrorText">#b82522</SolidColorBrush>
      <SolidColorBrush x:Key="BannerWarningBg">#fef8e7</SolidColorBrush>
      <SolidColorBrush x:Key="BannerWarningText">#916d00</SolidColorBrush>
      <SolidColorBrush x:Key="BannerInfoBg">#fef4e6</SolidColorBrush>
      <SolidColorBrush x:Key="BannerInfoBorder">#fcd39c</SolidColorBrush>
      <SolidColorBrush x:Key="BannerInfoText">#92400e</SolidColorBrush>
      <SolidColorBrush x:Key="PeerBg">#f1f6e4</SolidColorBrush>
      <SolidColorBrush x:Key="PeerBorder">#9bb258</SolidColorBrush>
      <SolidColorBrush x:Key="PillBg">#f1f6e4</SolidColorBrush>
      <SolidColorBrush x:Key="BadgeBg">#ece4d3</SolidColorBrush>
      <SolidColorBrush x:Key="BadgeViolet">#b45309</SolidColorBrush>
    </ResourceDictionary>

  </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>
