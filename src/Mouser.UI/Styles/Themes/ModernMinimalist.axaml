<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- "Signal": blue graphite surfaces, one cornflower accent, status colours reserved for link state. -->
  <ResourceDictionary.ThemeDictionaries>

    <ResourceDictionary x:Key="Dark">
      <SolidColorBrush x:Key="BgApp">#11151d</SolidColorBrush>
      <SolidColorBrush x:Key="BgSidebar">#0c1017</SolidColorBrush>
      <SolidColorBrush x:Key="BgSurface">#161b25</SolidColorBrush>
      <SolidColorBrush x:Key="BgRaised">#1c2230</SolidColorBrush>
      <SolidColorBrush x:Key="BgInput">#131823</SolidColorBrush>
      <SolidColorBrush x:Key="BgListItem">#171c27</SolidColorBrush>
      <SolidColorBrush x:Key="BgSunken">#0e121a</SolidColorBrush>
      <SolidColorBrush x:Key="BgHover">#212838</SolidColorBrush>
      <SolidColorBrush x:Key="BgActive">#1e2943</SolidColorBrush>
      <SolidColorBrush x:Key="BgPressed">#1a2030</SolidColorBrush>
      <SolidColorBrush x:Key="BorderSubtle">#232a38</SolidColorBrush>
      <SolidColorBrush x:Key="BorderStrong">#323c50</SolidColorBrush>
      <SolidColorBrush x:Key="ControlStrokeColorDefault">#232a38</SolidColorBrush>
      <SolidColorBrush x:Key="CardStrokeColorDefault">#20273a</SolidColorBrush>
      <SolidColorBrush x:Key="ControlElevationBorderBrush">Transparent</SolidColorBrush>
      <SolidColorBrush x:Key="TextPrimary">#eef1f6</SolidColorBrush>
      <SolidColorBrush x:Key="TextSecondary">#c3cad8</SolidColorBrush>
      <SolidColorBrush x:Key="TextMuted">#8f99ad</SolidColorBrush>
      <SolidColorBrush x:Key="TextFaint">#687287</SolidColorBrush>
      <SolidColorBrush x:Key="Accent">#4f6bed</SolidColorBrush>
      <SolidColorBrush x:Key="AccentHover">#6a84f5</SolidColorBrush>
      <SolidColorBrush x:Key="AccentPressed">#3d58d6</SolidColorBrush>
      <SolidColorBrush x:Key="AccentSoft">#8ea3ff</SolidColorBrush>
      <SolidColorBrush x:Key="OnAccent">#ffffff</SolidColorBrush>
      <SolidColorBrush x:Key="Success">#34d399</SolidColorBrush>
      <SolidColorBrush x:Key="Warning">#fbbf24</SolidColorBrush>
      <SolidColorBrush x:Key="Danger">#fb7185</SolidColorBrush>
      <SolidColorBrush x:Key="BannerErrorBg">#2a1620</SolidColorBrush>
      <SolidColorBrush x:Key="BannerErrorText">#fecdd3</SolidColorBrush>
      <SolidColorBrush x:Key="BannerWarningBg">#2a2314</SolidColorBrush>
      <SolidColorBrush x:Key="BannerWarningText">#fde68a</SolidColorBrush>
      <SolidColorBrush x:Key="BannerInfoBg">#161f36</SolidColorBrush>
      <SolidColorBrush x:Key="BannerInfoBorder">#34477a</SolidColorBrush>
      <SolidColorBrush x:Key="BannerInfoText">#c9d5ff</SolidColorBrush>
      <SolidColorBrush x:Key="PeerBg">#122a2a</SolidColorBrush>
      <SolidColorBrush x:Key="PeerBorder">#2b7a6f</SolidColorBrush>
      <SolidColorBrush x:Key="PillBg">#13261f</SolidColorBrush>
      <SolidColorBrush x:Key="BadgeBg">#1f2738</SolidColorBrush>
      <SolidColorBrush x:Key="BadgeViolet">#a5b4fc</SolidColorBrush>
    </ResourceDictionary>

    <ResourceDictionary x:Key="Light">
      <SolidColorBrush x:Key="BgApp">#f3f5f9</SolidColorBrush>
      <SolidColorBrush x:Key="BgSidebar">#e8ecf3</SolidColorBrush>
      <SolidColorBrush x:Key="BgSurface">#ffffff</SolidColorBrush>
      <SolidColorBrush x:Key="BgRaised">#f5f7fb</SolidColorBrush>
      <SolidColorBrush x:Key="BgInput">#ffffff</SolidColorBrush>
      <SolidColorBrush x:Key="BgListItem">#ffffff</SolidColorBrush>
      <SolidColorBrush x:Key="BgSunken">#eceff5</SolidColorBrush>
      <SolidColorBrush x:Key="BgHover">#e1e6f0</SolidColorBrush>
      <SolidColorBrush x:Key="BgActive">#dce4fb</SolidColorBrush>
      <SolidColorBrush x:Key="BgPressed">#d2dbee</SolidColorBrush>
      <SolidColorBrush x:Key="BorderSubtle">#d9dfe9</SolidColorBrush>
      <SolidColorBrush x:Key="BorderStrong">#c1cad9</SolidColorBrush>
      <SolidColorBrush x:Key="ControlStrokeColorDefault">#d9dfe9</SolidColorBrush>
      <SolidColorBrush x:Key="CardStrokeColorDefault">#dde2ec</SolidColorBrush>
      <SolidColorBrush x:Key="ControlElevationBorderBrush">Transparent</SolidColorBrush>
      <SolidColorBrush x:Key="TextPrimary">#121722</SolidColorBrush>
      <SolidColorBrush x:Key="TextSecondary">#364055</SolidColorBrush>
      <SolidColorBrush x:Key="TextMuted">#5a6479</SolidColorBrush>
      <SolidColorBrush x:Key="TextFaint">#6e778b</SolidColorBrush>
      <SolidColorBrush x:Key="Accent">#3f5fe0</SolidColorBrush>
      <SolidColorBrush x:Key="AccentHover">#3452cc</SolidColorBrush>
      <SolidColorBrush x:Key="AccentPressed">#2b45ad</SolidColorBrush>
      <SolidColorBrush x:Key="AccentSoft">#3f5fe0</SolidColorBrush>
      <SolidColorBrush x:Key="OnAccent">#ffffff</SolidColorBrush>
      <SolidColorBrush x:Key="Success">#059669</SolidColorBrush>
      <SolidColorBrush x:Key="Warning">#b45309</SolidColorBrush>
      <SolidColorBrush x:Key="Danger">#e11d48</SolidColorBrush>
      <SolidColorBrush x:Key="BannerErrorBg">#fdecef</SolidColorBrush>
      <SolidColorBrush x:Key="BannerErrorText">#9f1239</SolidColorBrush>
      <SolidColorBrush x:Key="BannerWarningBg">#fef3e2</SolidColorBrush>
      <SolidColorBrush x:Key="BannerWarningText">#92400e</SolidColorBrush>
      <SolidColorBrush x:Key="BannerInfoBg">#eaf0ff</SolidColorBrush>
      <SolidColorBrush x:Key="BannerInfoBorder">#a9bbf2</SolidColorBrush>
      <SolidColorBrush x:Key="BannerInfoText">#2b3f99</SolidColorBrush>
      <SolidColorBrush x:Key="PeerBg">#e2f5f1</SolidColorBrush>
      <SolidColorBrush x:Key="PeerBorder">#5fb7a6</SolidColorBrush>
      <SolidColorBrush x:Key="PillBg">#e3f6ee</SolidColorBrush>
      <SolidColorBrush x:Key="BadgeBg">#e1e6f0</SolidColorBrush>
      <SolidColorBrush x:Key="BadgeViolet">#3f5fe0</SolidColorBrush>
    </ResourceDictionary>

  </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>
