<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Mouser.UI.ViewModels"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="600"
             x:Class="Mouser.UI.Views.MonitorLayoutView"
             x:DataType="vm:MonitorLayoutViewModel">

    <Grid RowDefinitions="Auto,*,Auto" Margin="24">
        <!-- Header Toolbar -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,18">
            <StackPanel Grid.Column="0" Spacing="4">
                <TextBlock Text="Display Matrix" FontSize="20" FontWeight="Bold" Foreground="#f4f4f5" />
                <TextBlock Text="Arrange physical screens to match your desk layout for seamless mouse hopping"
                           FontSize="13" Foreground="#71717a" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <Button Classes="secondary-btn" Command="{Binding AutoArrangeScreensCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="⊞" FontSize="14" />
                        <TextBlock Text="Auto-Arrange" />
                    </StackPanel>
                </Button>

                <Button Classes="primary-btn" Command="{Binding ToggleSharingCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="⇄" FontSize="14" />
                        <TextBlock Text="{Binding IsSharingActive, Converter={x:Null}, StringFormat='Toggle Sharing'}" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Main Workspace Grid: Canvas + Detail Sidebar -->
        <Grid Grid.Row="1" ColumnDefinitions="*,260">
            <!-- Visual Monitor Canvas Card -->
            <Border Grid.Column="0" Classes="glass-card" Margin="0,0,16,0" ClipToBounds="True">
                <Grid>
                    <!-- Background Grid Pattern Guide -->
                    <Border Background="#151518" Opacity="0.8" />

                    <!-- Screen Canvas -->
                    <ItemsControl ItemsSource="{Binding Screens}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <Canvas Width="1000" Height="600" Background="Transparent" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>

                        <ItemsControl.ItemContainerTheme>
                            <ControlTheme TargetType="ContentPresenter" x:DataType="vm:ScreenNodeViewModel">
                                <Setter Property="Canvas.Left" Value="{Binding PositionX}" />
                                <Setter Property="Canvas.Top" Value="{Binding PositionY}" />
                            </ControlTheme>
                        </ItemsControl.ItemContainerTheme>

                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="vm:ScreenNodeViewModel">
                                <Button Background="Transparent"
                                        Padding="0"
                                        BorderThickness="0"
                                        Command="{Binding $parent[UserControl].((vm:MonitorLayoutViewModel)DataContext).SelectScreenCommand}"
                                        CommandParameter="{Binding}">
                                    <Border Width="{Binding DisplayWidth}"
                                            Height="{Binding DisplayHeight}"
                                            Background="#222226"
                                            BorderBrush="{Binding IsSelected, Converter={x:Null}, StringFormat='#3b82f6'}"
                                            BorderThickness="2"
                                            CornerRadius="10"
                                            BoxShadow="0 8 24 0 #40000000">
                                        <Grid RowDefinitions="Auto,*,Auto" Margin="14">
                                            <!-- Screen Header: OS Badge & Indicator -->
                                            <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                                                <TextBlock Grid.Column="0"
                                                           Text="{Binding Hostname}"
                                                           FontWeight="SemiBold"
                                                           FontSize="13"
                                                           Foreground="#ffffff"
                                                           TextTrimming="CharacterEllipsis" />
                                                <Border Grid.Column="1"
                                                        Background="{Binding BadgeColor}"
                                                        CornerRadius="4"
                                                        Padding="6,2">
                                                    <TextBlock Text="{Binding OsType}"
                                                               FontSize="10"
                                                               FontWeight="Bold"
                                                               Foreground="#ffffff" />
                                                </Border>
                                            </Grid>

                                            <!-- Screen Body: Resolution & Monitor Icon -->
                                            <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="4">
                                                <TextBlock Text="🖥" FontSize="26" HorizontalAlignment="Center" Opacity="0.85" />
                                                <TextBlock Text="{Binding Resolution}"
                                                           FontSize="11"
                                                           Foreground="#a1a1aa"
                                                           HorizontalAlignment="Center" />
                                            </StackPanel>

                                            <!-- Screen Footer: Role Tag -->
                                            <Grid Grid.Row="2" ColumnDefinitions="*,Auto">
                                                <TextBlock Grid.Column="0"
                                                           Text="{Binding RoleText}"
                                                           FontSize="11"
                                                           Foreground="#71717a" />
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding IpAddress}"
                                                           FontSize="10"
                                                           Foreground="#52525b" />
                                            </Grid>
                                        </Grid>
                                    </Border>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </Border>

            <!-- Screen Details Sidebar Panel -->
            <Border Grid.Column="1" Classes="glass-card" Padding="18">
                <ScrollViewer>
                    <StackPanel Spacing="16">
                        <TextBlock Text="Selected Display" FontSize="14" FontWeight="SemiBold" Foreground="#f4f4f5" />

                        <StackPanel Spacing="6">
                            <TextBlock Text="Display Name" FontSize="11" Foreground="#71717a" />
                            <TextBox Text="{Binding SelectedScreen.Hostname, FallbackValue='None'}"
                                     Background="#222226"
                                     Foreground="#f4f4f5"
                                     BorderBrush="#3f3f46"
                                     CornerRadius="6" />
                        </StackPanel>

                        <StackPanel Spacing="6">
                            <TextBlock Text="Native Resolution" FontSize="11" Foreground="#71717a" />
                            <TextBox Text="{Binding SelectedScreen.Resolution, FallbackValue='-'}"
                                     IsReadOnly="True"
                                     Background="#1c1c1f"
                                     Foreground="#a1a1aa"
                                     BorderBrush="#2e2e33"
                                     CornerRadius="6" />
                        </StackPanel>

                        <StackPanel Spacing="6">
                            <TextBlock Text="IP Address &amp; Port" FontSize="11" Foreground="#71717a" />
                            <TextBox Text="{Binding SelectedScreen.IpAddress, FallbackValue='-'}"
                                     IsReadOnly="True"
                                     Background="#1c1c1f"
                                     Foreground="#a1a1aa"
                                     BorderBrush="#2e2e33"
                                     CornerRadius="6" />
                        </StackPanel>

                        <Separator Background="#27272a" Margin="0,4" />

                        <TextBlock Text="Matrix Coordinates" FontSize="12" FontWeight="SemiBold" Foreground="#a1a1aa" />
                        <Grid ColumnDefinitions="*,*">
                            <StackPanel Grid.Column="0" Margin="0,0,6,0" Spacing="4">
                                <TextBlock Text="Pos X" FontSize="11" Foreground="#71717a" />
                                <NumericUpDown Value="{Binding SelectedScreen.PositionX}"
                                               Minimum="0" Maximum="2000" Increment="10"
                                               Background="#222226" Foreground="#f4f4f5" CornerRadius="6" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="6,0,0,0" Spacing="4">
                                <TextBlock Text="Pos Y" FontSize="11" Foreground="#71717a" />
                                <NumericUpDown Value="{Binding SelectedScreen.PositionY}"
                                               Minimum="0" Maximum="2000" Increment="10"
                                               Background="#222226" Foreground="#f4f4f5" CornerRadius="6" />
                            </StackPanel>
                        </Grid>

                        <Separator Background="#27272a" Margin="0,4" />

                        <TextBlock Text="Switching Options" FontSize="12" FontWeight="SemiBold" Foreground="#a1a1aa" />
                        <CheckBox Content="Sticky Corner Resistance"
                                  IsChecked="True"
                                  Foreground="#d4d4d8"
                                  FontSize="12" />
                        <CheckBox Content="Synchronize Screen Sleep"
                                  IsChecked="True"
                                  Foreground="#d4d4d8"
                                  FontSize="12" />
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- Status Bottom Bar -->
        <Border Grid.Row="2" Margin="0,14,0,0" Padding="12,8" Background="#18181b" CornerRadius="8" BorderBrush="#27272a" BorderThickness="1">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                    <Ellipse Width="8" Height="8" Fill="{Binding IsSharingActive, Converter={x:Null}, StringFormat='#10b981'}" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding StatusMessage}" FontSize="12" Foreground="#a1a1aa" VerticalAlignment="Center" />
                </StackPanel>

                <TextBlock Grid.Column="2" Text="Zero-Lag LAN Engine: &lt;2ms" FontSize="11" Foreground="#52525b" VerticalAlignment="Center" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
