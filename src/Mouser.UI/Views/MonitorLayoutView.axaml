<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Mouser.UI.ViewModels"
             mc:Ignorable="d" d:DesignWidth="980" d:DesignHeight="640"
             x:Class="Mouser.UI.Views.MonitorLayoutView"
             x:DataType="vm:MonitorLayoutViewModel">

    <UserControl.Styles>
        <Style Selector="Button.screen /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#1c1d26" />
            <Setter Property="BorderBrush" Value="#2e3248" />
        </Style>
        <Style Selector="Button.screen:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#232535" />
        </Style>
        <Style Selector="Button.screen.selected /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="BorderBrush" Value="#6366f1" />
            <Setter Property="Background" Value="#20223a" />
        </Style>
    </UserControl.Styles>

    <ScrollViewer>
        <StackPanel Margin="24" Spacing="16">
            <StackPanel Spacing="4">
                <TextBlock Classes="page-title" Text="Displays &amp; Network" />
                <TextBlock Classes="page-subtitle" Text="{Binding DesktopSummary}" />
            </StackPanel>

            <Grid ColumnDefinitions="*,16,260">
                <Border Grid.Column="0" Classes="glass-card" Padding="12" ClipToBounds="True">
                    <Viewbox Stretch="Uniform" MaxHeight="320">
                        <ItemsControl ItemsSource="{Binding Screens}" Width="640" Height="300">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <Canvas Background="#0f1015" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemContainerTheme>
                                <ControlTheme TargetType="ContentPresenter" x:DataType="vm:ScreenNodeViewModel">
                                    <Setter Property="Canvas.Left" Value="{Binding PositionX}" />
                                    <Setter Property="Canvas.Top" Value="{Binding PositionY}" />
                                </ControlTheme>
                            </ItemsControl.ItemContainerTheme>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="vm:ScreenNodeViewModel">
                                    <Button Classes="screen" Classes.selected="{Binding IsSelected}"
                                            Width="{Binding DisplayWidth}" Height="{Binding DisplayHeight}" Padding="0"
                                            BorderThickness="2"
                                            CornerRadius="8" Cursor="Hand"
                                            Command="{Binding $parent[ItemsControl].((vm:MonitorLayoutViewModel)DataContext).SelectScreenCommand}"
                                            CommandParameter="{Binding}"
                                            ToolTip.Tip="{Binding Name}">
                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="2">
                                            <TextBlock Text="{Binding Number}" FontSize="24" FontWeight="ExtraBold"
                                                       Foreground="#ffffff" HorizontalAlignment="Center" />
                                            <TextBlock Text="{Binding Resolution}" FontSize="10" Foreground="#94a3b8"
                                                       HorizontalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Viewbox>
                </Border>

                <Border Grid.Column="2" Classes="glass-card" Padding="18">
                    <StackPanel Spacing="12">
                        <TextBlock Classes="section-title" Text="{Binding SelectedScreen.Number, StringFormat='Display {0}', FallbackValue='Display'}" />
                        <StackPanel Spacing="2">
                            <TextBlock Classes="label" Text="Name" />
                            <TextBlock Text="{Binding SelectedScreen.Name, FallbackValue='-'}" Foreground="#e2e8f0" TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Spacing="2">
                            <TextBlock Classes="label" Text="Resolution" />
                            <TextBlock Text="{Binding SelectedScreen.Resolution, FallbackValue='-'}" Foreground="#e2e8f0" />
                        </StackPanel>
                        <StackPanel Spacing="2">
                            <TextBlock Classes="label" Text="Scaling" />
                            <TextBlock Text="{Binding SelectedScreen.ScalingText, FallbackValue='-'}" Foreground="#e2e8f0" />
                        </StackPanel>
                        <StackPanel Spacing="2">
                            <TextBlock Classes="label" Text="Position on desktop" />
                            <TextBlock Text="{Binding SelectedScreen.PositionText, FallbackValue='-'}" Foreground="#e2e8f0" />
                        </StackPanel>
                        <StackPanel Spacing="2">
                            <TextBlock Classes="label" Text="Role" />
                            <TextBlock Text="{Binding SelectedScreen.RoleText, FallbackValue='-'}" Foreground="#e2e8f0" />
                        </StackPanel>
                        <TextBlock Classes="hint" FontSize="11"
                                   Text="Arrange or rescale displays in your operating system's display settings; this view updates automatically." />
                    </StackPanel>
                </Border>
            </Grid>

            <Border Classes="glass-card" Padding="18">
                <StackPanel Spacing="12">
                    <TextBlock Classes="section-title" Text="Mouser computers on this network" />

                    <TextBlock Classes="hint" IsVisible="{Binding !HasPeers}"
                               Text="None found. Other computers running Mouser on the same network appear here automatically." />

                    <ItemsControl ItemsSource="{Binding Peers}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="vm:PeerItem">
                                <Grid ColumnDefinitions="*,Auto,Auto" Margin="0,0,0,8">
                                    <TextBlock Grid.Column="0" Text="{Binding Hostname}" FontWeight="SemiBold" Foreground="#f1f5f9" />
                                    <TextBlock Grid.Column="1" Text="{Binding OperatingSystem}" Foreground="#94a3b8" Margin="16,0" />
                                    <SelectableTextBlock Grid.Column="2" Text="{Binding Address}" Foreground="#64748b" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Border Classes="banner-info">
                        <TextBlock Foreground="#c7d2fe" FontSize="12" TextWrapping="Wrap"
                                   Text="Moving your mouse and keyboard from one computer to another isn't available yet. Today Mouser lets a phone control this computer and keeps a clipboard history." />
                    </Border>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
