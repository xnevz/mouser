<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Mouser.UI.ViewModels"
             xmlns:mi="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             mc:Ignorable="d" d:DesignWidth="980" d:DesignHeight="640"
             x:Class="Mouser.UI.Views.MonitorLayoutView"
             x:DataType="vm:MonitorLayoutViewModel">

    <UserControl.Styles>
        <Style Selector="Button.screen /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource BgRaised}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderStrong}" />
        </Style>
        <Style Selector="Button.screen:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource BgHover}" />
        </Style>
        <Style Selector="Button.screen.peer /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource PeerBg}" />
            <Setter Property="BorderBrush" Value="{DynamicResource PeerBorder}" />
        </Style>
        <Style Selector="Button.screen.selected /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentSoft}" />
        </Style>
    </UserControl.Styles>

    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,8,0,24" Spacing="16">
            <TextBlock Classes="page-subtitle"
                       Text="Drag a paired computer to the edge of your screen where it sits. The cursor crosses over at that edge." />

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="240" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" MinWidth="180" MaxWidth="260" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Classes="glass-card" Padding="12" ClipToBounds="True">
                    <Grid RowDefinitions="Auto,*">
                    <TextBlock Classes="label" Text="{Binding DesktopSummary}" Margin="4,0,0,8" TextTrimming="CharacterEllipsis" />
                    <Viewbox Grid.Row="1" Stretch="Uniform" MaxHeight="320">
                        <ItemsControl x:Name="ScreensItemsControl" ItemsSource="{Binding Screens}" Width="640" Height="300">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <Canvas Background="{DynamicResource BgSunken}" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemContainerTheme>
                                <ControlTheme TargetType="ContentPresenter" x:DataType="vm:ScreenNodeViewModel">
                                    <Setter Property="Canvas.Left" Value="{Binding PositionX}" />
                                    <Setter Property="Canvas.Top" Value="{Binding PositionY}" />
                                </ControlTheme>
                            </ItemsControl.ItemContainerTheme>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="vm:ScreenNodeViewModel">
                                    <Button Classes="screen" Classes.selected="{Binding IsSelected}" Classes.peer="{Binding IsPeer}"
                                            Width="{Binding DisplayWidth}" Height="{Binding DisplayHeight}" Padding="4"
                                            BorderThickness="2" CornerRadius="8" Cursor="Hand"
                                            Command="{Binding $parent[ItemsControl].((vm:MonitorLayoutViewModel)DataContext).SelectScreenCommand}"
                                            CommandParameter="{Binding}"
                                            ToolTip.Tip="{Binding Name}">
                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="2">
                                            <TextBlock Text="{Binding Label}" FontSize="18" FontWeight="ExtraBold"
                                                       Foreground="{DynamicResource TextPrimary}" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Resolution}" FontSize="10" Foreground="{DynamicResource TextMuted}"
                                                       HorizontalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Viewbox>
                    </Grid>
                </Border>

                <Border Grid.Column="2" Classes="glass-card" Padding="18">
                    <StackPanel Spacing="12">
                        <mi:MaterialIcon Kind="MonitorMultiple" Width="22" Height="22" HorizontalAlignment="Left" Foreground="{DynamicResource AccentSoft}" />
                        <TextBlock Classes="section-title" Text="{Binding SelectedScreen.Name, FallbackValue='Display'}" TextWrapping="Wrap" />
                        <StackPanel Spacing="2">
                            <TextBlock Classes="label" Text="Resolution" />
                            <TextBlock Text="{Binding SelectedScreen.Resolution, FallbackValue='-'}" Foreground="{DynamicResource TextPrimary}" />
                        </StackPanel>
                        <StackPanel Spacing="2">
                            <TextBlock Classes="label" Text="Scaling" />
                            <TextBlock Text="{Binding SelectedScreen.ScalingText, FallbackValue='-'}" Foreground="{DynamicResource TextPrimary}" />
                        </StackPanel>
                        <StackPanel Spacing="2">
                            <TextBlock Classes="label" Text="Position" />
                            <TextBlock Text="{Binding SelectedScreen.PositionText, FallbackValue='-'}" Foreground="{DynamicResource TextPrimary}" TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Spacing="2">
                            <TextBlock Classes="label" Text="Role" />
                            <TextBlock Text="{Binding SelectedScreen.RoleText, FallbackValue='-'}" Foreground="{DynamicResource TextPrimary}" TextWrapping="Wrap" />
                        </StackPanel>
                        <TextBlock Classes="hint" FontSize="11"
                                   Text="Arrange or rescale your own displays in your system's display settings. This view follows along." />
                    </StackPanel>
                </Border>
            </Grid>

            <Border Classes="glass-card" Padding="18">
                <StackPanel Spacing="12">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Spacing="2">
                            <TextBlock Classes="section-title" Text="Share mouse &amp; keyboard with other computers" />
                            <TextBlock Classes="hint" Text="{Binding KvmStatus}" />
                        </StackPanel>
                        <ToggleSwitch Grid.Column="1" IsChecked="{Binding IsKvmEnabled}" IsEnabled="{Binding CanShareInput}"
                                      OnContent="On" OffContent="Off" VerticalAlignment="Center" />
                    </Grid>

                    <TextBlock Classes="hint" IsVisible="{Binding !HasPeers}"
                               Text="No other Mouser computers found. Start Mouser on another computer on the same network and it appears here." />

                    <ItemsControl ItemsSource="{Binding Peers}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="vm:PeerViewModel">
                                <Border Background="{DynamicResource BgRaised}" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1"
                                        CornerRadius="{DynamicResource ControlCornerRadius}" Padding="14,12" Margin="0,0,0,8">
                                    <StackPanel Spacing="10">
                                        <Grid ColumnDefinitions="Auto,*">
                                            <mi:MaterialIcon Kind="Monitor" Width="18" Height="18" Foreground="{DynamicResource TextMuted}" Margin="0,0,12,0" />
                                            <StackPanel Grid.Column="1" Spacing="2">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <TextBlock Text="{Binding Hostname}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" TextTrimming="CharacterEllipsis" />
                                                    <Ellipse Width="8" Height="8" Fill="{Binding StatusColor}" VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding StatusText}" FontSize="11" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" />
                                                </StackPanel>
                                                <TextBlock FontSize="11" Foreground="{DynamicResource TextFaint}" TextTrimming="CharacterEllipsis">
                                                    <Run Text="{Binding OperatingSystem}" /><Run Text="  " /><Run Text="{Binding Address}" /><Run Text="  " /><Run Text="{Binding ScreenText}" />
                                                </TextBlock>
                                            </StackPanel>
                                        </Grid>

                                        <!-- Not paired -->
                                        <Button Classes="primary-btn" HorizontalAlignment="Left" Command="{Binding PairCommand}"
                                                IsVisible="{Binding !IsPaired}" IsEnabled="{Binding IsOnline}">
                                            <StackPanel Classes="btn">
                                                <mi:MaterialIcon Kind="LanConnect" />
                                                <TextBlock Text="{Binding PairButtonText}" />
                                            </StackPanel>
                                        </Button>

                                        <!-- Paired: choose where it sits; wraps on narrow windows -->
                                        <WrapPanel Orientation="Horizontal" IsVisible="{Binding IsPaired}">
                                            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,12,6">
                                                <TextBlock Text="Sits to the" Foreground="{DynamicResource TextSecondary}" FontSize="12" VerticalAlignment="Center" />
                                                <ComboBox ItemsSource="{x:Static vm:PeerViewModel.PlacementOptions}" SelectedItem="{Binding Placement}" MinWidth="104" />
                                                <TextBlock Text="of this screen" Foreground="{DynamicResource TextSecondary}" FontSize="12" VerticalAlignment="Center" />
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,0,0,6">
                                                <Button Classes="icon-btn" Command="{Binding SendFileCommand}" ToolTip.Tip="Send a file to this computer">
                                                    <mi:MaterialIcon Kind="FileSendOutline" Width="18" Height="18" />
                                                </Button>
                                                <Button Classes="icon-btn" Command="{Binding ForgetCommand}" ToolTip.Tip="Forget this computer">
                                                    <mi:MaterialIcon Kind="LinkOff" Width="18" Height="18" />
                                                </Button>
                                            </StackPanel>
                                        </WrapPanel>

                                        <TextBlock Text="{Binding Error}" Foreground="{DynamicResource Danger}" FontSize="12" TextWrapping="Wrap"
                                                   IsVisible="{Binding Error, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Classes="hint" Text="{Binding TransferStatus}"
                               IsVisible="{Binding TransferStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

                    <Border Classes="banner-info">
                        <Grid ColumnDefinitions="Auto,*">
                            <mi:MaterialIcon Kind="KeyboardOutline" Foreground="{DynamicResource BannerInfoText}" Margin="0,0,10,0" VerticalAlignment="Top" />
                            <TextBlock Grid.Column="1" Foreground="{DynamicResource BannerInfoText}" FontSize="12" TextWrapping="Wrap"
                                       Text="Push the cursor past the edge you picked to control that computer, and come back through the same edge. Ctrl+Alt+Esc or Scroll Lock always brings control back here; pressed on this computer, it locks the cursor to this screen." />
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
