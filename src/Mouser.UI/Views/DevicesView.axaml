<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Mouser.UI.ViewModels"
             xmlns:views="using:Mouser.UI.Views"
             mc:Ignorable="d" d:DesignWidth="980" d:DesignHeight="640"
             x:Class="Mouser.UI.Views.DevicesView"
             x:DataType="vm:DevicesViewModel">

    <Grid ColumnDefinitions="260,*" RowDefinitions="Auto,*,Auto" Margin="24">
        <!-- Top Banners -->
        <StackPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Spacing="8" Margin="0,0,0,16">
            <!-- Elevated window warning banner -->
            <Border Classes="banner-warning" IsVisible="{Binding ForegroundIsElevated}">
                <TextBlock Foreground="{DynamicResource BannerWarningText}" FontSize="12" TextWrapping="Wrap"
                           Text="The window in front runs as administrator. Mouser cannot type or click in it until you run Mouser as administrator." />
            </Border>

            <!-- Pairing countdown banner -->
            <Border Background="{DynamicResource BannerInfoBg}" BorderBrush="{DynamicResource BannerInfoBorder}"
                    BorderThickness="1" CornerRadius="6" Padding="12,8"
                    IsVisible="{Binding IsPairingWindowOpen}">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <TextBlock Text="📡" FontSize="14" VerticalAlignment="Center" />
                        <TextBlock Foreground="{DynamicResource BannerInfoText}" FontSize="13" VerticalAlignment="Center"
                                   Text="{Binding PairingWindowRemainingText}" />
                    </StackPanel>
                    <Button Grid.Column="1" Classes="secondary-btn" Content="Cancel"
                            Command="{Binding CancelPairingWindowCommand}" Padding="10,4" FontSize="12"
                            ToolTip.Tip="Cancel device pairing window" />
                </Grid>
            </Border>
        </StackPanel>

        <!-- Left Side: Devices navigation list -->
        <ScrollViewer Grid.Row="1" Grid.Column="0" Margin="0,0,16,0">
            <StackPanel Spacing="4">
                <!-- This device button -->
                <Button Classes="nav-button" Classes.active="{Binding IsThisDeviceSelected}"
                        Command="{Binding SelectCommand}" CommandParameter="this"
                        ToolTip.Tip="This computer">
                    <Grid ColumnDefinitions="Auto,*">
                        <TextBlock Text="💻" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBlock Grid.Column="1" Text="{Binding ThisDeviceName}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                    </Grid>
                </Button>

                <!-- Computers section header -->
                <Grid ColumnDefinitions="*,Auto,Auto" Margin="12,12,0,4">
                    <TextBlock Classes="label" Text="COMPUTERS" VerticalAlignment="Center" />
                    <Button Classes="primary-btn" Content="Add computer"
                            Command="{Binding AllowNewDevicesCommand}"
                            ToolTip.Tip="Allow a new computer to connect (2 min window)"
                            Padding="8,2" FontSize="11" Margin="0,0,4,0" />
                    <Button Grid.Column="2" Classes="secondary-btn" Content="Lock all"
                            Command="{Binding LockAllDevicesCommand}"
                            ToolTip.Tip="Send lock request to all paired computers"
                            Padding="8,2" FontSize="11" Margin="0,0,4,0" />
                </Grid>
                <ItemsControl ItemsSource="{Binding Layout.Peers}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="vm:PeerViewModel">
                            <Button Classes="nav-button"
                                    Command="{Binding $parent[UserControl].((vm:DevicesViewModel)DataContext).SelectCommand}"
                                    CommandParameter="{Binding}"
                                    ToolTip.Tip="{Binding Hostname}">
                                <Grid ColumnDefinitions="Auto,*">
                                    <Ellipse Grid.Column="0" Width="8" Height="8" Fill="{Binding StatusColor}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <TextBlock Grid.Column="1" Text="{Binding Hostname}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Classes="hint" Text="No computers found" Margin="12,4" IsVisible="{Binding !Layout.Peers.Count}" />

                <!-- Phones section header -->
                <TextBlock Classes="label" Text="PHONES" Margin="12,12,0,4" />
                <ItemsControl ItemsSource="{Binding Remote.Clients}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="vm:RemoteClientItem">
                            <Button Classes="nav-button"
                                    Command="{Binding $parent[UserControl].((vm:DevicesViewModel)DataContext).SelectCommand}"
                                    CommandParameter="{Binding}"
                                    ToolTip.Tip="{Binding Address}">
                                <Grid ColumnDefinitions="Auto,*">
                                    <Ellipse Grid.Column="0" Width="8" Height="8" Fill="{Binding StatusColor}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <TextBlock Grid.Column="1" Text="{Binding Address}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Classes="hint" Text="No phones paired" Margin="12,4" IsVisible="{Binding !Remote.Clients.Count}" />

                <!-- Add device manually -->
                <StackPanel Margin="0,12,0,0" Spacing="6">
                    <TextBlock Classes="label" Text="ADD DEVICE MANUALLY" />
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBox Grid.Column="0" Text="{Binding ManualAddress}"
                                 PlaceholderText="IP or hostname" />
                        <Button Grid.Column="1" Classes="secondary-btn" Content="Add" Margin="6,0,0,0"
                                Command="{Binding AddByAddressCommand}" />
                    </Grid>
                    <TextBlock Classes="hint" FontSize="11" Text="{Binding ManualError}"
                               IsVisible="{Binding ManualError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- Right Side: Detail Sheet -->
        <Grid Grid.Row="1" Grid.Column="1">
            <TextBlock Classes="hint" Text="Select a device to view its details."
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       IsVisible="{Binding Selected, Converter={x:Static ObjectConverters.IsNull}}" />

            <ContentControl Content="{Binding Selected}">
                <ContentControl.DataTemplates>
                    <!-- Template 1: This Device -->
                    <DataTemplate DataType="vm:ThisDeviceViewModel">
                        <ScrollViewer>
                            <Border Classes="glass-card" Padding="24"
                                    x:DataType="vm:ThisDeviceViewModel">
                                <StackPanel Spacing="16">
                                    <StackPanel Spacing="4">
                                        <TextBlock Classes="label" Text="THIS DEVICE" />
                                        <TextBlock Classes="page-title" Text="{Binding ThisDeviceName}" />
                                    </StackPanel>

                                    <!-- Accept remote input toggle -->
                                    <Grid ColumnDefinitions="*,Auto" Margin="0,4">
                                        <StackPanel Spacing="2">
                                            <TextBlock Classes="section-title" FontSize="13" Text="Accept phone remote input" />
                                            <TextBlock Classes="hint" Text="Allow paired phones to control mouse and keyboard." />
                                        </StackPanel>
                                        <ToggleSwitch Grid.Column="1"
                                                      IsChecked="{Binding Remote.IsAccepting, Mode=OneWay}"
                                                      Command="{Binding Remote.ToggleAcceptingCommand}"
                                                      OnContent="" OffContent=""
                                                      ToolTip.Tip="Toggle accepting input from paired phones" />
                                    </Grid>

                                    <Separator Background="{DynamicResource BorderSubtle}" />

                                    <!-- Address text and port -->
                                    <StackPanel Spacing="6">
                                        <TextBlock Classes="label" Text="NETWORK ADDRESS" />
                                        <SelectableTextBlock Text="{Binding Remote.AddressText}"
                                                             FontSize="14" FontWeight="SemiBold"
                                                             Foreground="{DynamicResource TextPrimary}" TextWrapping="Wrap" />
                                        <TextBlock Classes="label" Text="{Binding Remote.Port, StringFormat='Port {0}'}" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </ScrollViewer>
                    </DataTemplate>

                    <!-- Template 2: Peer Computer (vm:PeerViewModel) -->
                    <DataTemplate DataType="vm:PeerViewModel">
                        <ScrollViewer>
                            <Border Classes="glass-card" Padding="24">
                                <StackPanel Spacing="16">
                                    <!-- Header -->
                                    <Grid ColumnDefinitions="*,Auto">
                                        <StackPanel Grid.Column="0" Spacing="4">
                                            <TextBlock Classes="page-title" Text="{Binding Hostname}" />
                                            <TextBlock Classes="label">
                                                <Run Text="{Binding OperatingSystem}" /><Run Text=" • " /><Run Text="{Binding Address}" />
                                            </TextBlock>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                            <Ellipse Width="8" Height="8" Fill="{Binding StatusColor}" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding StatusText}" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Grid>

                                    <!-- Error banner if any -->
                                    <Border Classes="banner-error"
                                            IsVisible="{Binding Error, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                        <TextBlock Text="{Binding Error}" Foreground="{DynamicResource BannerErrorText}"
                                                   FontSize="12" TextWrapping="Wrap" />
                                    </Border>

                                    <!-- If not paired -->
                                    <StackPanel Spacing="12" IsVisible="{Binding !IsPaired}">
                                        <TextBlock Classes="hint" Text="Pair securely using mutual code confirmation." />
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Button Classes="primary-btn" Content="{Binding PairButtonText}"
                                                    Command="{Binding $parent[UserControl].((vm:DevicesViewModel)DataContext).PairComputerV2Command}"
                                                    CommandParameter="{Binding}"
                                                    ToolTip.Tip="Connect and verify confirmation code" />
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- Wake button for offline peer with known MAC -->
                                    <StackPanel Spacing="6" Margin="0,8,0,0" IsVisible="{Binding CanWake}">
                                        <Button Classes="primary-btn" Content="Wake" Command="{Binding WakeCommand}"
                                                ToolTip.Tip="Send Wake-on-LAN magic packet to this computer" />
                                        <TextBlock Classes="hint" Text="Works only if Wake-on-LAN is enabled in that computer's BIOS and network adapter settings."
                                                   TextWrapping="Wrap" />
                                    </StackPanel>

                                    <!-- If paired -->
                                    <StackPanel Spacing="14" IsVisible="{Binding IsPaired}">
                                        <!-- Share mouse & keyboard toggle -->
                                        <Grid ColumnDefinitions="*,Auto">
                                            <StackPanel Spacing="2">
                                                <TextBlock Classes="section-title" FontSize="13" Text="Share mouse &amp; keyboard" />
                                                <TextBlock Classes="hint" Text="Move cursor past the display edge to control this computer." />
                                            </StackPanel>
                                            <ToggleSwitch Grid.Column="1"
                                                          IsChecked="{Binding ShareMouseAndKeyboard}"
                                                          OnContent="" OffContent=""
                                                          ToolTip.Tip="Toggle mouse and keyboard sharing" />
                                        </Grid>

                                        <!-- Placement ComboBox (visible when sharing) -->
                                        <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding ShareMouseAndKeyboard}">
                                            <StackPanel Spacing="2">
                                                <TextBlock Classes="section-title" FontSize="13" Text="Position" />
                                                <TextBlock Classes="hint" Text="Which side of this computer's display it sits on." />
                                            </StackPanel>
                                            <ComboBox Grid.Column="1"
                                                      ItemsSource="{x:Static vm:PeerViewModel.PlacementOptions}"
                                                      SelectedItem="{Binding Placement}"
                                                      Width="140"
                                                      ToolTip.Tip="Position of this computer relative to your display" />
                                        </Grid>

                                        <!-- Send clipboard toggle -->
                                        <Grid ColumnDefinitions="*,Auto">
                                            <StackPanel Spacing="2">
                                                <TextBlock Classes="section-title" FontSize="13" Text="Send my clipboard to this device" />
                                                <TextBlock Classes="hint" Text="Automatically sync text copied on this computer." />
                                            </StackPanel>
                                            <ToggleSwitch Grid.Column="1"
                                                          IsChecked="{Binding SendClipboard}"
                                                          OnContent="" OffContent=""
                                                          ToolTip.Tip="Toggle sending clipboard to this device" />
                                        </Grid>

                                        <!-- Accept clipboard toggle -->
                                        <Grid ColumnDefinitions="*,Auto">
                                            <StackPanel Spacing="2">
                                                <TextBlock Classes="section-title" FontSize="13" Text="Accept clipboard from this device" />
                                                <TextBlock Classes="hint" Text="Automatically receive text copied on this device." />
                                            </StackPanel>
                                            <ToggleSwitch Grid.Column="1"
                                                          IsChecked="{Binding ReceiveClipboard}"
                                                          OnContent="" OffContent=""
                                                          ToolTip.Tip="Toggle receiving clipboard from this device" />
                                        </Grid>

                                        <!-- Automatically accept files toggle -->
                                        <Grid ColumnDefinitions="*,Auto">
                                            <StackPanel Spacing="2">
                                                <TextBlock Classes="section-title" FontSize="13" Text="Automatically accept files" />
                                                <TextBlock Classes="hint" Text="Accept incoming files from this device without asking every time." />
                                            </StackPanel>
                                            <ToggleSwitch Grid.Column="1"
                                                          IsChecked="{Binding AutoAcceptFiles}"
                                                          OnContent="" OffContent=""
                                                          ToolTip.Tip="Toggle automatically accepting incoming files from this device" />
                                        </Grid>

                                        <!-- Actions -->
                                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
                                            <Button Classes="secondary-btn" Content="Send file…"
                                                    Command="{Binding SendFileCommand}"
                                                    ToolTip.Tip="Send a file to this computer" />
                                            <Button Classes="secondary-btn" Content="Forget"
                                                    Command="{Binding ForgetCommand}"
                                                    ToolTip.Tip="Forget this computer" />
                                        </StackPanel>

                                        <!-- Advanced Expander -->
                                        <Expander Header="Advanced" IsExpanded="False" Margin="0,8,0,0">
                                            <StackPanel Spacing="12" Margin="0,8,0,0">
                                                <!-- Mouse speed -->
                                                <StackPanel Spacing="4">
                                                    <Grid ColumnDefinitions="*,Auto">
                                                        <TextBlock Classes="section-title" FontSize="13" Text="Mouse speed" />
                                                        <TextBlock Grid.Column="1" Text="{Binding MouseSpeed, StringFormat='{}{0:0.00}x'}"
                                                                   Foreground="{DynamicResource TextPrimary}" FontWeight="SemiBold" FontSize="13" />
                                                    </Grid>
                                                    <Slider Minimum="0.25" Maximum="4.0" TickFrequency="0.25" IsSnapToTickEnabled="True"
                                                            Value="{Binding MouseSpeed}"
                                                            ToolTip.Tip="Mouse pointer speed on this computer" />
                                                </StackPanel>

                                                <!-- Scroll speed -->
                                                <StackPanel Spacing="4">
                                                    <Grid ColumnDefinitions="*,Auto">
                                                        <TextBlock Classes="section-title" FontSize="13" Text="Scroll speed" />
                                                        <TextBlock Grid.Column="1" Text="{Binding ScrollSpeed, StringFormat='{}{0:0.00}x'}"
                                                                   Foreground="{DynamicResource TextPrimary}" FontWeight="SemiBold" FontSize="13" />
                                                    </Grid>
                                                    <Slider Minimum="0.25" Maximum="4.0" TickFrequency="0.25" IsSnapToTickEnabled="True"
                                                            Value="{Binding ScrollSpeed}"
                                                            ToolTip.Tip="Scroll wheel speed on this computer" />
                                                </StackPanel>

                                                <!-- Reverse scroll direction -->
                                                <Grid ColumnDefinitions="*,Auto" Margin="0,4">
                                                    <StackPanel Spacing="2">
                                                        <TextBlock Classes="section-title" FontSize="13" Text="Reverse scroll direction" />
                                                        <TextBlock Classes="hint" Text="Invert the scroll wheel direction for this computer." />
                                                    </StackPanel>
                                                    <ToggleSwitch Grid.Column="1"
                                                                  IsChecked="{Binding InvertScroll}"
                                                                  OnContent="" OffContent=""
                                                                  ToolTip.Tip="Reverse scroll direction on this computer" />
                                                </Grid>

                                                <Separator Background="{DynamicResource BorderSubtle}" />

                                                <!-- Lock sync -->
                                                <Grid ColumnDefinitions="*,Auto" Margin="0,4">
                                                    <StackPanel Spacing="2">
                                                        <TextBlock Classes="section-title" FontSize="13" Text="Lock when this computer locks" />
                                                        <TextBlock Classes="hint" Text="Locks this computer automatically when the other computer is locked." />
                                                    </StackPanel>
                                                    <ToggleSwitch Grid.Column="1"
                                                                  IsChecked="{Binding SyncLock}"
                                                                  OnContent="" OffContent=""
                                                                  ToolTip.Tip="Lock when this computer locks" />
                                                </Grid>

                                                <!-- Sleep sync -->
                                                <Grid ColumnDefinitions="*,Auto" Margin="0,4">
                                                    <StackPanel Spacing="2">
                                                        <TextBlock Classes="section-title" FontSize="13" Text="Sleep when this computer sleeps" />
                                                        <TextBlock Classes="hint" Text="Puts this computer to sleep when the other computer sleeps." />
                                                    </StackPanel>
                                                    <ToggleSwitch Grid.Column="1"
                                                                  IsChecked="{Binding SyncSleep}"
                                                                  OnContent="" OffContent=""
                                                                  ToolTip.Tip="Sleep when this computer sleeps" />
                                                </Grid>

                                                <!-- Display off sync -->
                                                <Grid ColumnDefinitions="*,Auto" Margin="0,4">
                                                    <StackPanel Spacing="2">
                                                        <TextBlock Classes="section-title" FontSize="13" Text="Turn off display when this computer turns off display" />
                                                        <TextBlock Classes="hint" Text="Turns off this computer's display when the other computer turns off its display." />
                                                    </StackPanel>
                                                    <ToggleSwitch Grid.Column="1"
                                                                  IsChecked="{Binding SyncDisplayOff}"
                                                                  OnContent="" OffContent=""
                                                                  ToolTip.Tip="Turn off display when this computer turns off display" />
                                                </Grid>

                                                <Separator Background="{DynamicResource BorderSubtle}" />

                                                <StackPanel Spacing="2">
                                                    <TextBlock Classes="label" Text="SCREEN RESOLUTION" />
                                                    <TextBlock Text="{Binding ScreenText}" Foreground="{DynamicResource TextPrimary}" />
                                                </StackPanel>
                                                <StackPanel Spacing="2">
                                                    <TextBlock Classes="label" Text="NETWORK ADDRESS" />
                                                    <TextBlock Text="{Binding Address}" Foreground="{DynamicResource TextPrimary}" />
                                                </StackPanel>
                                                <StackPanel Spacing="2">
                                                    <TextBlock Classes="label" Text="DEVICE ID" />
                                                    <SelectableTextBlock Text="{Binding Id}" Foreground="{DynamicResource TextMuted}" FontSize="11" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Expander>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </ScrollViewer>
                    </DataTemplate>

                    <!-- Template 3: Phone (vm:RemoteClientItem) -->
                    <DataTemplate DataType="vm:RemoteClientItem">
                        <ScrollViewer>
                            <Border Classes="glass-card" Padding="24">
                                <StackPanel Spacing="16">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <StackPanel Grid.Column="0" Spacing="4">
                                            <TextBlock Classes="label" Text="PHONE" />
                                            <TextBlock Classes="page-title" Text="{Binding Address}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                            <Ellipse Width="8" Height="8" Fill="{Binding StatusColor}" VerticalAlignment="Center" />
                                            <TextBlock Text="Connected" IsVisible="{Binding IsActive}"
                                                       Foreground="{DynamicResource Success}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                            <TextBlock Text="Idle" IsVisible="{Binding !IsActive}"
                                                       Foreground="{DynamicResource TextMuted}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Grid>

                                    <!-- Activity info -->
                                    <Border Background="{DynamicResource BgRaised}" BorderBrush="{DynamicResource BorderSubtle}"
                                            BorderThickness="1" CornerRadius="8" Padding="14,12">
                                        <Grid ColumnDefinitions="*,*">
                                            <StackPanel Grid.Column="0" Spacing="2">
                                                <TextBlock Classes="label" Text="LAST SEEN" />
                                                <TextBlock Text="{Binding LastSeenText}" Foreground="{DynamicResource TextPrimary}" FontWeight="SemiBold" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Spacing="2">
                                                <TextBlock Classes="label" Text="LAST EVENT" />
                                                <TextBlock Text="{Binding LastEvent}" Foreground="{DynamicResource TextPrimary}" FontWeight="SemiBold" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <!-- Unpair button -->
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Button Classes="secondary-btn" Content="Unpair"
                                                Command="{Binding $parent[UserControl].((vm:DevicesViewModel)DataContext).Remote.ForgetCommand}"
                                                CommandParameter="{Binding}"
                                                ToolTip.Tip="Unpair this phone" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </ScrollViewer>
                    </DataTemplate>
                </ContentControl.DataTemplates>
            </ContentControl>
        </Grid>

        <!-- Screen layout expander at bottom of page -->
        <Expander Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                  Header="Screen layout" IsExpanded="False" Margin="0,12,0,0">
            <views:MonitorLayoutView DataContext="{Binding Layout}" />
        </Expander>

        <!-- Modal pairing card overlay (SAS verification) -->
        <Grid Grid.Row="0" Grid.Column="0" Grid.RowSpan="3" Grid.ColumnSpan="2"
              IsVisible="{Binding IsPairingPromptVisible}">
            <Border Background="{DynamicResource BgApp}" Opacity="0.8" />
            <Border Classes="glass-card" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Padding="28" Width="400" CornerRadius="12"
                    BorderBrush="{DynamicResource BorderStrong}" BorderThickness="1"
                    Background="{DynamicResource BgSurface}">
                <StackPanel Spacing="16">
                    <TextBlock Text="{Binding PairingPromptTitle}" FontWeight="SemiBold" FontSize="18"
                               Foreground="{DynamicResource TextPrimary}" TextAlignment="Center" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding PairingPromptSubtitle}" Classes="hint"
                               Foreground="{DynamicResource TextSecondary}" TextAlignment="Center" TextWrapping="Wrap" />
                    <Border Background="{DynamicResource BgSunken}" CornerRadius="8" Padding="20,12"
                            BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1"
                            HorizontalAlignment="Center">
                        <TextBlock Text="{Binding PairingPromptCode}" FontFamily="{DynamicResource CodeFontFamily}"
                                   FontSize="32" FontWeight="Bold" Foreground="{DynamicResource Accent}"
                                   LetterSpacing="4" TextAlignment="Center" />
                    </Border>
                    <Grid ColumnDefinitions="*,12,*" Margin="0,8,0,0">
                        <Button Grid.Column="0" Classes="primary-btn" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                Content="{Binding ConfirmButtonText}" Command="{Binding ConfirmPairingCommand}" />
                        <Button Grid.Column="2" Classes="secondary-btn" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                Content="{Binding DenyButtonText}" Command="{Binding DenyPairingCommand}" />
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
