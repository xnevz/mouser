<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Mouser.UI.ViewModels"
             xmlns:views="using:Mouser.UI.Views"
             xmlns:services="using:Mouser.UI.Services"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
             x:Class="Mouser.UI.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">

    <ScrollViewer>
        <StackPanel Margin="24" Spacing="16" MaxWidth="720" HorizontalAlignment="Left">
            <TextBlock Classes="page-title" Text="Settings" />

            <!-- Card 1: Appearance -->
            <Border Classes="glass-card" Padding="20">
                <StackPanel Spacing="14">
                    <TextBlock Classes="section-title" Text="Appearance" />

                    <!-- Design Theme Picker -->
                    <Grid ColumnDefinitions="*,Auto" Margin="0,4">
                        <StackPanel Spacing="2">
                            <TextBlock Classes="section-title" FontSize="13" Text="Design theme" />
                            <TextBlock Classes="hint" Text="{Binding SelectedDesignTheme.Description, FallbackValue='Choose from 7 distinct design aesthetics.'}" />
                        </StackPanel>
                        <ComboBox Grid.Column="1"
                                  ItemsSource="{Binding DesignThemes}"
                                  SelectedItem="{Binding SelectedDesignTheme}"
                                  Width="220">
                            <ComboBox.ItemTemplate>
                                <DataTemplate DataType="services:ThemeService+DesignThemeInfo">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Border Width="12" Height="12" CornerRadius="6" Background="{Binding AccentColor}" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </Grid>

                    <Separator Background="{DynamicResource BorderSubtle}" />

                    <!-- Light / Dark Mode -->
                    <Grid ColumnDefinitions="*,Auto" Margin="0,4">
                        <StackPanel Spacing="2">
                            <TextBlock Classes="section-title" FontSize="13" Text="Theme mode" />
                            <TextBlock Classes="hint" Text="Light, Dark, or automatically match your operating system." />
                        </StackPanel>
                        <ComboBox Grid.Column="1" ItemsSource="{Binding ThemeOptions}" SelectedItem="{Binding Theme}" Width="160" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Card 2: General -->
            <Border Classes="glass-card" Padding="20">
                <StackPanel Spacing="12">
                    <TextBlock Classes="section-title" Text="General" />
                    <Grid ColumnDefinitions="*,Auto" Margin="0,4" IsVisible="{Binding IsStartAtLoginSupported}">
                        <StackPanel Spacing="2">
                            <TextBlock Classes="section-title" FontSize="13" Text="Start Mouser when I sign in" />
                            <TextBlock Classes="hint" Text="Automatically start Mouser in the background upon login." />
                        </StackPanel>
                        <ToggleSwitch Grid.Column="1" IsChecked="{Binding StartAtLogin}" OnContent="" OffContent="" />
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto" Margin="0,4">
                        <StackPanel Spacing="2">
                            <TextBlock Classes="section-title" FontSize="13" Text="Keep running in the tray when I close the window" />
                            <TextBlock Classes="hint" Text="Closing the window leaves Mouser active in the notification area." />
                        </StackPanel>
                        <ToggleSwitch Grid.Column="1" IsChecked="{Binding CloseToTray}" OnContent="" OffContent="" />
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto" Margin="0,4">
                        <StackPanel Spacing="2">
                            <TextBlock Classes="section-title" FontSize="13" Text="Hide to the tray when I minimize the window" />
                            <TextBlock Classes="hint" Text="Minimizing hides the taskbar button and keeps the tray icon." />
                        </StackPanel>
                        <ToggleSwitch Grid.Column="1" IsChecked="{Binding MinimizeToTray}" OnContent="" OffContent="" />
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto" Margin="0,4">
                        <StackPanel Spacing="2">
                            <TextBlock Classes="section-title" FontSize="13" Text="Show notifications" />
                            <TextBlock Classes="hint" Text="Show toasts when clips, files or connections update." />
                        </StackPanel>
                        <ToggleSwitch Grid.Column="1" IsChecked="{Binding Notifications}" OnContent="" OffContent="" />
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto" Margin="0,4">
                        <StackPanel Spacing="2">
                            <TextBlock Classes="section-title" FontSize="13" Text="Warn me when a window can't receive input" />
                            <TextBlock Classes="hint" Text="Windows blocks Mouser from typing into administrator windows unless Mouser runs as administrator too." />
                        </StackPanel>
                        <ToggleSwitch Grid.Column="1" IsChecked="{Binding WarnElevatedWindows}" OnContent="" OffContent="" />
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto" Margin="0,4">
                        <StackPanel Spacing="2">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Classes="section-title" FontSize="13" Text="Run as administrator" VerticalAlignment="Center" />
                                <Border Classes="status-pill" IsVisible="{Binding IsElevated}" VerticalAlignment="Center">
                                    <TextBlock Text="Currently running as administrator" FontSize="11" Foreground="{DynamicResource Success}" />
                                </Border>
                            </StackPanel>
                            <TextBlock Classes="hint" Text="Allows typing and clicking into administrator windows, Task Manager and installers." />
                            <TextBlock Classes="hint" Text="If Windows asks for a different administrator's password, Mouser uses that account's settings." />
                        </StackPanel>
                        <ToggleSwitch Grid.Column="1" IsChecked="{Binding RunAsAdministrator}" OnContent="" OffContent="" />
                    </Grid>
                    <Border Background="{DynamicResource BgHover}" CornerRadius="8" Padding="12" Margin="0,4"
                            IsVisible="{Binding ShowRestartElevatedPrompt}">
                        <Grid ColumnDefinitions="*,Auto,Auto" VerticalAlignment="Center">
                            <TextBlock Text="{Binding RestartElevatedMessage}" FontSize="12" Foreground="{DynamicResource TextPrimary}"
                                       VerticalAlignment="Center" TextWrapping="Wrap" />
                            <Button Grid.Column="1" Classes="primary-btn" Content="Restart now"
                                    Command="{Binding RestartElevatedCommand}" Margin="12,0,4,0" />
                            <Button Grid.Column="2" Classes="secondary-btn" Content="Later"
                                    Command="{Binding DismissRestartPromptCommand}" Margin="4,0,0,0" />
                        </Grid>
                    </Border>
                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,2">
                        <Button Classes="secondary-btn" Content="Restart as administrator"
                                Command="{Binding RequestRestartElevatedCommand}"
                                IsVisible="{Binding CanRestartElevated}" />
                        <Button Classes="secondary-btn" Content="Restart normally"
                                Command="{Binding RestartNormalCommand}"
                                IsVisible="{Binding CanRestartNormal}" />
                    </StackPanel>
                    <Grid ColumnDefinitions="*,Auto" Margin="0,4">
                        <StackPanel Spacing="2">
                            <TextBlock Classes="section-title" FontSize="13" Text="Check for updates automatically" />
                            <TextBlock Classes="hint" Text="Queries GitHub Releases on startup and every 24 hours. No personal data is sent." />
                        </StackPanel>
                        <ToggleSwitch Grid.Column="1" IsChecked="{Binding CheckForUpdates}" OnContent="" OffContent="" />
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto" Margin="0,4">
                        <StackPanel Spacing="2" VerticalAlignment="Center">
                            <TextBlock Classes="hint" Text="{Binding UpdateStatusText}" />
                        </StackPanel>
                        <Button Grid.Column="1" Classes="secondary-btn" Content="Check now"
                                Command="{Binding CheckForUpdatesNowCommand}"
                                IsEnabled="{Binding !IsCheckingForUpdates}" />
                    </Grid>
                    <Border Background="{DynamicResource BannerInfoBg}" BorderBrush="{DynamicResource BannerInfoBorder}"
                            BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,4"
                            IsVisible="{Binding IsUpdateAvailable}">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="2">
                                <TextBlock Classes="section-title" FontSize="13" Text="{Binding UpdateStatusText}" Foreground="{DynamicResource BannerInfoText}" />
                                <TextBlock Classes="hint" Text="{Binding ReleaseNotesText}" MaxLines="2" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <Button Grid.Column="1" Classes="primary-btn" Content="Download"
                                    Command="{Binding OpenReleasePageCommand}" VerticalAlignment="Center" Margin="8,0,0,0" />
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Card 3: Clipboard -->
            <Border Classes="glass-card" Padding="20">
                <StackPanel Spacing="12">
                    <TextBlock Classes="section-title" Text="Clipboard" />
                    <Grid ColumnDefinitions="*,Auto" Margin="0,4">
                        <StackPanel Spacing="2">
                            <TextBlock Classes="section-title" FontSize="13" Text="Save text I copy" />
                            <TextBlock Classes="hint" Text="Store copied text locally for search and quick-paste." />
                        </StackPanel>
                        <ToggleSwitch Grid.Column="1" IsChecked="{Binding ClipboardHistoryEnabled}" OnContent="" OffContent="" />
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto" Margin="0,4">
                        <StackPanel Spacing="2">
                            <TextBlock Classes="section-title" FontSize="13" Text="Save images" />
                            <TextBlock Classes="hint" Text="Store copied screenshots and images in your local history." />
                        </StackPanel>
                        <ToggleSwitch Grid.Column="1" IsChecked="{Binding SaveImages}" OnContent="" OffContent="" />
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto" Margin="0,4">
                        <StackPanel Spacing="2">
                            <TextBlock Classes="section-title" FontSize="13" Text="Share with other computers" />
                            <TextBlock Classes="hint" Text="Send and receive copied clips with paired computers." />
                        </StackPanel>
                        <ToggleSwitch Grid.Column="1" IsChecked="{Binding ClipboardSyncEnabled}" OnContent="" OffContent="" />
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto" Margin="0,4">
                        <StackPanel Spacing="2">
                            <TextBlock Classes="section-title" FontSize="13" Text="Skip passwords and secrets" />
                            <TextBlock Classes="hint" Text="Ignore API keys, credit cards, and private keys." />
                        </StackPanel>
                        <ToggleSwitch Grid.Column="1" IsChecked="{Binding SkipSensitiveClips}" OnContent="" OffContent="" />
                    </Grid>
                    <Expander Header="Advanced" IsExpanded="False">
                        <StackPanel Spacing="12" Margin="0,8,0,0">
                            <Grid ColumnDefinitions="*,Auto" Margin="0,4">
                                <StackPanel Spacing="2">
                                    <TextBlock Classes="section-title" FontSize="13" Text="Delete unstarred clips after" />
                                    <TextBlock Classes="hint" Text="Automatically remove unstarred history older than this." />
                                </StackPanel>
                                <ComboBox Grid.Column="1" ItemsSource="{x:Static vm:SettingsViewModel.RetentionOptions}"
                                          SelectedItem="{Binding SelectedRetention}" Width="160">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate x:DataType="vm:RetentionPreset">
                                            <TextBlock Text="{Binding Label}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </Grid>
                            <Grid ColumnDefinitions="*,Auto" Margin="0,4">
                                <StackPanel Spacing="2">
                                    <TextBlock Classes="section-title" FontSize="13" Text="Clear history when Mouser quits" />
                                    <TextBlock Classes="hint" Text="Automatically wipe unstarred clips upon exiting Mouser." />
                                </StackPanel>
                                <ToggleSwitch Grid.Column="1" IsChecked="{Binding ClearOnExit}" OnContent="" OffContent="" />
                            </Grid>
                            <Grid ColumnDefinitions="*,Auto" Margin="0,4">
                                <StackPanel Spacing="2">
                                    <TextBlock Classes="section-title" FontSize="13" Text="Panic wipe hotkey" />
                                    <TextBlock Classes="hint" Text="Hotkey to delete all history and media instantly (e.g. Ctrl+Alt+Shift+X)." />
                                </StackPanel>
                                <TextBox Grid.Column="1" Text="{Binding PanicWipeHotkey}" Width="160" PlaceholderText="None" />
                            </Grid>
                            <StackPanel Spacing="6" Margin="0,4,0,0">
                                <TextBlock Text="Don't save copies from these apps (one per line)" Classes="label" />
                                <TextBox Text="{Binding IgnoredAppsText}" AcceptsReturn="True" Height="100" TextWrapping="Wrap" />
                                <TextBlock Text="Copies made in these apps will not be captured or synced." Classes="hint" />
                            </StackPanel>
                            <StackPanel Spacing="8" Margin="0,8,0,0">
                                <TextBlock Classes="section-title" FontSize="13" Text="Maintenance" />
                                <TextBlock Classes="hint" Text="{Binding HistorySizeText}" />
                                <WrapPanel Orientation="Horizontal">
                                    <Button Classes="secondary-btn" Content="Clear all history" Command="{Binding ClearAllHistoryCommand}"
                                            Margin="0,0,8,8" ToolTip.Tip="Delete all clips including starred" />
                                    <Button Classes="secondary-btn" Content="Optimize" Command="{Binding OptimizeCommand}"
                                            Margin="0,0,8,8" ToolTip.Tip="Defragment database and optimize index" />
                                    <Button Classes="secondary-btn" Content="Rebuild search" Command="{Binding RebuildSearchCommand}"
                                            Margin="0,0,8,8" ToolTip.Tip="Re-index all clips for search" />
                                    <Button Classes="secondary-btn" Content="Delete everything" Command="{Binding PanicWipeCommand}"
                                            Margin="0,0,8,8" ToolTip.Tip="Instantly wipe all clips and media files" />
                                </WrapPanel>
                            </StackPanel>
                        </StackPanel>
                    </Expander>
                </StackPanel>
            </Border>

            <!-- Card 4: Sharing -->
            <Border Classes="glass-card" Padding="20">
                <StackPanel Spacing="12">
                    <TextBlock Classes="section-title" Text="Sharing" />
                    <Grid ColumnDefinitions="*,Auto" Margin="0,4">
                        <StackPanel Spacing="2">
                            <TextBlock Classes="section-title" FontSize="13" Text="Accept remote input from phones" />
                            <TextBlock Classes="hint" Text="Allow paired phones to control the mouse and keyboard." />
                        </StackPanel>
                        <ToggleSwitch Grid.Column="1" IsChecked="{Binding AcceptRemoteInput}" OnContent="" OffContent="" />
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto" Margin="0,4">
                        <StackPanel Spacing="2">
                            <TextBlock Classes="section-title" FontSize="13" Text="Switching feel" />
                            <TextBlock Classes="hint" Text="How hard you must push the cursor against the edge before it moves to the other computer." />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                            <RadioButton Content="Relaxed" GroupName="SwitchFeel" IsChecked="{Binding IsSwitchFeelRelaxed}" />
                            <RadioButton Content="Normal" GroupName="SwitchFeel" IsChecked="{Binding IsSwitchFeelNormal}" />
                            <RadioButton Content="Careful" GroupName="SwitchFeel" IsChecked="{Binding IsSwitchFeelCareful}" />
                        </StackPanel>
                    </Grid>
                    <Expander Header="Advanced" IsExpanded="False">
                        <StackPanel Spacing="12" Margin="0,8,0,0">
                            <CheckBox IsChecked="{Binding LocalNetworkOnly}">
                                <StackPanel Spacing="2">
                                    <TextBlock Classes="section-title" FontSize="13" Text="Only accept connections from my local network" />
                                    <TextBlock Classes="hint" Text="Drop packets whose source address is not from a private or local network subnet." />
                                </StackPanel>
                            </CheckBox>
                            <Grid ColumnDefinitions="*,Auto" Margin="0,4">
                                <StackPanel Spacing="2">
                                    <TextBlock Classes="section-title" FontSize="13" Text="Preferred network adapter" />
                                    <TextBlock Classes="hint" Text="Listen and discover on a specific network adapter." />
                                </StackPanel>
                                <ComboBox Grid.Column="1" ItemsSource="{Binding AdapterOptions}" SelectedItem="{Binding SelectedAdapter}"
                                          DisplayMemberBinding="{Binding DisplayName}" Width="240" />
                            </Grid>
                            <Grid ColumnDefinitions="*,Auto" Margin="0,4">
                                <StackPanel Spacing="2">
                                    <TextBlock Classes="section-title" FontSize="13" Text="Input port (UDP)" />
                                    <TextBlock Classes="hint" Text="UDP port for mouse and keyboard input. Default is 58491." />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <NumericUpDown Value="{Binding InputPort}" Minimum="1024" Maximum="65535" Increment="1"
                                                   FormatString="0" Width="120" />
                                    <Button Classes="secondary-btn" Content="Find free" Command="{Binding FindFreeInputPortCommand}"
                                            ToolTip.Tip="Find a free UDP port" />
                                </StackPanel>
                            </Grid>
                            <Grid ColumnDefinitions="*,Auto" Margin="0,4">
                                <StackPanel Spacing="2">
                                    <TextBlock Classes="section-title" FontSize="13" Text="Transfer port (TCP)" />
                                    <TextBlock Classes="hint" Text="TCP port for clipboard sync and files. Default is 58491." />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <NumericUpDown Value="{Binding TcpPort}" Minimum="1024" Maximum="65535" Increment="1"
                                                   FormatString="0" Width="120" />
                                    <Button Classes="secondary-btn" Content="Find free" Command="{Binding FindFreeTcpPortCommand}"
                                            ToolTip.Tip="Find a free TCP port" />
                                    <Button Classes="primary-btn" Content="Apply" Command="{Binding ApplyPortsCommand}"
                                            ToolTip.Tip="Apply network port settings" />
                                </StackPanel>
                            </Grid>
                            <CheckBox IsChecked="{Binding UseIPv6}">
                                <StackPanel Spacing="2">
                                    <TextBlock Classes="section-title" FontSize="13" Text="Use IPv6" />
                                    <TextBlock Classes="hint" Text="Allow IPv6 addresses for local discovery and transfers." />
                                </StackPanel>
                            </CheckBox>
                            <CheckBox IsChecked="{Binding BlockInFullscreen}">
                                <StackPanel Spacing="2">
                                    <TextBlock Classes="section-title" FontSize="13" Text="Don't switch while a full-screen app or game is in front" />
                                    <TextBlock Classes="hint" Text="Keeps the pointer locked inside games and full-screen video players." />
                                </StackPanel>
                            </CheckBox>
                            <CheckBox IsChecked="{Binding BlockInMaximized}">
                                <StackPanel Spacing="2">
                                    <TextBlock Classes="section-title" FontSize="13" Text="Don't switch while a maximized window is in front" />
                                    <TextBlock Classes="hint" Text="Prevents accidentally leaving when a window fills the screen." />
                                </StackPanel>
                            </CheckBox>
                            <CheckBox IsChecked="{Binding BlockInCorners}">
                                <StackPanel Spacing="2">
                                    <TextBlock Classes="section-title" FontSize="13" Text="Block switching near corners" />
                                    <TextBlock Classes="hint" Text="Ignore screen boundaries within 80 pixels of screen corners." />
                                </StackPanel>
                            </CheckBox>
                            <Grid ColumnDefinitions="*,Auto" Margin="0,4">
                                <StackPanel Spacing="2">
                                    <TextBlock Classes="section-title" FontSize="13" Text="Require modifier key to switch" />
                                    <TextBlock Classes="hint" Text="Only cross to another computer while holding this key." />
                                </StackPanel>
                                <ComboBox Grid.Column="1" ItemsSource="{Binding ModifierOptions}" SelectedItem="{Binding RequireModifier}" Width="140" />
                            </Grid>
                            <CheckBox IsChecked="{Binding DoubleTapOverride}">
                                <StackPanel Spacing="2">
                                    <TextBlock Classes="section-title" FontSize="13" Text="Double-tap edge to switch anyway" />
                                    <TextBlock Classes="hint" Text="Bump the edge twice quickly within 400 ms to bypass switching blocks." />
                                </StackPanel>
                            </CheckBox>
                            <CheckBox IsChecked="{Binding WrapAround}">
                                <StackPanel Spacing="2">
                                    <TextBlock Classes="section-title" FontSize="13" Text="Wrap the pointer around at the screen edges" />
                                    <TextBlock Classes="hint" Text="Moving the cursor off an empty screen edge wraps it to the opposite side." />
                                </StackPanel>
                            </CheckBox>
                            <CheckBox IsChecked="{Binding ProportionalEntry}">
                                <StackPanel Spacing="2">
                                    <TextBlock Classes="section-title" FontSize="13" Text="Scale the cursor position between different-size screens" />
                                    <TextBlock Classes="hint" Text="When off, enters at the exact pixel position instead of the proportional height or width." />
                                </StackPanel>
                            </CheckBox>
                            <Grid ColumnDefinitions="*,Auto" Margin="0,4">
                                <StackPanel Spacing="2">
                                    <TextBlock Classes="section-title" FontSize="13" Text="Dim this computer's screens while controlling another" />
                                    <TextBlock Classes="hint" Text="Shows a dark overlay and banner on local displays when mouse is on a remote screen." />
                                </StackPanel>
                                <ToggleSwitch Grid.Column="1" IsChecked="{Binding DimScreensOnControl}" OnContent="" OffContent="" />
                            </Grid>
                            <StackPanel Spacing="4" Margin="0,4" IsEnabled="{Binding DimScreensOnControl}">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Classes="section-title" FontSize="13" Text="Dim overlay darkness" />
                                    <TextBlock Grid.Column="1" Text="{Binding DimScreensOpacityPercentText}"
                                               Foreground="{DynamicResource TextPrimary}" FontWeight="SemiBold" FontSize="13" />
                                </Grid>
                                <Slider Minimum="0.0" Maximum="0.7" TickFrequency="0.05" IsSnapToTickEnabled="False"
                                        Value="{Binding DimScreensOpacity}"
                                        ToolTip.Tip="Darkness of the dim overlay on inactive displays" />
                            </StackPanel>
                            <Grid ColumnDefinitions="*,Auto" Margin="0,4">
                                <StackPanel Spacing="2">
                                    <TextBlock Classes="section-title" FontSize="13" Text="Max incoming file size (MB)" />
                                    <TextBlock Classes="hint" Text="Reject incoming files larger than this size limit. Default is 2048 MB (2 GB)." />
                                </StackPanel>
                                <NumericUpDown Grid.Column="1" Value="{Binding MaxIncomingFileMB}" Minimum="1" Maximum="4096" Increment="128"
                                               FormatString="0" Width="140" />
                            </Grid>
                            <StackPanel Spacing="6" Margin="0,4,0,0">
                                <TextBlock Text="Blocked file extensions" Classes="label" />
                                <TextBox Text="{Binding BlockedExtensionsText}" AcceptsReturn="False" Width="300" HorizontalAlignment="Left" />
                                <TextBlock Text="Space-separated list of blocked extensions (e.g. .exe .msi .bat .cmd .ps1)." Classes="hint" />
                            </StackPanel>
                        </StackPanel>
                    </Expander>
                </StackPanel>
            </Border>

            <!-- Card 5: Hotkeys -->
            <views:HotkeysView DataContext="{Binding Hotkeys}" />

            <!-- Card 6: Security -->
            <Border Classes="glass-card" Padding="20">
                <StackPanel Spacing="12">
                    <TextBlock Classes="section-title" Text="Security" />

                    <!-- When NOT configured -->
                    <StackPanel Spacing="12" IsVisible="{Binding !IsLockConfigured}">
                        <!-- When not in setup mode -->
                        <Grid ColumnDefinitions="*,Auto" Margin="0,4" IsVisible="{Binding !IsSettingPassphrase}">
                            <StackPanel Spacing="2">
                                <TextBlock Classes="section-title" FontSize="13" Text="App lock" />
                                <TextBlock Classes="hint" Text="Protect your history and connections with a passphrase." />
                            </StackPanel>
                            <Button Grid.Column="1" Classes="secondary-btn" Content="Set a passphrase"
                                    Command="{Binding StartSetupPassphraseCommand}" />
                        </Grid>

                        <!-- Passphrase setup form -->
                        <Border Classes="glass-card" Background="{DynamicResource BgSunken}" Padding="16"
                                IsVisible="{Binding IsSettingPassphrase}">
                            <StackPanel Spacing="12">
                                <!-- Step 1: Input passphrases -->
                                <StackPanel Spacing="10" IsVisible="{Binding !ShowRecoveryKeyPrompt}">
                                    <TextBlock Classes="section-title" FontSize="13" Text="Set a passphrase" />
                                    <TextBlock Classes="hint" Text="Passphrase must be at least 8 characters." />

                                    <Grid ColumnDefinitions="140,*" Margin="0,4">
                                        <TextBlock Text="New passphrase" VerticalAlignment="Center" Classes="label" />
                                        <TextBox Grid.Column="1" PlaceholderText="Enter passphrase" PasswordChar="•"
                                                 Text="{Binding NewPassphrase, Mode=TwoWay}" />
                                    </Grid>

                                    <Grid ColumnDefinitions="140,*" Margin="0,4">
                                        <TextBlock Text="Confirm passphrase" VerticalAlignment="Center" Classes="label" />
                                        <TextBox Grid.Column="1" PlaceholderText="Re-enter passphrase" PasswordChar="•"
                                                 Text="{Binding ConfirmPassphrase, Mode=TwoWay}" />
                                    </Grid>

                                    <TextBlock Text="{Binding SetupError}" Foreground="{DynamicResource Danger}"
                                               FontSize="12" IsVisible="{Binding !!SetupError}" />

                                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" Margin="0,6,0,0">
                                        <Button Classes="secondary-btn" Content="Cancel" Command="{Binding CancelSetupPassphraseCommand}" />
                                        <Button Classes="primary-btn" Content="Save passphrase" Command="{Binding ConfirmSetupPassphraseCommand}" />
                                    </StackPanel>
                                </StackPanel>

                                <!-- Step 2: Show recovery key -->
                                <StackPanel Spacing="10" IsVisible="{Binding ShowRecoveryKeyPrompt}">
                                    <TextBlock Classes="section-title" FontSize="13" Text="Save your recovery key" />
                                    <TextBlock Classes="hint"
                                               Text="This key is shown only once and is never stored anywhere. Without your passphrase or this key, locked data cannot be recovered." />

                                    <Border Background="{DynamicResource BgInput}" BorderBrush="{DynamicResource BorderStrong}"
                                            BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,4">
                                        <SelectableTextBlock Text="{Binding SavedRecoveryKey}"
                                                             FontFamily="Consolas,Menlo,monospace"
                                                             FontSize="13"
                                                             FontWeight="Bold"
                                                             Foreground="{DynamicResource AccentSoft}"
                                                             HorizontalAlignment="Center" />
                                    </Border>

                                    <Button Classes="primary-btn" Content="I saved it" Command="{Binding AcknowledgeRecoveryKeyCommand}"
                                            HorizontalAlignment="Right" Margin="0,6,0,0" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- When CONFIGURED -->
                    <StackPanel Spacing="12" IsVisible="{Binding IsLockConfigured}">
                        <Grid ColumnDefinitions="*,Auto" Margin="0,4">
                            <StackPanel Spacing="2">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock Classes="section-title" FontSize="13" Text="App lock is on" />
                                    <Border Classes="status-pill" VerticalAlignment="Center" Padding="6,1">
                                        <TextBlock Text="Active" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource Success}" />
                                    </Border>
                                </StackPanel>
                                <TextBlock Classes="hint" Text="Mouser is protected with your passphrase." />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                <Button Classes="secondary-btn" Content="Lock now" Command="{Binding LockNowCommand}" />
                                <Button Classes="secondary-btn" Content="Change passphrase" Command="{Binding StartChangePassphraseCommand}" />
                                <Button Classes="secondary-btn" Content="Remove lock" Command="{Binding StartRemoveLockCommand}" />
                            </StackPanel>
                        </Grid>

                        <!-- Change passphrase inline form -->
                        <Border Classes="glass-card" Background="{DynamicResource BgSunken}" Padding="16"
                                IsVisible="{Binding IsChangingPassphrase}">
                            <StackPanel Spacing="10">
                                <TextBlock Classes="section-title" FontSize="13" Text="Change passphrase" />

                                <Grid ColumnDefinitions="140,*" Margin="0,4">
                                    <TextBlock Text="Current passphrase" VerticalAlignment="Center" Classes="label" />
                                    <TextBox Grid.Column="1" PlaceholderText="Current passphrase" PasswordChar="•"
                                             Text="{Binding OldPassphrase, Mode=TwoWay}" />
                                </Grid>

                                <Grid ColumnDefinitions="140,*" Margin="0,4">
                                    <TextBlock Text="New passphrase" VerticalAlignment="Center" Classes="label" />
                                    <TextBox Grid.Column="1" PlaceholderText="New passphrase (min 8 chars)" PasswordChar="•"
                                             Text="{Binding ChangeNewPassphrase, Mode=TwoWay}" />
                                </Grid>

                                <Grid ColumnDefinitions="140,*" Margin="0,4">
                                    <TextBlock Text="Confirm new" VerticalAlignment="Center" Classes="label" />
                                    <TextBox Grid.Column="1" PlaceholderText="Re-enter new passphrase" PasswordChar="•"
                                             Text="{Binding ChangeConfirmPassphrase, Mode=TwoWay}" />
                                </Grid>

                                <TextBlock Text="{Binding ChangeError}" Foreground="{DynamicResource Danger}"
                                           FontSize="12" IsVisible="{Binding !!ChangeError}" />

                                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" Margin="0,6,0,0">
                                    <Button Classes="secondary-btn" Content="Cancel" Command="{Binding CancelChangePassphraseCommand}" />
                                    <Button Classes="primary-btn" Content="Update passphrase" Command="{Binding ChangePassphraseCommand}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Remove lock inline form -->
                        <Border Classes="glass-card" Background="{DynamicResource BgSunken}" Padding="16"
                                IsVisible="{Binding IsRemovingLock}">
                            <StackPanel Spacing="10">
                                <TextBlock Classes="section-title" FontSize="13" Text="Remove lock" />
                                <TextBlock Classes="hint" Text="Enter your current passphrase to turn off app lock." />

                                <Grid ColumnDefinitions="140,*" Margin="0,4">
                                    <TextBlock Text="Passphrase" VerticalAlignment="Center" Classes="label" />
                                    <TextBox Grid.Column="1" PlaceholderText="Current passphrase" PasswordChar="•"
                                             Text="{Binding RemovePassphrase, Mode=TwoWay}" />
                                </Grid>

                                <TextBlock Text="{Binding RemoveError}" Foreground="{DynamicResource Danger}"
                                           FontSize="12" IsVisible="{Binding !!RemoveError}" />

                                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" Margin="0,6,0,0">
                                    <Button Classes="secondary-btn" Content="Cancel" Command="{Binding CancelRemoveLockCommand}" />
                                    <Button Classes="primary-btn" Content="Confirm remove" Command="{Binding RemoveLockCommand}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Advanced Expander for Security -->
                    <Expander Header="Advanced" IsExpanded="False">
                        <StackPanel Spacing="12" Margin="0,8,0,0">
                            <Grid ColumnDefinitions="*,Auto" Margin="0,4">
                                <StackPanel Spacing="2">
                                    <TextBlock Classes="section-title" FontSize="13" Text="Lock when Windows locks" />
                                    <TextBlock Classes="hint" Text="Automatically lock Mouser whenever the Windows workstation locks." />
                                </StackPanel>
                                <ToggleSwitch Grid.Column="1" IsChecked="{Binding LockWithWindows}" OnContent="" OffContent="" />
                            </Grid>
                            <Grid ColumnDefinitions="*,Auto" Margin="0,4">
                                <StackPanel Spacing="2">
                                    <TextBlock Classes="section-title" FontSize="13" Text="Let other devices lock this computer" />
                                    <TextBlock Classes="hint" Text="Automatically lock Mouser on this computer when you trigger Lock All on another device." />
                                </StackPanel>
                                <ToggleSwitch Grid.Column="1" IsChecked="{Binding AllowRemoteLock}" OnContent="" OffContent="" />
                            </Grid>
                            <Grid ColumnDefinitions="*,Auto" Margin="0,4">
                                <StackPanel Spacing="2">
                                    <TextBlock Classes="section-title" FontSize="13" Text="Lock after inactivity" />
                                    <TextBlock Classes="hint" Text="Lock Mouser after this many minutes of inactivity (0 = never)." />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <NumericUpDown Value="{Binding AutoLockMinutes}" Minimum="0" Maximum="1440" Increment="1"
                                                   FormatString="0" Width="120" />
                                    <TextBlock Text="minutes" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondary}" FontSize="12" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Expander>
                </StackPanel>
            </Border>

            <!-- Card 6: This device -->
            <Border Classes="glass-card" Padding="20">
                <StackPanel Spacing="12">
                    <TextBlock Classes="section-title" Text="This device" />
                    <Grid ColumnDefinitions="*,Auto" Margin="0,4">
                        <StackPanel Spacing="2">
                            <TextBlock Classes="section-title" FontSize="13" Text="Device name" />
                            <TextBlock Classes="hint" Text="How this computer appears to other devices on the network." />
                        </StackPanel>
                        <TextBox Grid.Column="1" Text="{Binding DeviceName}" Width="200" />
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto" Margin="0,4">
                        <StackPanel Spacing="2">
                            <TextBlock Classes="section-title" FontSize="13" Text="Data folder" />
                            <TextBlock Classes="hint" Text="Local storage for history and configuration." />
                        </StackPanel>
                        <SelectableTextBlock Grid.Column="1" Text="{Binding DataDirectory}"
                                             Foreground="{DynamicResource TextPrimary}" FontSize="12"
                                             VerticalAlignment="Center" TextWrapping="Wrap" />
                    </Grid>
                </StackPanel>
            </Border>

            <TextBlock Classes="hint" Text="{Binding StatusMessage}" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
