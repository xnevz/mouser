<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Mouser.UI.ViewModels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
             x:Class="Mouser.UI.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">

    <ScrollViewer>
        <StackPanel Margin="24" Spacing="16" MaxWidth="720" HorizontalAlignment="Left">
            <TextBlock Classes="page-title" Text="Settings" />

            <Border Classes="glass-card" Padding="20">
                <StackPanel Spacing="10">
                    <TextBlock Classes="section-title" Text="Phone connection" />
                    <TextBlock Classes="hint"
                               Text="UDP port phones send input to. Change it only if another app already uses it; phones find the new port automatically." />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <NumericUpDown Value="{Binding InputPort}" Minimum="1024" Maximum="65535" Increment="1"
                                       FormatString="0" Width="160" />
                        <Button Classes="secondary-btn" Content="Apply" Command="{Binding ApplyPortCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Classes="glass-card" Padding="20">
                <StackPanel Spacing="10">
                    <TextBlock Classes="section-title" Text="Clipboard history" />
                    <CheckBox Content="Save text I copy to the clipboard history" IsChecked="{Binding ClipboardHistoryEnabled}" />
                    <CheckBox Content="Don't save things that look like passwords, API keys, private keys or card numbers"
                              IsChecked="{Binding SkipSensitiveClips}" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="Delete unstarred clips after" VerticalAlignment="Center" Foreground="#cbd5e1" FontSize="12" />
                        <NumericUpDown Value="{Binding ClipboardRetentionDays}" Minimum="1" Maximum="3650" Increment="1"
                                       FormatString="0" Width="120" />
                        <TextBlock Text="days" VerticalAlignment="Center" Foreground="#cbd5e1" FontSize="12" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Classes="glass-card" Padding="20" IsVisible="{Binding IsStartAtLoginSupported}">
                <StackPanel Spacing="10">
                    <TextBlock Classes="section-title" Text="Startup" />
                    <CheckBox Content="Start Mouser when I sign in" IsChecked="{Binding StartAtLogin}" />
                </StackPanel>
            </Border>

            <Border Classes="glass-card" Padding="20">
                <StackPanel Spacing="6">
                    <TextBlock Classes="section-title" Text="Data" />
                    <TextBlock Classes="hint" Text="Settings and clipboard history are stored only on this computer, in:" />
                    <SelectableTextBlock Text="{Binding DataDirectory}" Foreground="#e2e8f0" FontSize="12" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <TextBlock Classes="hint" Text="{Binding StatusMessage}" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
