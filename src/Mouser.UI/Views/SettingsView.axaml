<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Mouser.UI.ViewModels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
             x:Class="Mouser.UI.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">

    <ScrollViewer>
        <StackPanel Margin="24" Spacing="16" MaxWidth="720" HorizontalAlignment="Left">
            <TextBlock Classes="page-title" Text="Settings" />

            <!-- Card 1: Appearance -->
            <Border Classes="glass-card" Padding="20">
                <StackPanel Spacing="12">
                    <TextBlock Classes="section-title" Text="Appearance" />
                    <Grid ColumnDefinitions="*,Auto" Margin="0,4">
                        <StackPanel Spacing="2">
                            <TextBlock Classes="section-title" FontSize="13" Text="Theme" />
                            <TextBlock Classes="hint" Text="System follows your Windows setting." />
                        </StackPanel>
                        <ComboBox Grid.Column="1" ItemsSource="{Binding ThemeOptions}" SelectedItem="{Binding Theme}" Width="160" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Card 2: General -->
            <Border Classes="glass-card" Padding="20">
                <StackPanel Spacing="12">
                    <TextBlock Classes="section-title" Text="General" />
                    <Grid ColumnDefinitions="*,Auto" Margin="0,4" IsVisible="{Binding IsStartAtLoginSupported}">
                        <StackPanel Spacing="2">
                            <TextBlock Classes="section-title" FontSize="13" Text="Start Mouser when I sign in" />
                            <TextBlock Classes="hint" Text="Automatically start Mouser in the background upon login." />
                        </StackPanel>
                        <ToggleSwitch Grid.Column="1" IsChecked="{Binding StartAtLogin}" OnContent="" OffContent="" />
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto" Margin="0,4">
                        <StackPanel Spacing="2">
                            <TextBlock Classes="section-title" FontSize="13" Text="Keep running in the tray when I close the window" />
                            <TextBlock Classes="hint" Text="Closing the window leaves Mouser active in the notification area." />
                        </StackPanel>
                        <ToggleSwitch Grid.Column="1" IsChecked="{Binding CloseToTray}" OnContent="" OffContent="" />
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto" Margin="0,4">
                        <StackPanel Spacing="2">
                            <TextBlock Classes="section-title" FontSize="13" Text="Hide to the tray when I minimize the window" />
                            <TextBlock Classes="hint" Text="Minimizing hides the taskbar button and keeps the tray icon." />
                        </StackPanel>
                        <ToggleSwitch Grid.Column="1" IsChecked="{Binding MinimizeToTray}" OnContent="" OffContent="" />
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto" Margin="0,4">
                        <StackPanel Spacing="2">
                            <TextBlock Classes="section-title" FontSize="13" Text="Show notifications" />
                            <TextBlock Classes="hint" Text="Show toasts when clips, files or connections update." />
                        </StackPanel>
                        <ToggleSwitch Grid.Column="1" IsChecked="{Binding Notifications}" OnContent="" OffContent="" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Card 3: Clipboard -->
            <Border Classes="glass-card" Padding="20">
                <StackPanel Spacing="12">
                    <TextBlock Classes="section-title" Text="Clipboard" />
                    <Grid ColumnDefinitions="*,Auto" Margin="0,4">
                        <StackPanel Spacing="2">
                            <TextBlock Classes="section-title" FontSize="13" Text="Save text I copy" />
                            <TextBlock Classes="hint" Text="Store copied text locally for search and quick-paste." />
                        </StackPanel>
                        <ToggleSwitch Grid.Column="1" IsChecked="{Binding ClipboardHistoryEnabled}" OnContent="" OffContent="" />
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto" Margin="0,4">
                        <StackPanel Spacing="2">
                            <TextBlock Classes="section-title" FontSize="13" Text="Share with other computers" />
                            <TextBlock Classes="hint" Text="Send and receive copied clips with paired computers." />
                        </StackPanel>
                        <ToggleSwitch Grid.Column="1" IsChecked="{Binding ClipboardSyncEnabled}" OnContent="" OffContent="" />
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto" Margin="0,4">
                        <StackPanel Spacing="2">
                            <TextBlock Classes="section-title" FontSize="13" Text="Skip passwords and secrets" />
                            <TextBlock Classes="hint" Text="Ignore API keys, credit cards, and private keys." />
                        </StackPanel>
                        <ToggleSwitch Grid.Column="1" IsChecked="{Binding SkipSensitiveClips}" OnContent="" OffContent="" />
                    </Grid>
                    <Expander Header="Advanced" IsExpanded="False">
                        <StackPanel Spacing="12" Margin="0,8,0,0">
                            <Grid ColumnDefinitions="*,Auto" Margin="0,4">
                                <StackPanel Spacing="2">
                                    <TextBlock Classes="section-title" FontSize="13" Text="Delete unstarred clips after" />
                                    <TextBlock Classes="hint" Text="Automatically remove unstarred history older than this." />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <NumericUpDown Value="{Binding ClipboardRetentionDays}" Minimum="1" Maximum="3650" Increment="1"
                                                   FormatString="0" Width="120" />
                                    <TextBlock Text="days" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondary}" FontSize="12" />
                                </StackPanel>
                            </Grid>
                            <StackPanel Spacing="6" Margin="0,8,0,0">
                                <TextBlock Text="Don't save copies from these apps (one per line)" Classes="label" />
                                <TextBox Text="{Binding IgnoredAppsText}" AcceptsReturn="True" Height="100" TextWrapping="Wrap" />
                                <TextBlock Text="Copies made in these apps will not be captured or synced." Classes="hint" />
                            </StackPanel>
                        </StackPanel>
                    </Expander>
                </StackPanel>
            </Border>

            <!-- Card 4: Sharing -->
            <Border Classes="glass-card" Padding="20">
                <StackPanel Spacing="12">
                    <TextBlock Classes="section-title" Text="Sharing" />
                    <Grid ColumnDefinitions="*,Auto" Margin="0,4">
                        <StackPanel Spacing="2">
                            <TextBlock Classes="section-title" FontSize="13" Text="Accept remote input from phones" />
                            <TextBlock Classes="hint" Text="Allow paired phones to control the mouse and keyboard." />
                        </StackPanel>
                        <ToggleSwitch Grid.Column="1" IsChecked="{Binding AcceptRemoteInput}" OnContent="" OffContent="" />
                    </Grid>
                    <Expander Header="Advanced" IsExpanded="False">
                        <StackPanel Spacing="12" Margin="0,8,0,0">
                            <Grid ColumnDefinitions="*,Auto" Margin="0,4">
                                <StackPanel Spacing="2">
                                    <TextBlock Classes="section-title" FontSize="13" Text="Connection port" />
                                    <TextBlock Classes="hint" Text="UDP port phones send input to. Default is 58491." />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <NumericUpDown Value="{Binding InputPort}" Minimum="1024" Maximum="65535" Increment="1"
                                                   FormatString="0" Width="140" />
                                    <Button Classes="secondary-btn" Content="Apply" Command="{Binding ApplyPortCommand}"
                                            ToolTip.Tip="Apply connection port" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Expander>
                </StackPanel>
            </Border>

            <!-- Card 5: Security -->
            <Border Classes="glass-card" Padding="20">
                <StackPanel Spacing="12">
                    <TextBlock Classes="section-title" Text="Security" />

                    <!-- When NOT configured -->
                    <StackPanel Spacing="12" IsVisible="{Binding !IsLockConfigured}">
                        <!-- When not in setup mode -->
                        <Grid ColumnDefinitions="*,Auto" Margin="0,4" IsVisible="{Binding !IsSettingPassphrase}">
                            <StackPanel Spacing="2">
                                <TextBlock Classes="section-title" FontSize="13" Text="App lock" />
                                <TextBlock Classes="hint" Text="Protect your history and connections with a passphrase." />
                            </StackPanel>
                            <Button Grid.Column="1" Classes="secondary-btn" Content="Set a passphrase"
                                    Command="{Binding StartSetupPassphraseCommand}" />
                        </Grid>

                        <!-- Passphrase setup form -->
                        <Border Classes="glass-card" Background="{DynamicResource BgSunken}" Padding="16"
                                IsVisible="{Binding IsSettingPassphrase}">
                            <StackPanel Spacing="12">
                                <!-- Step 1: Input passphrases -->
                                <StackPanel Spacing="10" IsVisible="{Binding !ShowRecoveryKeyPrompt}">
                                    <TextBlock Classes="section-title" FontSize="13" Text="Set a passphrase" />
                                    <TextBlock Classes="hint" Text="Passphrase must be at least 8 characters." />

                                    <Grid ColumnDefinitions="140,*" Margin="0,4">
                                        <TextBlock Text="New passphrase" VerticalAlignment="Center" Classes="label" />
                                        <TextBox Grid.Column="1" PlaceholderText="Enter passphrase" PasswordChar="•"
                                                 Text="{Binding NewPassphrase, Mode=TwoWay}" />
                                    </Grid>

                                    <Grid ColumnDefinitions="140,*" Margin="0,4">
                                        <TextBlock Text="Confirm passphrase" VerticalAlignment="Center" Classes="label" />
                                        <TextBox Grid.Column="1" PlaceholderText="Re-enter passphrase" PasswordChar="•"
                                                 Text="{Binding ConfirmPassphrase, Mode=TwoWay}" />
                                    </Grid>

                                    <TextBlock Text="{Binding SetupError}" Foreground="{DynamicResource Danger}"
                                               FontSize="12" IsVisible="{Binding !!SetupError}" />

                                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" Margin="0,6,0,0">
                                        <Button Classes="secondary-btn" Content="Cancel" Command="{Binding CancelSetupPassphraseCommand}" />
                                        <Button Classes="primary-btn" Content="Save passphrase" Command="{Binding ConfirmSetupPassphraseCommand}" />
                                    </StackPanel>
                                </StackPanel>

                                <!-- Step 2: Show recovery key -->
                                <StackPanel Spacing="10" IsVisible="{Binding ShowRecoveryKeyPrompt}">
                                    <TextBlock Classes="section-title" FontSize="13" Text="Save your recovery key" />
                                    <TextBlock Classes="hint"
                                               Text="This key is shown only once and is never stored anywhere. Without your passphrase or this key, locked data cannot be recovered." />

                                    <Border Background="{DynamicResource BgInput}" BorderBrush="{DynamicResource BorderStrong}"
                                            BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,4">
                                        <SelectableTextBlock Text="{Binding SavedRecoveryKey}"
                                                             FontFamily="Consolas,Menlo,monospace"
                                                             FontSize="13"
                                                             FontWeight="Bold"
                                                             Foreground="{DynamicResource AccentSoft}"
                                                             HorizontalAlignment="Center" />
                                    </Border>

                                    <Button Classes="primary-btn" Content="I saved it" Command="{Binding AcknowledgeRecoveryKeyCommand}"
                                            HorizontalAlignment="Right" Margin="0,6,0,0" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- When CONFIGURED -->
                    <StackPanel Spacing="12" IsVisible="{Binding IsLockConfigured}">
                        <Grid ColumnDefinitions="*,Auto" Margin="0,4">
                            <StackPanel Spacing="2">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock Classes="section-title" FontSize="13" Text="App lock is on" />
                                    <Border Classes="status-pill" VerticalAlignment="Center" Padding="6,1">
                                        <TextBlock Text="Active" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource Success}" />
                                    </Border>
                                </StackPanel>
                                <TextBlock Classes="hint" Text="Mouser is protected with your passphrase." />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                <Button Classes="secondary-btn" Content="Lock now" Command="{Binding LockNowCommand}" />
                                <Button Classes="secondary-btn" Content="Change passphrase" Command="{Binding StartChangePassphraseCommand}" />
                                <Button Classes="secondary-btn" Content="Remove lock" Command="{Binding StartRemoveLockCommand}" />
                            </StackPanel>
                        </Grid>

                        <!-- Change passphrase inline form -->
                        <Border Classes="glass-card" Background="{DynamicResource BgSunken}" Padding="16"
                                IsVisible="{Binding IsChangingPassphrase}">
                            <StackPanel Spacing="10">
                                <TextBlock Classes="section-title" FontSize="13" Text="Change passphrase" />

                                <Grid ColumnDefinitions="140,*" Margin="0,4">
                                    <TextBlock Text="Current passphrase" VerticalAlignment="Center" Classes="label" />
                                    <TextBox Grid.Column="1" PlaceholderText="Current passphrase" PasswordChar="•"
                                             Text="{Binding OldPassphrase, Mode=TwoWay}" />
                                </Grid>

                                <Grid ColumnDefinitions="140,*" Margin="0,4">
                                    <TextBlock Text="New passphrase" VerticalAlignment="Center" Classes="label" />
                                    <TextBox Grid.Column="1" PlaceholderText="New passphrase (min 8 chars)" PasswordChar="•"
                                             Text="{Binding ChangeNewPassphrase, Mode=TwoWay}" />
                                </Grid>

                                <Grid ColumnDefinitions="140,*" Margin="0,4">
                                    <TextBlock Text="Confirm new" VerticalAlignment="Center" Classes="label" />
                                    <TextBox Grid.Column="1" PlaceholderText="Re-enter new passphrase" PasswordChar="•"
                                             Text="{Binding ChangeConfirmPassphrase, Mode=TwoWay}" />
                                </Grid>

                                <TextBlock Text="{Binding ChangeError}" Foreground="{DynamicResource Danger}"
                                           FontSize="12" IsVisible="{Binding !!ChangeError}" />

                                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" Margin="0,6,0,0">
                                    <Button Classes="secondary-btn" Content="Cancel" Command="{Binding CancelChangePassphraseCommand}" />
                                    <Button Classes="primary-btn" Content="Update passphrase" Command="{Binding ChangePassphraseCommand}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Remove lock inline form -->
                        <Border Classes="glass-card" Background="{DynamicResource BgSunken}" Padding="16"
                                IsVisible="{Binding IsRemovingLock}">
                            <StackPanel Spacing="10">
                                <TextBlock Classes="section-title" FontSize="13" Text="Remove lock" />
                                <TextBlock Classes="hint" Text="Enter your current passphrase to turn off app lock." />

                                <Grid ColumnDefinitions="140,*" Margin="0,4">
                                    <TextBlock Text="Passphrase" VerticalAlignment="Center" Classes="label" />
                                    <TextBox Grid.Column="1" PlaceholderText="Current passphrase" PasswordChar="•"
                                             Text="{Binding RemovePassphrase, Mode=TwoWay}" />
                                </Grid>

                                <TextBlock Text="{Binding RemoveError}" Foreground="{DynamicResource Danger}"
                                           FontSize="12" IsVisible="{Binding !!RemoveError}" />

                                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" Margin="0,6,0,0">
                                    <Button Classes="secondary-btn" Content="Cancel" Command="{Binding CancelRemoveLockCommand}" />
                                    <Button Classes="primary-btn" Content="Confirm remove" Command="{Binding RemoveLockCommand}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Advanced Expander for Security -->
                    <Expander Header="Advanced" IsExpanded="False">
                        <StackPanel Spacing="12" Margin="0,8,0,0">
                            <Grid ColumnDefinitions="*,Auto" Margin="0,4">
                                <StackPanel Spacing="2">
                                    <TextBlock Classes="section-title" FontSize="13" Text="Lock when Windows locks" />
                                    <TextBlock Classes="hint" Text="Automatically lock Mouser whenever the Windows workstation locks." />
                                </StackPanel>
                                <ToggleSwitch Grid.Column="1" IsChecked="{Binding LockWithWindows}" OnContent="" OffContent="" />
                            </Grid>
                            <Grid ColumnDefinitions="*,Auto" Margin="0,4">
                                <StackPanel Spacing="2">
                                    <TextBlock Classes="section-title" FontSize="13" Text="Lock after inactivity" />
                                    <TextBlock Classes="hint" Text="Lock Mouser after this many minutes of inactivity (0 = never)." />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <NumericUpDown Value="{Binding AutoLockMinutes}" Minimum="0" Maximum="1440" Increment="1"
                                                   FormatString="0" Width="120" />
                                    <TextBlock Text="minutes" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondary}" FontSize="12" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Expander>
                </StackPanel>
            </Border>

            <!-- Card 6: This device -->
            <Border Classes="glass-card" Padding="20">
                <StackPanel Spacing="12">
                    <TextBlock Classes="section-title" Text="This device" />
                    <Grid ColumnDefinitions="*,Auto" Margin="0,4">
                        <StackPanel Spacing="2">
                            <TextBlock Classes="section-title" FontSize="13" Text="Device name" />
                            <TextBlock Classes="hint" Text="How this computer appears to other devices on the network." />
                        </StackPanel>
                        <TextBox Grid.Column="1" Text="{Binding DeviceName}" Width="200" />
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto" Margin="0,4">
                        <StackPanel Spacing="2">
                            <TextBlock Classes="section-title" FontSize="13" Text="Data folder" />
                            <TextBlock Classes="hint" Text="Local storage for history and configuration." />
                        </StackPanel>
                        <SelectableTextBlock Grid.Column="1" Text="{Binding DataDirectory}"
                                             Foreground="{DynamicResource TextPrimary}" FontSize="12"
                                             VerticalAlignment="Center" TextWrapping="Wrap" />
                    </Grid>
                </StackPanel>
            </Border>

            <TextBlock Classes="hint" Text="{Binding StatusMessage}" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
