<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Mouser.UI.ViewModels"
             xmlns:mi="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="Mouser.UI.Views.SnippetsView"
             x:DataType="vm:SnippetsViewModel"
             Background="Transparent">

    <!-- Fills the window; below the minimum size the whole page scrolls instead of clipping. -->
    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
        <Border Padding="24,20,24,16" MinWidth="600" MinHeight="460"
                Width="{Binding $parent[ScrollViewer].Bounds.Width}"
                Height="{Binding $parent[ScrollViewer].Bounds.Height}">
            <Grid RowDefinitions="Auto,*">
                <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,16">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Snippets" Classes="page-title" />
                        <TextBlock Classes="page-subtitle" Text="Reusable text with variables like {{date}} and {{clipboard}}." />
                    </StackPanel>
                    <Button Grid.Column="1" Classes="primary-btn" VerticalAlignment="Top" Margin="16,2,0,0"
                            Command="{Binding NewSnippetCommand}" ToolTip.Tip="Create a new snippet">
                        <StackPanel Classes="btn">
                            <mi:MaterialIcon Kind="Plus" />
                            <TextBlock Text="New snippet" />
                        </StackPanel>
                    </Button>
                </Grid>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MinWidth="220" MaxWidth="320" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="2*" />
                    </Grid.ColumnDefinitions>

                    <!-- List -->
                    <Grid Grid.Column="0" RowDefinitions="Auto,*">
                        <TextBox Grid.Row="0" Text="{Binding SearchText}" PlaceholderText="Search snippets" Margin="0,0,0,10">
                            <TextBox.InnerLeftContent>
                                <mi:MaterialIcon Kind="Magnify" Foreground="{DynamicResource TextFaint}" Margin="10,0,0,0" />
                            </TextBox.InnerLeftContent>
                        </TextBox>

                        <Border Grid.Row="1" Classes="glass-card" Padding="4">
                            <Grid>
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10" Margin="16"
                                            IsVisible="{Binding IsEmpty}">
                                    <mi:MaterialIcon Kind="TextBoxOutline" Width="32" Height="32" Foreground="{DynamicResource TextFaint}" HorizontalAlignment="Center" />
                                    <TextBlock Classes="hint" TextAlignment="Center" Text="No snippets yet. Click New snippet to write your first one." />
                                </StackPanel>

                                <ListBox ItemsSource="{Binding Snippets}" SelectedItem="{Binding SelectedSnippet}"
                                         Background="Transparent" IsVisible="{Binding !IsEmpty}">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate DataType="vm:SnippetItemViewModel">
                                            <StackPanel Spacing="2" Margin="2,4">
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource TextPrimary}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding PreviewBody}" FontSize="12"
                                                           Foreground="{DynamicResource TextMuted}" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- Editor -->
                    <Border Grid.Column="2" Classes="glass-card" Padding="20">
                        <Grid>
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10"
                                        IsVisible="{Binding SelectedSnippet, Converter={x:Static ObjectConverters.IsNull}}">
                                <mi:MaterialIcon Kind="CursorDefaultClickOutline" Width="32" Height="32" Foreground="{DynamicResource TextFaint}" HorizontalAlignment="Center" />
                                <TextBlock Classes="hint" TextAlignment="Center" Text="Pick a snippet to edit it." />
                            </StackPanel>

                            <Grid IsVisible="{Binding SelectedSnippet, Converter={x:Static ObjectConverters.IsNotNull}}">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" MinHeight="140" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0" Spacing="6" Margin="0,0,0,14">
                                    <TextBlock Classes="label" Text="Name" />
                                    <TextBox Text="{Binding SelectedSnippet.Name}" PlaceholderText="For example, Email signature" />
                                </StackPanel>

                                <Grid Grid.Row="1" RowDefinitions="Auto,*" Margin="0,0,0,14">
                                    <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,6">
                                        <TextBlock Classes="label" Text="Text" VerticalAlignment="Bottom" />
                                        <Button Grid.Column="1" Classes="secondary-btn" Padding="10,4" FontSize="12"
                                                ToolTip.Tip="Insert a variable at the cursor">
                                            <StackPanel Classes="btn" Spacing="5">
                                                <mi:MaterialIcon Kind="CodeTags" Width="14" Height="14" />
                                                <TextBlock Text="Insert variable" />
                                                <mi:MaterialIcon Kind="ChevronDown" Width="14" Height="14" />
                                            </StackPanel>
                                            <Button.Flyout>
                                                <MenuFlyout>
                                                    <MenuItem Header="Date ({{date}})" Command="{Binding InsertVariableCommand}" CommandParameter="{}{{{date}}}" />
                                                    <MenuItem Header="Time ({{time}})" Command="{Binding InsertVariableCommand}" CommandParameter="{}{{{time}}}" />
                                                    <MenuItem Header="Date and time ({{datetime}})" Command="{Binding InsertVariableCommand}" CommandParameter="{}{{{datetime}}}" />
                                                    <MenuItem Header="Clipboard ({{clipboard}})" Command="{Binding InsertVariableCommand}" CommandParameter="{}{{{clipboard}}}" />
                                                    <MenuItem Header="UUID ({{uuid}})" Command="{Binding InsertVariableCommand}" CommandParameter="{}{{{uuid}}}" />
                                                    <MenuItem Header="Cursor position ({{cursor}})" Command="{Binding InsertVariableCommand}" CommandParameter="{}{{{cursor}}}" />
                                                    <MenuItem Header="Ask when pasting ({{prompt:Label}})" Command="{Binding InsertVariableCommand}" CommandParameter="{}{{{prompt:Label}}}" />
                                                </MenuFlyout>
                                            </Button.Flyout>
                                        </Button>
                                    </Grid>
                                    <TextBox Grid.Row="1" Text="{Binding SelectedSnippet.Body}"
                                             CaretIndex="{Binding CaretIndex, Mode=TwoWay}"
                                             FontFamily="{DynamicResource CodeFontFamily}" FontSize="13"
                                             AcceptsReturn="True" AcceptsTab="True" TextWrapping="Wrap"
                                             VerticalAlignment="Stretch" VerticalContentAlignment="Top"
                                             PlaceholderText="Type the snippet text. Variables like {{date}}, {{clipboard}} or {{cursor}} are filled in when you paste." />
                                </Grid>

                                <Grid Grid.Row="2" ColumnDefinitions="Auto,*,Auto">
                                    <Button Grid.Column="0" Classes="primary-btn" Command="{Binding SaveSnippetCommand}"
                                            ToolTip.Tip="Save changes to this snippet">
                                        <StackPanel Classes="btn">
                                            <mi:MaterialIcon Kind="ContentSaveOutline" />
                                            <TextBlock Text="Save" />
                                        </StackPanel>
                                    </Button>
                                    <Button Grid.Column="2" Classes="secondary-btn danger" Command="{Binding DeleteSnippetCommand}"
                                            ToolTip.Tip="Delete this snippet">
                                        <StackPanel Classes="btn">
                                            <mi:MaterialIcon Kind="DeleteOutline" />
                                            <TextBlock Text="Delete" />
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Border>
    </ScrollViewer>
</UserControl>
