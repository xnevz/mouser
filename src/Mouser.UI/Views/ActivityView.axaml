<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Mouser.UI.ViewModels"
             xmlns:mi="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             mc:Ignorable="d" d:DesignWidth="980" d:DesignHeight="640"
             x:Class="Mouser.UI.Views.ActivityView"
             x:DataType="vm:ActivityViewModel">

    <Grid RowDefinitions="Auto,*" Margin="24,20,24,16">
        <!-- Header Row -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,20">
            <StackPanel Grid.Column="0" Spacing="4">
                <TextBlock Classes="page-title" Text="Activity" />
                <TextBlock Classes="page-subtitle" Text="Pairings, transfers and connections, newest first." />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Top" Margin="16,2,0,0">
                <TextBlock Text="{Binding StatusMessage}" Classes="hint" VerticalAlignment="Center"
                           IsVisible="{Binding StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                <Button Classes="icon-btn" Command="{Binding OpenLogFolderCommand}" ToolTip.Tip="Open log folder">
                    <mi:MaterialIcon Kind="FolderOutline" Width="18" Height="18" />
                </Button>
                <Button Classes="secondary-btn" Command="{Binding CopyDiagnosticsCommand}">
                    <StackPanel Classes="btn">
                        <mi:MaterialIcon Kind="ContentCopy" />
                        <TextBlock Text="Copy diagnostics" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Events List -->
        <Border Grid.Row="1" Classes="glass-card" Padding="0">
            <Grid>
                <ListBox ItemsSource="{Binding Entries}"
                         Background="Transparent"
                         BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid ColumnDefinitions="Auto,Auto,*" Margin="8,4">
                                <TextBlock Grid.Column="0"
                                           Text="{Binding Timestamp, StringFormat='{}{0:HH:mm:ss}'}"
                                           FontFamily="{DynamicResource CodeFontFamily}"
                                           Classes="label"
                                           VerticalAlignment="Center"
                                           Margin="0,0,12,0" />

                                <Border Grid.Column="1"
                                        Classes="nav-badge"
                                        Background="{DynamicResource BgRaised}"
                                        BorderBrush="{DynamicResource BorderSubtle}"
                                        BorderThickness="1"
                                        VerticalAlignment="Center"
                                        Margin="0,0,12,0">
                                    <TextBlock Text="{Binding Category}"
                                               Foreground="{DynamicResource TextSecondary}"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               Margin="6,2" />
                                </Border>

                                <TextBlock Grid.Column="2"
                                           Text="{Binding Message}"
                                           Foreground="{DynamicResource TextPrimary}"
                                           FontSize="13"
                                           TextWrapping="Wrap"
                                           VerticalAlignment="Center" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <StackPanel IsVisible="{Binding !Entries.Count}" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10">
                    <mi:MaterialIcon Kind="History" Width="32" Height="32" Foreground="{DynamicResource TextFaint}" HorizontalAlignment="Center" />
                    <TextBlock Classes="hint" Text="Nothing yet. Pairings, transfers and connections show up here." />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
