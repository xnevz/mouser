<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Mouser.UI.Views.ToastWindow"
        Title="Notification"
        Width="320" SizeToContent="Height"
        WindowDecorations="None" CanResize="False" ShowInTaskbar="False" Topmost="True"
        ShowActivated="False"
        Background="{DynamicResource BgSurface}">

    <Border Classes="glass-card" BorderBrush="{DynamicResource BorderStrong}" BorderThickness="1"
            CornerRadius="{DynamicResource CardCornerRadius}" Padding="14,12" BoxShadow="0 8 24 0 #40000000">
        <Grid ColumnDefinitions="4,12,*">
            <Border Grid.Column="0" Background="{DynamicResource Accent}" CornerRadius="2" />
            <StackPanel Grid.Column="2" Spacing="4">
                <TextBlock x:Name="TitleText" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource TextPrimary}" />
                <TextBlock x:Name="BodyText" Classes="hint" FontSize="12" TextWrapping="Wrap" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
