<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Mouser.UI.Views.ToastWindow"
        Title="Notification"
        Width="340" SizeToContent="Height"
        WindowDecorations="None" CanResize="False" ShowInTaskbar="False" Topmost="True"
        ShowActivated="False"
        Background="{DynamicResource BgSurface}">

    <!-- Opaque surface; Windows 11 rounds the corners and draws the border (see WindowChrome). -->
    <Grid ColumnDefinitions="Auto,*" Margin="16,14">
        <Border Width="8" Height="8" CornerRadius="4" Background="{DynamicResource Accent}"
                VerticalAlignment="Top" Margin="0,5,12,0" />
        <StackPanel Grid.Column="1" Spacing="3">
            <TextBlock x:Name="TitleText" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextPrimary}"
                       TextTrimming="CharacterEllipsis" />
            <TextBlock x:Name="BodyText" FontSize="12" Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap" />
        </StackPanel>
    </Grid>
</Window>
