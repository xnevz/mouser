<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Mouser.UI.ViewModels"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="640"
             x:Class="Mouser.UI.Views.AndroidRemoteView"
             x:DataType="vm:AndroidRemoteViewModel">

    <ScrollViewer>
        <StackPanel Margin="24" Spacing="16">
            <StackPanel Spacing="4">
                <TextBlock Classes="page-title" Text="Phone Remote" />
                <TextBlock Classes="page-subtitle"
                           Text="Use the Mouser Android app as a trackpad, air mouse and media remote for this computer." />
            </StackPanel>

            <Border Classes="banner-error" IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                <TextBlock Text="{Binding ErrorMessage}" Foreground="#fecdd3" FontSize="12" TextWrapping="Wrap" />
            </Border>

            <Border Classes="banner-warning" IsVisible="{Binding !CanInject}">
                <TextBlock Foreground="#fde68a" FontSize="12" TextWrapping="Wrap"
                           Text="Mouser can't control the mouse on this operating system yet (Windows and macOS are supported). Phones can pair, but input won't reach the desktop." />
            </Border>

            <Grid ColumnDefinitions="*,16,*">
                <!-- Pairing -->
                <Border Grid.Column="0" Classes="glass-card" Padding="20">
                    <StackPanel Spacing="14">
                        <TextBlock Classes="section-title" Text="Pair a phone" />

                        <StackPanel Spacing="6">
                            <TextBlock Classes="hint" Text="1.  Connect the phone to the same Wi-Fi network as this computer." />
                            <TextBlock Classes="hint" Text="2.  Open Mouser on the phone and pick this computer from the list." />
                            <TextBlock Classes="hint" Text="3.  Enter this PIN when asked:" />
                        </StackPanel>

                        <Border Background="#0f1018" BorderBrush="#2e3248" BorderThickness="1" CornerRadius="10" Padding="16,12">
                            <Grid ColumnDefinitions="*,Auto">
                                <SelectableTextBlock Grid.Column="0" Text="{Binding PairingPinText}"
                                                     FontSize="34" FontWeight="Bold" LetterSpacing="4"
                                                     Foreground="#f8fafc" VerticalAlignment="Center" />
                                <Button Grid.Column="1" Classes="secondary-btn" Content="New PIN"
                                        Command="{Binding RegeneratePinCommand}" VerticalAlignment="Center"
                                        ToolTip.Tip="Create a new PIN. Phones paired with the old one are disconnected." />
                            </Grid>
                        </Border>

                        <Separator Background="#272a38" />

                        <StackPanel Spacing="6">
                            <TextBlock Classes="label" Text="Not listed on the phone? Enter this address manually:" />
                            <SelectableTextBlock Text="{Binding AddressText}" FontSize="15" FontWeight="SemiBold"
                                                 Foreground="#e2e8f0" TextWrapping="Wrap" />
                            <TextBlock Classes="label" Text="{Binding Port, StringFormat='Port {0}'}" />
                        </StackPanel>

                        <TextBlock Classes="hint" FontSize="11"
                                   Text="Still can't connect? Allow Mouser through your firewall for private networks, and make sure the Wi-Fi isn't a guest network that isolates devices." />
                    </StackPanel>
                </Border>

                <!-- Paired devices -->
                <Border Grid.Column="2" Classes="glass-card" Padding="20">
                    <StackPanel Spacing="14">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Grid.Column="0" Classes="section-title" Text="Paired devices" VerticalAlignment="Center" />
                            <ToggleSwitch Grid.Column="1" IsChecked="{Binding IsAccepting, Mode=OneWay}"
                                          Command="{Binding ToggleAcceptingCommand}"
                                          OnContent="Accepting input" OffContent="Remote input off" />
                        </Grid>

                        <TextBlock Classes="hint" IsVisible="{Binding !HasClients}"
                                   Text="No phones paired yet. Paired phones appear here with their live status." />

                        <ItemsControl ItemsSource="{Binding Clients}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="vm:RemoteClientItem">
                                    <Border Background="#181922" BorderBrush="#272a38" BorderThickness="1"
                                            CornerRadius="8" Padding="12,10" Margin="0,0,0,8">
                                        <Grid ColumnDefinitions="Auto,*,Auto">
                                            <Ellipse Grid.Column="0" Width="9" Height="9" Fill="{Binding StatusColor}"
                                                     VerticalAlignment="Center" Margin="0,0,12,0" />
                                            <StackPanel Grid.Column="1" Spacing="2">
                                                <TextBlock Text="{Binding Address}" FontWeight="SemiBold" Foreground="#f1f5f9" />
                                                <TextBlock FontSize="11" Foreground="#94a3b8">
                                                    <Run Text="{Binding LastSeenText}" />
                                                    <Run Text=" • " />
                                                    <Run Text="{Binding LastEvent}" />
                                                </TextBlock>
                                            </StackPanel>
                                            <Button Grid.Column="2" Classes="secondary-btn" Content="Unpair"
                                                    Command="{Binding $parent[ItemsControl].((vm:AndroidRemoteViewModel)DataContext).ForgetCommand}"
                                                    CommandParameter="{Binding}" VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Grid>

            <TextBlock Classes="hint" Text="{Binding StatusMessage}"
                       IsVisible="{Binding StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
