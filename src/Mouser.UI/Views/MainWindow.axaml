<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Mouser.UI.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1140" d:DesignHeight="740"
        x:Class="Mouser.UI.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="Mouser"
        Width="1140" Height="740"
        MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BgApp}">

    <Window.KeyBindings>
        <KeyBinding Gesture="Ctrl+OemComma" Command="{Binding NavigateCommand}" CommandParameter="Settings" />
        <KeyBinding Gesture="Ctrl+F" Command="{Binding FocusSearchCommand}" />
        <KeyBinding Gesture="Ctrl+L" Command="{Binding LockNowCommand}" />
    </Window.KeyBindings>

    <Grid ColumnDefinitions="232,*">
        <Border Grid.Column="0"
                IsEnabled="{Binding !IsLocked}"
                Background="{DynamicResource BgSidebar}"
                BorderBrush="{DynamicResource BorderSubtle}"
                BorderThickness="0,0,1,0"
                Padding="14">
            <Grid RowDefinitions="Auto,*,Auto">
                <Grid Grid.Row="0" ColumnDefinitions="Auto,*" Margin="6,8,6,24">
                    <Border Grid.Column="0" Width="34" Height="34" CornerRadius="9" Background="{DynamicResource Accent}" Margin="0,0,12,0">
                        <TextBlock Text="M" Foreground="{DynamicResource OnAccent}" FontSize="18" FontWeight="ExtraBold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Mouser" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" />
                        <TextBlock Text="Phone remote &amp; clipboard" FontSize="11" Foreground="{DynamicResource TextMuted}" />
                    </StackPanel>
                </Grid>

                <StackPanel Grid.Row="1" Spacing="4">
                    <Button Classes="nav-button" Classes.active="{Binding IsClipboardTab}"
                            Command="{Binding ShowLibraryCommand}" CommandParameter="All">
                        <Grid ColumnDefinitions="24,*,Auto">
                            <TextBlock Grid.Column="0" Text="📋" FontSize="14" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="All items" Margin="8,0,0,0" VerticalAlignment="Center" />
                            <Border Grid.Column="2" Classes="nav-badge" IsVisible="{Binding !!ClipboardHistory.AllCount}">
                                <TextBlock Text="{Binding ClipboardHistory.AllCount}" Foreground="{DynamicResource BadgeViolet}" />
                            </Border>
                        </Grid>
                    </Button>

                    <Button Classes="nav-button"
                            Command="{Binding ShowLibraryCommand}" CommandParameter="Starred">
                        <Grid ColumnDefinitions="24,*,Auto">
                            <TextBlock Grid.Column="0" Text="☆" FontSize="14" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="Pinned" Margin="8,0,0,0" VerticalAlignment="Center" />
                            <Border Grid.Column="2" Classes="nav-badge" IsVisible="{Binding !!ClipboardHistory.StarredCount}">
                                <TextBlock Text="{Binding ClipboardHistory.StarredCount}" Foreground="{DynamicResource BadgeViolet}" />
                            </Border>
                        </Grid>
                    </Button>

                    <Button Classes="nav-button" Classes.active="{Binding IsSnippetsTab}"
                            Command="{Binding NavigateCommand}" CommandParameter="Snippets"
                            ToolTip.Tip="Reusable text snippets with variables">
                        <Grid ColumnDefinitions="24,*,Auto">
                            <TextBlock Grid.Column="0" Text="✂️" FontSize="14" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="Snippets" Margin="8,0,0,0" VerticalAlignment="Center" />
                            <Border Grid.Column="2" Classes="nav-badge" IsVisible="{Binding !!Snippets.Snippets.Count}">
                                <TextBlock Text="{Binding Snippets.Snippets.Count}" Foreground="{DynamicResource BadgeViolet}" />
                            </Border>
                        </Grid>
                    </Button>

                    <TextBlock Classes="label" Text="TAGS" Margin="12,12,0,4" />

                    <ItemsControl ItemsSource="{Binding Tags}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="vm:TagViewModel">
                                <Button Classes="nav-button"
                                        Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).FilterByTagCommand}"
                                        CommandParameter="{Binding}">
                                    <Grid ColumnDefinitions="24,*,Auto">
                                        <Rectangle Grid.Column="0" Width="8" Height="8" RadiusX="2" RadiusY="2"
                                                   Fill="{Binding Brush}" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="{Binding DisplayName}" Margin="8,0,0,0" VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis" />
                                        <Border Grid.Column="2" Classes="nav-badge" IsVisible="{Binding !!Count}">
                                            <TextBlock Text="{Binding Count}" Foreground="{DynamicResource BadgeViolet}" />
                                        </Border>
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Classes="hint" Text="No tags yet" IsVisible="{Binding !Tags.Count}" Margin="12,4" />

                    <TextBlock Classes="label" Text="DEVICES" Margin="12,12,0,4" />

                    <ItemsControl ItemsSource="{Binding Devices}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="vm:SidebarDeviceViewModel">
                                <Grid ColumnDefinitions="Auto,*" Margin="12,4">
                                    <Ellipse Grid.Column="0" Fill="{Binding StatusColor}" Width="8" Height="8"
                                             VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <TextBlock Grid.Column="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis"
                                               Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Classes="hint" Text="No devices yet" IsVisible="{Binding !Devices.Count}" Margin="12,4" />

                    <Button Classes="nav-button"
                            Command="{Binding NavigateCommand}" CommandParameter="AndroidRemote"
                            ToolTip.Tip="Add a phone or view pairing PIN">
                        <Grid ColumnDefinitions="24,*,Auto">
                            <TextBlock Grid.Column="0" Text="+" FontSize="14" VerticalAlignment="Center" FontWeight="Bold" />
                            <TextBlock Grid.Column="1" Text="Add a phone" Margin="8,0,0,0" VerticalAlignment="Center" />
                            <Border Grid.Column="2" Classes="nav-badge" IsVisible="{Binding !!AndroidRemote.ActiveClientCount}">
                                <TextBlock Text="{Binding AndroidRemote.ActiveClientCount}" Foreground="{DynamicResource Success}" />
                            </Border>
                        </Grid>
                    </Button>

                    <Button Classes="nav-button" Classes.active="{Binding IsDisplaysTab}"
                            Command="{Binding NavigateCommand}" CommandParameter="DisplayMatrix"
                            ToolTip.Tip="Manage connected computers and phones">
                        <Grid ColumnDefinitions="24,*">
                            <TextBlock Grid.Column="0" Text="🖥" FontSize="14" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="Manage devices…" Margin="8,0,0,0" VerticalAlignment="Center" />
                        </Grid>
                    </Button>

                    <Button Classes="nav-button" Classes.active="{Binding IsActivityTab}"
                            Command="{Binding NavigateCommand}" CommandParameter="Activity">
                        <Grid ColumnDefinitions="24,*">
                            <TextBlock Grid.Column="0" Text="⏱" FontSize="14" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="Activity" Margin="8,0,0,0" VerticalAlignment="Center" />
                        </Grid>
                    </Button>

                    <Button Classes="nav-button" Classes.active="{Binding IsSettingsTab}"
                            Command="{Binding NavigateCommand}" CommandParameter="Settings">
                        <Grid ColumnDefinitions="24,*,Auto">
                            <TextBlock Grid.Column="0" Text="⚙" FontSize="14" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="Settings" Margin="8,0,0,0" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="2" Text="Ctrl+," Classes="hint" FontSize="11" VerticalAlignment="Center" />
                        </Grid>
                    </Button>
                </StackPanel>

                <Border Grid.Row="2" Background="{DynamicResource BgInput}" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1"
                        CornerRadius="10" Padding="12,10">
                    <StackPanel Spacing="4">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Ellipse Width="8" Height="8" Fill="{Binding StatusColor}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding SystemStatusTitle}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" />
                        </StackPanel>
                        <TextBlock Text="{Binding SystemStatusText}" FontSize="11" Foreground="{DynamicResource TextMuted}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <ContentControl x:Name="PageContent" Grid.Column="1"
                        IsEnabled="{Binding !IsLocked}"
                        Content="{Binding CurrentPage}" />

        <ContentControl Grid.Column="0" Grid.ColumnSpan="2"
                        Content="{Binding Onboarding}"
                        IsVisible="{Binding IsOnboarding}"
                        Background="{DynamicResource BgApp}" />

        <ContentControl Grid.Column="0" Grid.ColumnSpan="2"
                        Content="{Binding Lock}"
                        IsVisible="{Binding IsLocked}" />
    </Grid>
</Window>
