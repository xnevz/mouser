<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Mouser.UI.ViewModels"
        xmlns:mi="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1140" d:DesignHeight="740"
        x:Class="Mouser.UI.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="{Binding WindowTitle}"
        Width="1140" Height="740"
        MinWidth="760" MinHeight="500"
        WindowStartupLocation="CenterScreen"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="44"
        WindowDecorations="Full"
        WindowDecorationsTheme="{StaticResource MouserWindowDecorations}"
        Background="{DynamicResource BgApp}">

    <Window.KeyBindings>
        <KeyBinding Gesture="Ctrl+OemComma" Command="{Binding NavigateCommand}" CommandParameter="Settings" />
        <KeyBinding Gesture="Ctrl+F" Command="{Binding FocusSearchCommand}" />
        <KeyBinding Gesture="Ctrl+L" Command="{Binding LockNowCommand}" />
    </Window.KeyBindings>

    <Window.Styles>
        <!-- ═══ Window frame ═══ -->
        <Style Selector="Border#WindowFrame">
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource WindowFrameBorder}" />
        </Style>
        <Style Selector="Window[IsActive=False] Border#WindowFrame">
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtle}" />
        </Style>
        <Style Selector="Window[WindowState=Maximized] Border#WindowFrame, Window[WindowState=FullScreen] Border#WindowFrame">
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="Window[WindowState=Maximized] Panel#ResizeGrips, Window[WindowState=FullScreen] Panel#ResizeGrips">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="Panel#ResizeGrips > Border">
            <Setter Property="Background" Value="Transparent" />
        </Style>

        <!-- ═══ Title bar ═══ -->
        <Style Selector="Border#AccentStrip">
            <Setter Property="Transitions">
                <Transitions><DoubleTransition Property="Opacity" Duration="0:0:0.2" /></Transitions>
            </Setter>
        </Style>
        <Style Selector="Window[IsActive=False] Border#AccentStrip">
            <Setter Property="Opacity" Value="0.25" />
        </Style>
        <Style Selector="Window[IsActive=False] StackPanel#HeaderBrand">
            <Setter Property="Opacity" Value="0.6" />
        </Style>

        <Style Selector="Button.header-pill">
            <Setter Property="Background" Value="{DynamicResource BgSurface}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtle}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{DynamicResource PillCornerRadius}" />
            <Setter Property="Padding" Value="9,0,12,0" />
            <Setter Property="Height" Value="28" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.header-pill:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource BgHover}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderStrong}" />
        </Style>
        <Style Selector="Button.header-pill:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource BgPressed}" />
        </Style>
        <Style Selector="Button.header-pill TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <Style Selector="Button.header-btn">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="{DynamicResource OverlayCornerRadius}" />
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.header-btn mi|MaterialIcon">
            <Setter Property="Width" Value="18" />
            <Setter Property="Height" Value="18" />
        </Style>
        <Style Selector="Button.header-btn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource BgHover}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        </Style>
        <Style Selector="Button.header-btn:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource BgPressed}" />
        </Style>
        <Style Selector="Button.header-btn.active /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource BgSelected}" />
            <Setter Property="Foreground" Value="{DynamicResource AccentSoft}" />
        </Style>

        <!-- Caption buttons: full title-bar height, square edges, Windows-style red close. -->
        <Style Selector="Button.caption">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="Width" Value="46" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Focusable" Value="False" />
        </Style>
        <Style Selector="Button.caption mi|MaterialIcon">
            <Setter Property="Width" Value="16" />
            <Setter Property="Height" Value="16" />
        </Style>
        <Style Selector="Button.caption:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource BgHover}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        </Style>
        <Style Selector="Button.caption:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource BgPressed}" />
        </Style>
        <Style Selector="Button.caption.close:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#e81123" />
            <Setter Property="Foreground" Value="#ffffff" />
        </Style>
        <Style Selector="Button.caption.close:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#c50f1f" />
            <Setter Property="Foreground" Value="#ffffff" />
        </Style>
        <Style Selector="mi|MaterialIcon#RestoreGlyph">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="Window[WindowState=Maximized] mi|MaterialIcon#RestoreGlyph">
            <Setter Property="IsVisible" Value="True" />
        </Style>
        <Style Selector="Window[WindowState=Maximized] mi|MaterialIcon#MaximizeGlyph">
            <Setter Property="IsVisible" Value="False" />
        </Style>
    </Window.Styles>

    <!-- Frame: our own border. Margin absorbs the off-screen overhang Windows gives maximised windows. -->
    <Border x:Name="WindowFrame"
            Background="{DynamicResource BgApp}"
            Margin="{Binding $parent[Window].OffScreenMargin}">
    <Panel>
    <Grid RowDefinitions="44,*">

        <!-- ═══ Title bar: drag to move, double-click to maximise, Aero Snap — all native via ElementRole ═══ -->
        <Border Grid.Row="0" x:Name="TitleBar"
                WindowDecorationProperties.ElementRole="TitleBar"
                Background="{DynamicResource BgSidebar}"
                BorderBrush="{DynamicResource BorderSubtle}"
                BorderThickness="0,0,0,1">
            <Panel>
                <Border x:Name="AccentStrip" Height="2" VerticalAlignment="Top" IsHitTestVisible="False">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
                            <GradientStop Offset="0" Color="#006366f1" />
                            <GradientStop Offset="0.2" Color="#6366f1" />
                            <GradientStop Offset="0.55" Color="#a855f7" />
                            <GradientStop Offset="0.85" Color="#22d3ee" />
                            <GradientStop Offset="1" Color="#0022d3ee" />
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>

                <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                    <!-- Brand. Not hit-testable, so it stays part of the drag area. -->
                    <StackPanel x:Name="HeaderBrand" Grid.Column="0" Orientation="Horizontal" Spacing="10"
                                Margin="14,0,12,0" VerticalAlignment="Center" IsHitTestVisible="False">
                        <Border Width="26" Height="26" CornerRadius="8" Background="{DynamicResource Accent}">
                            <mi:MaterialIcon Kind="MouseVariant" Width="16" Height="16" Foreground="{DynamicResource OnAccent}" HorizontalAlignment="Center" />
                        </Border>
                        <TextBlock Text="Mouser" FontFamily="{DynamicResource DisplayFontFamily}" FontSize="14" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" />
                        <Border Classes="status-pill" IsVisible="{Binding IsElevated}" VerticalAlignment="Center" Padding="6,1">
                            <TextBlock Text="Admin" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource Success}" />
                        </Border>
                    </StackPanel>

                    <!-- Live status + app actions -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" Margin="0,0,10,0" VerticalAlignment="Center">
                        <Button Classes="header-pill" WindowDecorationProperties.ElementRole="User"
                                IsVisible="{Binding IsShellInteractive}"
                                Command="{Binding NavigateCommand}" CommandParameter="AndroidRemote">
                            <ToolTip.Tip>
                                <StackPanel Spacing="2">
                                    <TextBlock Text="{Binding SystemStatusTitle}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding SystemStatusText}" FontFamily="{DynamicResource CodeFontFamily}" />
                                </StackPanel>
                            </ToolTip.Tip>
                            <StackPanel Orientation="Horizontal" Spacing="7">
                                <Panel Width="12" Height="12" VerticalAlignment="Center">
                                    <Ellipse Width="12" Height="12" Fill="{Binding StatusColor}" Opacity="0.25" />
                                    <Ellipse Width="6" Height="6" Fill="{Binding StatusColor}" />
                                </Panel>
                                <mi:MaterialIcon Kind="Cellphone" Width="14" Height="14" Foreground="{DynamicResource TextMuted}" />
                                <TextBlock Text="{Binding SystemStatusTitle}" MaxWidth="150" />
                            </StackPanel>
                        </Button>

                        <Button Classes="header-pill" WindowDecorationProperties.ElementRole="User"
                                IsVisible="{Binding IsShellInteractive}"
                                Command="{Binding NavigateCommand}" CommandParameter="DisplayMatrix">
                            <ToolTip.Tip>
                                <StackPanel Spacing="2">
                                    <TextBlock Text="{Binding ComputerStatusTitle}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding ComputerStatusText}" />
                                </StackPanel>
                            </ToolTip.Tip>
                            <StackPanel Orientation="Horizontal" Spacing="7">
                                <Panel Width="12" Height="12" VerticalAlignment="Center">
                                    <Ellipse Width="12" Height="12" Fill="{Binding ComputerStatusColor}" Opacity="0.25" />
                                    <Ellipse Width="6" Height="6" Fill="{Binding ComputerStatusColor}" />
                                </Panel>
                                <mi:MaterialIcon Kind="MonitorMultiple" Width="14" Height="14" Foreground="{DynamicResource TextMuted}" />
                                <TextBlock Text="{Binding ComputerStatusTitle}" MaxWidth="150" />
                            </StackPanel>
                        </Button>

                        <Border Width="1" Height="18" Margin="4,0" Background="{DynamicResource BorderSubtle}" VerticalAlignment="Center" />

                        <Button Classes="header-btn" WindowDecorationProperties.ElementRole="User"
                                IsVisible="{Binding CanLockNow}"
                                Command="{Binding LockNowCommand}" ToolTip.Tip="Lock now (Ctrl+L)">
                            <mi:MaterialIcon Kind="LockOutline" />
                        </Button>
                        <Button Classes="header-btn" WindowDecorationProperties.ElementRole="User"
                                Command="{Binding ToggleThemeCommand}" ToolTip.Tip="{Binding ThemeToggleTip}">
                            <Panel>
                                <mi:MaterialIcon Kind="WeatherSunny" IsVisible="{Binding IsDarkTheme}" />
                                <mi:MaterialIcon Kind="WeatherNight" IsVisible="{Binding !IsDarkTheme}" />
                            </Panel>
                        </Button>
                        <Button Classes="header-btn" Classes.active="{Binding IsSettingsTab}"
                                WindowDecorationProperties.ElementRole="User"
                                IsVisible="{Binding IsShellInteractive}"
                                Command="{Binding NavigateCommand}" CommandParameter="Settings"
                                ToolTip.Tip="Settings (Ctrl+,)">
                            <mi:MaterialIcon Kind="CogOutline" />
                        </Button>
                    </StackPanel>

                    <!-- Window controls. Role "User" keeps them out of the drag area; clicks are handled in MainWindow.axaml.cs. -->
                    <StackPanel x:Name="CaptionButtons" Grid.Column="3" Orientation="Horizontal">
                        <Button Classes="caption" x:Name="MinimizeButton"
                                WindowDecorationProperties.ElementRole="User"
                                ToolTip.Tip="Minimize">
                            <mi:MaterialIcon Kind="WindowMinimize" />
                        </Button>
                        <Button Classes="caption" x:Name="MaximizeButton"
                                WindowDecorationProperties.ElementRole="User"
                                ToolTip.Tip="Maximize / Restore">
                            <Panel>
                                <mi:MaterialIcon x:Name="MaximizeGlyph" Kind="WindowMaximize" />
                                <mi:MaterialIcon x:Name="RestoreGlyph" Kind="WindowRestore" />
                            </Panel>
                        </Button>
                        <Button Classes="caption close" x:Name="CloseButton"
                                WindowDecorationProperties.ElementRole="User"
                                ToolTip.Tip="Close">
                            <mi:MaterialIcon Kind="WindowClose" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Panel>
        </Border>

    <Grid Grid.Row="1" ColumnDefinitions="224,*">
        <!-- Sidebar -->
        <Border Grid.Column="0"
                IsEnabled="{Binding !IsLocked}"
                Background="{DynamicResource BgSidebar}"
                BorderBrush="{DynamicResource BorderSubtle}"
                BorderThickness="0,0,1,0">
                <!-- Navigation scrolls on short windows so nothing below the fold is lost -->
                <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="2" Margin="10,14,10,12">
                        <TextBlock Classes="label" Text="Clipboard" Margin="12,4,0,6" />

                        <Button Classes="nav-button" Classes.active="{Binding IsClipboardTab}"
                                Command="{Binding ShowLibraryCommand}" CommandParameter="All">
                            <Grid ColumnDefinitions="26,*,Auto">
                                <mi:MaterialIcon Kind="ClipboardTextMultipleOutline" />
                                <TextBlock Grid.Column="1" Text="All items" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                <Border Grid.Column="2" Classes="nav-badge" IsVisible="{Binding !!ClipboardHistory.AllCount}">
                                    <TextBlock Text="{Binding ClipboardHistory.AllCount}" Foreground="{DynamicResource BadgeViolet}" />
                                </Border>
                            </Grid>
                        </Button>

                        <Button Classes="nav-button"
                                Command="{Binding ShowLibraryCommand}" CommandParameter="Starred">
                            <Grid ColumnDefinitions="26,*,Auto">
                                <mi:MaterialIcon Kind="StarOutline" />
                                <TextBlock Grid.Column="1" Text="Pinned" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                <Border Grid.Column="2" Classes="nav-badge" IsVisible="{Binding !!ClipboardHistory.StarredCount}">
                                    <TextBlock Text="{Binding ClipboardHistory.StarredCount}" Foreground="{DynamicResource BadgeViolet}" />
                                </Border>
                            </Grid>
                        </Button>

                        <Button Classes="nav-button" Classes.active="{Binding IsSnippetsTab}"
                                Command="{Binding NavigateCommand}" CommandParameter="Snippets"
                                ToolTip.Tip="Reusable text snippets with variables">
                            <Grid ColumnDefinitions="26,*,Auto">
                                <mi:MaterialIcon Kind="TextBoxOutline" />
                                <TextBlock Grid.Column="1" Text="Snippets" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                <Border Grid.Column="2" Classes="nav-badge" IsVisible="{Binding !!Snippets.Snippets.Count}">
                                    <TextBlock Text="{Binding Snippets.Snippets.Count}" Foreground="{DynamicResource BadgeViolet}" />
                                </Border>
                            </Grid>
                        </Button>

                        <TextBlock Classes="label" Text="Tags" Margin="12,14,0,6" IsVisible="{Binding !!Tags.Count}" />

                        <ItemsControl ItemsSource="{Binding Tags}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="vm:TagViewModel">
                                    <Button Classes="nav-button"
                                            Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).FilterByTagCommand}"
                                            CommandParameter="{Binding}">
                                        <Grid ColumnDefinitions="26,*,Auto">
                                            <Ellipse Width="8" Height="8" Fill="{Binding Brush}" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="5,0,0,0" />
                                            <TextBlock Grid.Column="1" Text="{Binding DisplayName}" VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis" />
                                            <Border Grid.Column="2" Classes="nav-badge" IsVisible="{Binding !!Count}">
                                                <TextBlock Text="{Binding Count}" Foreground="{DynamicResource BadgeViolet}" />
                                            </Border>
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Classes="label" Text="Devices" Margin="12,14,0,6" />

                        <ItemsControl ItemsSource="{Binding Devices}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="vm:SidebarDeviceViewModel">
                                    <Grid ColumnDefinitions="26,*,Auto" Margin="15,5,12,5" ToolTip.Tip="{Binding StatusText}">
                                        <mi:MaterialIcon Kind="{Binding IconKind}" Foreground="{DynamicResource TextFaint}" />
                                        <TextBlock Grid.Column="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis"
                                                   Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" />
                                        <Ellipse Grid.Column="2" Fill="{Binding StatusColor}" Width="7" Height="7" VerticalAlignment="Center" Margin="8,0,0,0" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Classes="hint" Text="No devices yet" IsVisible="{Binding !Devices.Count}" Margin="15,4" />

                        <Button Classes="nav-button" Classes.active="{Binding IsDisplaysTab}"
                                Command="{Binding NavigateCommand}" CommandParameter="DisplayMatrix"
                                ToolTip.Tip="Pair computers, arrange screens, manage phones" Margin="0,4,0,0">
                            <Grid ColumnDefinitions="26,*">
                                <mi:MaterialIcon Kind="Devices" />
                                <TextBlock Grid.Column="1" Text="Manage devices" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            </Grid>
                        </Button>

                        <Button Classes="nav-button"
                                Command="{Binding NavigateCommand}" CommandParameter="AndroidRemote"
                                ToolTip.Tip="Show this computer's address for the phone app">
                            <Grid ColumnDefinitions="26,*,Auto">
                                <mi:MaterialIcon Kind="CellphoneLink" />
                                <TextBlock Grid.Column="1" Text="Add a phone" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                <Border Grid.Column="2" Classes="nav-badge" IsVisible="{Binding !!AndroidRemote.ActiveClientCount}">
                                    <TextBlock Text="{Binding AndroidRemote.ActiveClientCount}" Foreground="{DynamicResource Success}" />
                                </Border>
                            </Grid>
                        </Button>

                        <TextBlock Classes="label" Text="App" Margin="12,14,0,6" />

                        <Button Classes="nav-button" Classes.active="{Binding IsActivityTab}"
                                Command="{Binding NavigateCommand}" CommandParameter="Activity">
                            <Grid ColumnDefinitions="26,*">
                                <mi:MaterialIcon Kind="History" />
                                <TextBlock Grid.Column="1" Text="Activity" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            </Grid>
                        </Button>
                    </StackPanel>
                </ScrollViewer>
        </Border>

        <ContentControl x:Name="PageContent" Grid.Column="1"
                        IsEnabled="{Binding !IsLocked}"
                        Content="{Binding CurrentPage}" />

        <ContentControl Grid.Column="0" Grid.ColumnSpan="2"
                        Content="{Binding Onboarding}"
                        IsVisible="{Binding IsOnboarding}"
                        Background="{DynamicResource BgApp}" />

        <ContentControl Grid.Column="0" Grid.ColumnSpan="2"
                        Content="{Binding Lock}"
                        IsVisible="{Binding IsLocked}" />

        <!-- Pairing code check: window-level so it shows on whatever page is open -->
        <Grid Grid.Column="0" Grid.ColumnSpan="2"
              IsVisible="{Binding DevicesPage.IsPairingPromptVisible}">
            <Border Background="{DynamicResource BgApp}" Opacity="0.85" />
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <Border Classes="glass-card" HorizontalAlignment="Center" VerticalAlignment="Center"
                        Padding="28" MaxWidth="420" Margin="24"
                        BorderBrush="{DynamicResource BorderStrong}">
                    <StackPanel Spacing="16">
                        <Border Classes="icon-tile" HorizontalAlignment="Center" Width="44" Height="44">
                            <mi:MaterialIcon Kind="ShieldLockOutline" Width="24" Height="24" />
                        </Border>
                        <TextBlock Text="{Binding DevicesPage.PairingPromptTitle}" FontWeight="SemiBold" FontSize="18"
                                   Foreground="{DynamicResource TextPrimary}" TextAlignment="Center" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding DevicesPage.PairingPromptSubtitle}" Classes="hint"
                                   Foreground="{DynamicResource TextSecondary}" TextAlignment="Center" TextWrapping="Wrap" />
                        <Border Background="{DynamicResource BgSunken}" CornerRadius="10" Padding="22,12"
                                BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1"
                                HorizontalAlignment="Center">
                            <TextBlock Text="{Binding DevicesPage.PairingPromptCode}" FontFamily="{DynamicResource CodeFontFamily}"
                                       FontSize="32" FontWeight="Bold" Foreground="{DynamicResource AccentSoft}"
                                       LetterSpacing="6" TextAlignment="Center" />
                        </Border>
                        <Grid ColumnDefinitions="*,12,*" Margin="0,4,0,0">
                            <Button Grid.Column="0" Classes="primary-btn" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                    Content="{Binding DevicesPage.ConfirmButtonText}" Command="{Binding DevicesPage.ConfirmPairingCommand}" />
                            <Button Grid.Column="2" Classes="secondary-btn" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                    Content="{Binding DevicesPage.DenyButtonText}" Command="{Binding DevicesPage.DenyPairingCommand}" />
                        </Grid>
                    </StackPanel>
                </Border>
            </ScrollViewer>
        </Grid>

        <!-- Modal incoming file card overlay -->
        <Grid Grid.Column="0" Grid.ColumnSpan="2"
              IsVisible="{Binding IsIncomingFilePromptVisible}">
            <Border Background="{DynamicResource BgApp}" Opacity="0.85" />
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <Border Classes="glass-card" HorizontalAlignment="Center" VerticalAlignment="Center"
                        Padding="28" MaxWidth="480" Margin="24"
                        BorderBrush="{DynamicResource BorderStrong}">
                    <StackPanel Spacing="16">
                        <Grid ColumnDefinitions="Auto,*">
                            <Border Classes="icon-tile" Margin="0,0,14,0" VerticalAlignment="Top">
                                <mi:MaterialIcon Kind="FileSendOutline" />
                            </Border>
                            <StackPanel Grid.Column="1" Spacing="4">
                                <TextBlock Text="{Binding IncomingFilePromptTitle}"
                                           FontWeight="SemiBold" FontSize="16"
                                           Foreground="{DynamicResource TextPrimary}"
                                           TextWrapping="Wrap" />
                                <TextBlock Text="{Binding IncomingFilePromptSubtitle}"
                                           Classes="hint" TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>
                        <WrapPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Classes="secondary-btn" Content="Decline"
                                    Command="{Binding DeclineIncomingFileCommand}" Margin="0,0,8,8" />
                            <Button Classes="secondary-btn" Content="Always accept from this device"
                                    Command="{Binding AlwaysAcceptIncomingFileCommand}" Margin="0,0,8,8" />
                            <Button Classes="primary-btn" Content="Accept"
                                    Command="{Binding AcceptIncomingFileCommand}" Margin="0,0,0,8" />
                        </WrapPanel>
                    </StackPanel>
                </Border>
            </ScrollViewer>
        </Grid>
    </Grid>
    </Grid>

    <!-- Resize grips for platforms where Mouser draws the whole frame (Linux). Windows and macOS resize natively. -->
    <Panel x:Name="ResizeGrips">
        <Border Height="5" VerticalAlignment="Top" WindowDecorationProperties.ElementRole="ResizeN" Cursor="TopSide" />
        <Border Height="5" VerticalAlignment="Bottom" WindowDecorationProperties.ElementRole="ResizeS" Cursor="BottomSide" />
        <Border Width="5" HorizontalAlignment="Left" WindowDecorationProperties.ElementRole="ResizeW" Cursor="LeftSide" />
        <Border Width="5" HorizontalAlignment="Right" WindowDecorationProperties.ElementRole="ResizeE" Cursor="RightSide" />
        <Border Width="10" Height="10" HorizontalAlignment="Left" VerticalAlignment="Top" WindowDecorationProperties.ElementRole="ResizeNW" Cursor="TopLeftCorner" />
        <Border Width="10" Height="10" HorizontalAlignment="Right" VerticalAlignment="Top" WindowDecorationProperties.ElementRole="ResizeNE" Cursor="TopRightCorner" />
        <Border Width="10" Height="10" HorizontalAlignment="Left" VerticalAlignment="Bottom" WindowDecorationProperties.ElementRole="ResizeSW" Cursor="BottomLeftCorner" />
        <Border Width="10" Height="10" HorizontalAlignment="Right" VerticalAlignment="Bottom" WindowDecorationProperties.ElementRole="ResizeSE" Cursor="BottomRightCorner" />
    </Panel>
    </Panel>
    </Border>
</Window>
