<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Mouser.UI.ViewModels"
        xmlns:mi="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
        x:Class="Mouser.UI.Views.QuickPasteWindow"
        x:DataType="vm:QuickPasteViewModel"
        Title="Quick paste"
        Width="560" SizeToContent="Height" MaxHeight="520"
        WindowDecorations="None" CanResize="False" ShowInTaskbar="False" Topmost="True"
        WindowStartupLocation="Manual"
        Background="{DynamicResource BgSurface}">

    <Window.Styles>
        <Style Selector="Button.tab-chip">
            <Setter Property="Background" Value="{DynamicResource BgRaised}" />
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtle}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="10,3" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.tab-chip:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource BgHover}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        </Style>
        <Style Selector="Button.tab-chip.active /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Accent}" />
            <Setter Property="Foreground" Value="{DynamicResource OnAccent}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
        </Style>
    </Window.Styles>

    <Border Classes="glass-card" BorderBrush="{DynamicResource AccentSoft}" BorderThickness="1" CornerRadius="{DynamicResource CardCornerRadius}" Padding="14" BoxShadow="0 8 32 0 #50000000">
        <StackPanel Spacing="10">
            <TextBox x:Name="SearchBox" Text="{Binding Query}" PlaceholderText="Search history. Enter pastes, Shift+Enter keeps formatting, Esc closes">
                <TextBox.InnerLeftContent>
                    <mi:MaterialIcon Kind="Magnify" Foreground="{DynamicResource TextFaint}" Margin="10,0,0,0" />
                </TextBox.InnerLeftContent>
            </TextBox>

            <!-- Tabs: All / Pinned / each tag -->
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <Button Classes="tab-chip active"
                            IsVisible="{Binding HasDeviceFilter}"
                            Command="{Binding ClearDeviceFilterCommand}"
                            ToolTip.Tip="Clear device filter">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBlock Text="{Binding DeviceFilterText}" VerticalAlignment="Center" />
                            <mi:MaterialIcon Kind="Close" Width="12" Height="12" />
                        </StackPanel>
                    </Button>
                    <ItemsControl ItemsSource="{Binding Tabs}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="6" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="vm:QuickPasteTabViewModel">
                                <Button Classes="tab-chip"
                                        Classes.active="{Binding IsSelected}"
                                        Content="{Binding DisplayName}"
                                        Command="{Binding $parent[Window].((vm:QuickPasteViewModel)DataContext).SelectTabCommand}"
                                        CommandParameter="{Binding Name}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>

            <TextBlock Classes="hint" IsVisible="{Binding IsEmpty}" Margin="4"
                       Text="No clips yet. Copy some text and it shows up here." />

            <ListBox x:Name="ClipList" ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}"
                     Background="Transparent" MaxHeight="380" IsVisible="{Binding !IsEmpty}">
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="vm:ClipboardItemViewModel">
                        <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto" Margin="2,3" VerticalAlignment="Center">
                            <!-- Digit 1-9 shortcut for first nine items -->
                            <Border Grid.Column="0" Width="18" Height="18" CornerRadius="4" Margin="0,0,8,0"
                                    Background="{DynamicResource BgRaised}" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1"
                                    IsVisible="{Binding HasShortcutDigit}" VerticalAlignment="Center">
                                <TextBlock Text="{Binding ShortcutDigit}" FontSize="10" FontWeight="Bold"
                                           Foreground="{DynamicResource TextMuted}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>

                            <!-- Thumbnail (if image) or Type Badge -->
                            <Panel Grid.Column="1" Width="26" Height="26" Margin="0,0,8,0" VerticalAlignment="Center">
                                <!-- Thumbnail for image clips -->
                                <Border CornerRadius="4" ClipToBounds="True" Width="26" Height="26"
                                        IsVisible="{Binding Thumbnail, Converter={x:Static ObjectConverters.IsNotNull}}">
                                    <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" Width="26" Height="26" />
                                </Border>
                                <!-- Badge for non-image clips -->
                                <Border Background="{DynamicResource BgRaised}" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1"
                                        CornerRadius="4" Width="26" Height="26"
                                        IsVisible="{Binding !IsImage}">
                                    <mi:MaterialIcon Kind="{Binding TypeIconKind}" Width="14" Height="14"
                                                     Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Center" />
                                </Border>
                                <!-- Fallback placeholder for image without loaded thumbnail -->
                                <Border Background="{DynamicResource BgRaised}" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1"
                                        CornerRadius="4" Width="26" Height="26"
                                        IsVisible="{Binding IsImagePlaceholder}">
                                    <mi:MaterialIcon Kind="ImageOutline" Width="14" Height="14"
                                                     Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Center" />
                                </Border>
                            </Panel>

                            <!-- Title -->
                            <TextBlock Grid.Column="2" Text="{Binding PreviewTitle}"
                                       Foreground="{DynamicResource TextPrimary}" TextTrimming="CharacterEllipsis"
                                       FontSize="13" VerticalAlignment="Center" />

                            <!-- Device -->
                            <TextBlock Grid.Column="3" Text="{Binding SourceDevice}"
                                       Foreground="{DynamicResource TextFaint}" FontSize="11" Margin="8,0,0,0"
                                       VerticalAlignment="Center" />

                            <!-- Star / Pinned indicator -->
                            <mi:MaterialIcon Grid.Column="4" Kind="{Binding StarIcon}" Foreground="{Binding StarColor}" Width="14" Height="14"
                                             Margin="8,0,0,0" IsVisible="{Binding IsPinned}" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </StackPanel>
    </Border>
</Window>
