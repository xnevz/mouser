<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Mouser.UI.ViewModels"
        xmlns:mi="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
        x:Class="Mouser.UI.Views.QuickPasteWindow"
        x:DataType="vm:QuickPasteViewModel"
        Title="Quick paste"
        Width="600" SizeToContent="Height" MaxHeight="540"
        WindowDecorations="None" CanResize="False" ShowInTaskbar="False" Topmost="True"
        WindowStartupLocation="Manual"
        Background="{DynamicResource BgSurface}">

    <!--
      Command-palette layout: search / filters / results / key hints.
      The window itself is the surface: it stays opaque so text gets full subpixel antialiasing, and
      Windows 11 rounds its corners and draws the hairline border natively (see WindowChrome).
    -->
    <Window.Styles>
        <!-- Search: large, borderless, no focus ring; the whole popup is the focus context. -->
        <Style Selector="TextBox.palette-search">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="MinHeight" Value="52" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="CornerRadius" Value="0" />
        </Style>
        <Style Selector="TextBox.palette-search /template/ Border#PART_BorderElement,
                         TextBox.palette-search:focus /template/ Border#PART_BorderElement,
                         TextBox.palette-search:pointerover /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>

        <!-- Filter tabs: text-weight tabs, the active one sits on a neutral fill. -->
        <Style Selector="Button.tab">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="{DynamicResource ControlCornerRadius}" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="MinHeight" Value="26" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.tab:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource BgHover}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        </Style>
        <Style Selector="Button.tab.active /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource BgActive}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        </Style>

        <!-- Result rows -->
        <Style Selector="ListBox#ClipList ListBoxItem">
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="MinHeight" Value="44" />
            <Setter Property="CornerRadius" Value="{DynamicResource OverlayCornerRadius}" />
        </Style>
        <Style Selector="ListBox#ClipList ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter,
                         ListBox#ClipList ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource BgSelected}" />
        </Style>
        <Style Selector="ListBox#ClipList ListBoxItem:selected TextBlock.row-title">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        </Style>

        <Style Selector="TextBlock.footer-hint">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{DynamicResource TextFaint}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Window.Styles>

    <DockPanel>
        <!-- Search -->
        <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*" Margin="18,0,16,0">
            <mi:MaterialIcon Kind="Magnify" Width="20" Height="20" Foreground="{DynamicResource TextFaint}" Margin="0,0,12,0" />
            <TextBox x:Name="SearchBox" Grid.Column="1" Classes="palette-search"
                     Text="{Binding Query}" PlaceholderText="Search clipboard history" />
        </Grid>
        <Border DockPanel.Dock="Top" Height="1" Background="{DynamicResource BorderSubtle}" />

        <!-- Filter tabs: All / Pinned / each tag, plus an active device filter -->
        <ScrollViewer DockPanel.Dock="Top" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled"
                      Margin="10,8,10,0">
            <StackPanel Orientation="Horizontal" Spacing="2">
                <Button Classes="tab active"
                        IsVisible="{Binding HasDeviceFilter}"
                        Command="{Binding ClearDeviceFilterCommand}"
                        ToolTip.Tip="Clear device filter">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <TextBlock Text="{Binding DeviceFilterText}" VerticalAlignment="Center" />
                        <mi:MaterialIcon Kind="Close" Width="12" Height="12" />
                    </StackPanel>
                </Button>
                <ItemsControl ItemsSource="{Binding Tabs}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="2" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="vm:QuickPasteTabViewModel">
                            <Button Classes="tab"
                                    Classes.active="{Binding IsSelected}"
                                    Content="{Binding DisplayName}"
                                    Command="{Binding $parent[Window].((vm:QuickPasteViewModel)DataContext).SelectTabCommand}"
                                    CommandParameter="{Binding Name}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <!-- Key hints -->
        <Border DockPanel.Dock="Bottom" Background="{DynamicResource BgApp}"
                BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="0,1,0,0" Padding="16,0" Height="38">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <Border Classes="chip" Padding="8,1" IsVisible="{Binding HasActiveTransform}">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <mi:MaterialIcon Kind="AutoFix" Width="12" Height="12" Foreground="{DynamicResource AccentSoft}" />
                            <TextBlock Text="{Binding ActiveTransformName}" FontSize="11" />
                        </StackPanel>
                    </Border>
                    <TextBlock Classes="footer-hint" Text="Clipboard" IsVisible="{Binding !HasActiveTransform}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="14">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Classes="footer-hint" Text="Paste" />
                        <Border Classes="kbd"><TextBlock Text="↵" /></Border>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Classes="footer-hint" Text="Keep formatting" />
                        <Border Classes="kbd"><TextBlock Text="⇧ ↵" /></Border>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Classes="footer-hint" Text="Transform" />
                        <Border Classes="kbd"><TextBlock Text="Tab" /></Border>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Results -->
        <Panel>
            <StackPanel IsVisible="{Binding IsEmpty}" Spacing="8" Margin="24,40,24,44" HorizontalAlignment="Center">
                <mi:MaterialIcon Kind="ClipboardTextOutline" Width="28" Height="28" Foreground="{DynamicResource TextFaint}" HorizontalAlignment="Center" />
                <TextBlock Text="Nothing here yet" FontSize="13" FontWeight="Medium" Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Center" />
                <TextBlock Classes="hint" Text="Copy something and it shows up here." HorizontalAlignment="Center" />
            </StackPanel>

            <ListBox x:Name="ClipList" ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}"
                     Padding="8,6,8,8" MaxHeight="400" IsVisible="{Binding !IsEmpty}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="vm:ClipboardItemViewModel">
                        <Grid ColumnDefinitions="Auto,*,Auto,Auto" VerticalAlignment="Center">
                            <!-- Thumbnail for images, type icon otherwise -->
                            <Panel Width="28" Height="28" Margin="0,0,12,0" VerticalAlignment="Center">
                                <Border CornerRadius="5" ClipToBounds="True"
                                        IsVisible="{Binding Thumbnail, Converter={x:Static ObjectConverters.IsNotNull}}">
                                    <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" />
                                </Border>
                                <Border Classes="icon-tile" Width="28" Height="28" CornerRadius="5"
                                        IsVisible="{Binding !IsImage}">
                                    <mi:MaterialIcon Kind="{Binding TypeIconKind}" Width="15" Height="15" />
                                </Border>
                                <Border Classes="icon-tile" Width="28" Height="28" CornerRadius="5"
                                        IsVisible="{Binding IsImagePlaceholder}">
                                    <mi:MaterialIcon Kind="ImageOutline" Width="15" Height="15" />
                                </Border>
                            </Panel>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                <TextBlock Classes="row-title" Text="{Binding PreviewTitle}" FontSize="13"
                                           Foreground="{DynamicResource TextSecondary}" TextTrimming="CharacterEllipsis" MaxLines="1" />
                                <TextBlock FontSize="11" Foreground="{DynamicResource TextFaint}" TextTrimming="CharacterEllipsis">
                                    <Run Text="{Binding SourceDevice}" /><Run Text="  ·  " /><Run Text="{Binding FormattedTime}" />
                                </TextBlock>
                            </StackPanel>

                            <mi:MaterialIcon Grid.Column="2" Kind="Star" Width="13" Height="13" Margin="12,0,0,0"
                                             Foreground="{DynamicResource Warning}" IsVisible="{Binding IsPinned}" />

                            <!-- 1-9 quick pick -->
                            <Border Grid.Column="3" Classes="kbd" Margin="12,0,0,0" IsVisible="{Binding HasShortcutDigit}">
                                <TextBlock Text="{Binding ShortcutDigit}" />
                            </Border>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Panel>
    </DockPanel>
</Window>
