<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Mouser.UI.ViewModels"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="600"
             x:Class="Mouser.UI.Views.ClipboardHistoryView"
             x:DataType="vm:ClipboardHistoryViewModel">

    <Grid RowDefinitions="Auto,*,Auto" Margin="24">
        <!-- Header & Search Bar -->
        <Grid Grid.Row="0" Margin="0,0,0,18" RowDefinitions="Auto,Auto">
            <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,14">
                <StackPanel Grid.Column="0" Spacing="4">
                    <TextBlock Text="Universal Smart Clipboard" FontSize="20" FontWeight="Bold" Foreground="#f4f4f5" />
                    <TextBlock Text="End-to-End Encrypted, multi-device clipboard history with instant full-text search"
                               FontSize="13" Foreground="#71717a" />
                </StackPanel>

                <Button Grid.Column="1" Classes="secondary-btn" Command="{Binding ClearAllCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="🗑" FontSize="12" />
                        <TextBlock Text="Clear History" />
                    </StackPanel>
                </Button>
            </Grid>

            <!-- Search Field & Filter Chips -->
            <Grid Grid.Row="1" ColumnDefinitions="*,Auto">
                <TextBox Grid.Column="0"
                         Text="{Binding SearchQuery, Mode=TwoWay}"
                         PlaceholderText="Search clipboard history (FTS5 full-text indexing)..."
                         Background="#18181b"
                         Foreground="#f4f4f5"
                         BorderBrush="#27272a"
                         CornerRadius="8"
                         Padding="12,10"
                         Margin="0,0,12,0" />

                <!-- Filter Chips -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                    <Button Classes="secondary-btn" Command="{Binding SetFilterCommand}" CommandParameter="All" Content="All" />
                    <Button Classes="secondary-btn" Command="{Binding SetFilterCommand}" CommandParameter="Text" Content="Text" />
                    <Button Classes="secondary-btn" Command="{Binding SetFilterCommand}" CommandParameter="Code" Content="Code" />
                    <Button Classes="secondary-btn" Command="{Binding SetFilterCommand}" CommandParameter="Link" Content="Links" />
                </StackPanel>
            </Grid>
        </Grid>

        <!-- Main Workspace: List of Clips + Selected Clip Preview -->
        <Grid Grid.Row="1" ColumnDefinitions="*,340">
            <!-- Scrollable Clips List -->
            <Border Grid.Column="0" Classes="glass-card" Margin="0,0,16,0" Padding="8">
                <ScrollViewer>
                    <ItemsControl ItemsSource="{Binding FilteredClips}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="vm:ClipboardItemViewModel">
                                <Border Background="#1f1f23"
                                        BorderBrush="#2e2e33"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="14"
                                        Margin="4,4,4,8">
                                    <Grid RowDefinitions="Auto,Auto,Auto">
                                        <!-- Card Header -->
                                        <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto,Auto">
                                            <Border Grid.Column="0"
                                                    Background="{Binding BadgeColor}"
                                                    CornerRadius="4"
                                                    Padding="6,2"
                                                    Margin="0,0,8,0">
                                                <TextBlock Text="{Binding ContentType}"
                                                           FontSize="10"
                                                           FontWeight="Bold"
                                                           Foreground="#ffffff" />
                                            </Border>

                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding PreviewTitle}"
                                                       FontWeight="SemiBold"
                                                       FontSize="13"
                                                       Foreground="#f4f4f5"
                                                       TextTrimming="CharacterEllipsis"
                                                       VerticalAlignment="Center" />

                                            <TextBlock Grid.Column="2"
                                                       Text="{Binding SourceDevice}"
                                                       FontSize="11"
                                                       Foreground="#71717a"
                                                       Margin="8,0"
                                                       VerticalAlignment="Center" />

                                            <TextBlock Grid.Column="3"
                                                       Text="{Binding FormattedTime}"
                                                       FontSize="11"
                                                       Foreground="#52525b"
                                                       VerticalAlignment="Center" />
                                        </Grid>

                                        <!-- Card Snippet Preview -->
                                        <TextBlock Grid.Row="1"
                                                   Text="{Binding Content}"
                                                   Foreground="#a1a1aa"
                                                   FontSize="12"
                                                   MaxLines="2"
                                                   TextTrimming="CharacterEllipsis"
                                                   Margin="0,8,0,10" />

                                        <!-- Card Footer Actions -->
                                        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                                            <Button Classes="primary-btn"
                                                    Padding="10,4"
                                                    FontSize="11"
                                                    Command="{Binding $parent[UserControl].((vm:ClipboardHistoryViewModel)DataContext).CopyClipCommand}"
                                                    CommandParameter="{Binding}">
                                                <TextBlock Text="Copy" />
                                            </Button>

                                            <Button Classes="secondary-btn"
                                                    Padding="8,4"
                                                    FontSize="11"
                                                    Command="{Binding $parent[UserControl].((vm:ClipboardHistoryViewModel)DataContext).DeleteClipCommand}"
                                                    CommandParameter="{Binding}">
                                                <TextBlock Text="✕" />
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>

            <!-- Detailed Inspector / Payload Viewer -->
            <Border Grid.Column="1" Classes="glass-card" Padding="18">
                <Grid RowDefinitions="Auto,*,Auto">
                    <TextBlock Grid.Row="0" Text="Clip Payload Inspector" FontSize="14" FontWeight="SemiBold" Foreground="#f4f4f5" Margin="0,0,0,12" />

                    <TextBox Grid.Row="1"
                             Text="{Binding SelectedClip.Content, FallbackValue='Select a clip to inspect full contents'}"
                             IsReadOnly="True"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             Background="#141416"
                             Foreground="#d4d4d8"
                             BorderBrush="#27272a"
                             CornerRadius="8"
                             FontFamily="SF Mono, Menlo, Monaco, Consolas, monospace"
                             FontSize="12" />

                    <StackPanel Grid.Row="2" Margin="0,14,0,0" Spacing="6">
                        <TextBlock Text="Privacy Filter Status:" FontSize="11" Foreground="#71717a" />
                        <TextBlock Text="● Passwords &amp; Tokens automatically excluded" FontSize="11" Foreground="#10b981" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- Status Bottom Bar -->
        <Border Grid.Row="2" Margin="0,14,0,0" Padding="12,8" Background="#18181b" CornerRadius="8" BorderBrush="#27272a" BorderThickness="1">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0" Text="{Binding StatusMessage}" FontSize="12" Foreground="#a1a1aa" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="Shortcut: ⌘ + Shift + V" FontSize="11" Foreground="#71717a" VerticalAlignment="Center" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
