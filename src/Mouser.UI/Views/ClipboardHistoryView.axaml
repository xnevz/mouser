<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Mouser.UI.ViewModels"
             mc:Ignorable="d" d:DesignWidth="980" d:DesignHeight="640"
             x:Class="Mouser.UI.Views.ClipboardHistoryView"
             x:DataType="vm:ClipboardHistoryViewModel">

    <UserControl.Styles>
        <Style Selector="ListBox.clips ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>
        <Style Selector="ListBox.clips ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="ListBox.clips ListBoxItem:selected Border.clip-card">
            <Setter Property="BorderBrush" Value="#6366f1" />
            <Setter Property="Background" Value="#1a1b28" />
        </Style>
        <Style Selector="Border.clip-card">
            <Setter Property="Background" Value="#15161f" />
            <Setter Property="BorderBrush" Value="#262938" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="12,10" />
        </Style>
        <Style Selector="RadioButton.filter">
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="FontSize" Value="12" />
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="24">
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,14">
            <StackPanel Spacing="4">
                <TextBlock Classes="page-title" Text="Clipboard History" />
                <TextBlock Classes="page-subtitle"
                           Text="Text you copy on this computer is saved here so you can find and copy it again. History stays on this computer." />
            </StackPanel>
            <Button Grid.Column="1" Classes="secondary-btn" Content="Clear history" VerticalAlignment="Center"
                    Command="{Binding ClearAllCommand}" ToolTip.Tip="Delete all clips except starred ones" />
        </Grid>

        <Border Grid.Row="1" Classes="banner-warning" Margin="0,0,0,12" IsVisible="{Binding !IsCaptureEnabled}">
            <TextBlock Foreground="#fde68a" FontSize="12" TextWrapping="Wrap"
                       Text="Saving new clips is turned off. Turn it back on in Settings." />
        </Border>

        <Grid Grid.Row="2" ColumnDefinitions="*,16,340">
            <!-- List -->
            <Grid Grid.Column="0" RowDefinitions="Auto,Auto,*">
                <TextBox Grid.Row="0" PlaceholderText="Search clips…" Text="{Binding SearchQuery}" Margin="0,0,0,10" />

                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
                    <RadioButton Classes="filter" GroupName="lib" Content="{Binding AllCount, StringFormat='All ({0})'}"
                                 IsChecked="True" Command="{Binding SetLibraryCommand}" CommandParameter="All" />
                    <RadioButton Classes="filter" GroupName="lib" Content="{Binding StarredCount, StringFormat='Starred ({0})'}"
                                 Command="{Binding SetLibraryCommand}" CommandParameter="Starred" />
                    <Rectangle Width="1" Fill="#2e3248" Margin="8,4" />
                    <RadioButton Classes="filter" GroupName="kind" Content="Any type" IsChecked="True"
                                 Command="{Binding SetFilterCommand}" CommandParameter="All" />
                    <RadioButton Classes="filter" GroupName="kind" Content="Text"
                                 Command="{Binding SetFilterCommand}" CommandParameter="Text" />
                    <RadioButton Classes="filter" GroupName="kind" Content="Links"
                                 Command="{Binding SetFilterCommand}" CommandParameter="Link" />
                    <RadioButton Classes="filter" GroupName="kind" Content="Code"
                                 Command="{Binding SetFilterCommand}" CommandParameter="Code" />
                </StackPanel>

                <Grid Grid.Row="2">
                    <TextBlock Classes="hint" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"
                               IsVisible="{Binding IsEmpty}"
                               Text="Nothing here yet.&#10;Copy some text anywhere on this computer and it will show up." />

                    <ListBox Classes="clips" Background="Transparent" ItemsSource="{Binding FilteredClips}"
                             SelectedItem="{Binding SelectedClip}" IsVisible="{Binding !IsEmpty}">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="vm:ClipboardItemViewModel">
                                <Border Classes="clip-card">
                                    <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto">
                                        <Border Grid.RowSpan="2" Background="{Binding BadgeColor}" CornerRadius="6"
                                                Width="30" Height="30" Margin="0,0,12,0" VerticalAlignment="Top">
                                            <TextBlock Text="{Binding TypeIcon}" FontSize="11" FontWeight="Bold" Foreground="#ffffff"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <TextBlock Grid.Column="1" Text="{Binding PreviewTitle}" FontSize="13" FontWeight="SemiBold"
                                                   Foreground="#f1f5f9" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="1" Grid.Row="1" FontSize="11" Foreground="#64748b" Margin="0,3,0,0">
                                            <Run Text="{Binding ContentType}" />
                                            <Run Text=" • " />
                                            <Run Text="{Binding FormattedTime}" />
                                        </TextBlock>
                                        <TextBlock Grid.Column="2" Grid.RowSpan="2" Text="{Binding StarIcon}" FontSize="15"
                                                   Foreground="{Binding StarColor}" VerticalAlignment="Center" Margin="8,0,0,0" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Grid>

            <!-- Detail -->
            <Border Grid.Column="2" Classes="glass-card" Padding="16">
                <Grid RowDefinitions="Auto,*,Auto,Auto">
                    <TextBlock Grid.Row="0" Classes="section-title" Margin="0,0,0,10" TextTrimming="CharacterEllipsis"
                               Text="{Binding SelectedClip.PreviewTitle, FallbackValue='No clip selected'}" />

                    <TextBox Grid.Row="1" Text="{Binding SelectedClip.Content, Mode=OneWay, FallbackValue=''}"
                             IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True"
                             FontFamily="Cascadia Mono, Consolas, Menlo, monospace" FontSize="12"
                             VerticalContentAlignment="Top" />

                    <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8" Margin="0,12,0,10"
                                IsVisible="{Binding SelectedClip, Converter={x:Static ObjectConverters.IsNotNull}}">
                        <Button Classes="primary-btn" Content="Copy" Command="{Binding CopyClipCommand}" CommandParameter="{Binding SelectedClip}" />
                        <Button Classes="secondary-btn" Command="{Binding ToggleStarCommand}" CommandParameter="{Binding SelectedClip}"
                                Content="{Binding SelectedClip.StarIcon, StringFormat='{}{0} Star', FallbackValue='☆ Star'}" />
                        <Button Classes="secondary-btn" Content="Delete" Command="{Binding DeleteClipCommand}" CommandParameter="{Binding SelectedClip}" />
                    </StackPanel>

                    <TextBlock Grid.Row="3" Classes="label"
                               IsVisible="{Binding SelectedClip, Converter={x:Static ObjectConverters.IsNotNull}}">
                        <Run Text="{Binding SelectedClip.CharCount, FallbackValue=0}" /><Run Text=" characters • " />
                        <Run Text="{Binding SelectedClip.WordCount, FallbackValue=0}" /><Run Text=" words • " />
                        <Run Text="{Binding SelectedClip.LineCount, FallbackValue=0}" /><Run Text=" lines" />
                    </TextBlock>
                </Grid>
            </Border>
        </Grid>

        <TextBlock Grid.Row="3" Classes="hint" Margin="0,12,0,0" Text="{Binding StatusMessage}" />
    </Grid>
</UserControl>
