<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Mouser.UI.ViewModels"
             xmlns:net="using:Mouser.Core.Networking"
             xmlns:mi="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             mc:Ignorable="d" d:DesignWidth="980" d:DesignHeight="640"
             x:Class="Mouser.UI.Views.ClipboardHistoryView"
             x:DataType="vm:ClipboardHistoryViewModel"
             x:Name="Root">

    <UserControl.Styles>
        <Style Selector="ListBox.clips ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>
        <Style Selector="ListBox.clips ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="ListBox.clips ListBoxItem:selected Border.clip-card">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentSoft}" />
            <Setter Property="Background" Value="{DynamicResource BgActive}" />
        </Style>
        <Style Selector="Border.clip-card">
            <Setter Property="Background" Value="{DynamicResource BgListItem}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtle}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{DynamicResource ControlCornerRadius}" />
            <Setter Property="Padding" Value="12,10" />
        </Style>
        <Style Selector="ListBox.clips ListBoxItem:pointerover Border.clip-card">
            <Setter Property="BorderBrush" Value="{DynamicResource BorderStrong}" />
        </Style>
        <Style Selector="Border.type-badge">
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="36" />
            <Setter Property="CornerRadius" Value="{DynamicResource ControlCornerRadius}" />
            <Setter Property="Background" Value="{DynamicResource BgRaised}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtle}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style Selector="Border.type-badge > mi|MaterialIcon">
            <Setter Property="Width" Value="18" />
            <Setter Property="Height" Value="18" />
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>
        <Style Selector="Border.meta-card">
            <Setter Property="Margin" Value="0,10,0,0" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="Background" Value="{DynamicResource BgRaised}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtle}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{DynamicResource ControlCornerRadius}" />
        </Style>
    </UserControl.Styles>

    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
    <Border Padding="24,20,24,16" MinWidth="620" MinHeight="520"
            Width="{Binding $parent[ScrollViewer].Bounds.Width}"
            Height="{Binding $parent[ScrollViewer].Bounds.Height}">
    <Grid RowDefinitions="Auto,Auto,*,Auto">
        <StackPanel Grid.Row="0" Spacing="4" Margin="0,0,0,14">
            <TextBlock Classes="page-title" Text="Clipboard" />
            <TextBlock Classes="page-subtitle"
                       Text="Everything you copy is kept here, searchable. History stays on this computer." />
            <TextBlock Classes="hint" Text="{Binding QuickPasteHint}"
                       IsVisible="{Binding QuickPasteHint, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        </StackPanel>

        <Border Grid.Row="1" Classes="banner-warning" Margin="0,0,0,12" IsVisible="{Binding !IsCaptureEnabled}">
            <Grid ColumnDefinitions="Auto,*">
                <mi:MaterialIcon Kind="AlertOutline" Foreground="{DynamicResource Warning}" Margin="0,0,10,0" />
                <TextBlock Grid.Column="1" Foreground="{DynamicResource BannerWarningText}" FontSize="12" TextWrapping="Wrap"
                           Text="Saving new clips is turned off. Turn it back on in Settings." />
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.3*" MinWidth="260" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" MinWidth="300" MaxWidth="440" />
            </Grid.ColumnDefinitions>
            <!-- List -->
            <Grid Grid.Column="0" RowDefinitions="Auto,Auto,*">
                <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,10">
                    <TextBox x:Name="SearchBox" Grid.Column="0"
                             PlaceholderText="Search, or filter with # @ type: on:"
                             Text="{Binding SearchQuery}">
                        <TextBox.InnerLeftContent>
                            <mi:MaterialIcon Kind="Magnify" Foreground="{DynamicResource TextFaint}" Margin="10,0,0,0" />
                        </TextBox.InnerLeftContent>
                    </TextBox>
                    <Button Grid.Column="1" Classes="icon-btn" Margin="6,0,0,0"
                            Command="{Binding ClearAllCommand}" ToolTip.Tip="Clear history (pinned clips stay)">
                        <mi:MaterialIcon Kind="Broom" Width="18" Height="18" />
                    </Button>
                </Grid>

                <WrapPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,4">
                    <ComboBox ItemsSource="{x:Static vm:ClipboardHistoryViewModel.TypeOptions}"
                              SelectedItem="{Binding SelectedFilter}" MinWidth="110" Margin="0,0,8,8" ToolTip.Tip="Type" />
                    <ComboBox ItemsSource="{Binding DeviceOptions}"
                              SelectedItem="{Binding SelectedDevice}" MinWidth="120" Margin="0,0,8,8" ToolTip.Tip="Copied on" />
                    <ComboBox ItemsSource="{x:Static vm:ClipboardHistoryViewModel.TimeOptions}"
                              SelectedItem="{Binding SelectedTime}" MinWidth="110" Margin="0,0,8,8" ToolTip.Tip="When" />
                    <Border Classes="chip" IsVisible="{Binding SelectedTag, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                            Padding="10,2,4,2" Margin="0,0,8,8">
                        <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                            <mi:MaterialIcon Kind="TagOutline" Width="14" Height="14" Foreground="{DynamicResource TextMuted}" />
                            <TextBlock Text="{Binding SelectedTag}" />
                            <Button Classes="icon-btn" Padding="3" Command="{Binding ClearTagCommand}" ToolTip.Tip="Clear tag filter">
                                <mi:MaterialIcon Kind="Close" Width="12" Height="12" />
                            </Button>
                        </StackPanel>
                    </Border>
                </WrapPanel>

                <Grid Grid.Row="2">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10" IsVisible="{Binding IsEmpty}" MaxWidth="280">
                        <mi:MaterialIcon Kind="ClipboardOutline" Width="36" Height="36" Foreground="{DynamicResource TextFaint}" HorizontalAlignment="Center" />
                        <TextBlock Classes="hint" TextAlignment="Center"
                                   Text="Nothing here yet. Copy some text anywhere on this computer and it shows up here." />
                    </StackPanel>

                    <ListBox x:Name="ClipList" Classes="clips" Background="Transparent" ItemsSource="{Binding FilteredClips}"
                             SelectedItem="{Binding SelectedClip}" IsVisible="{Binding !IsEmpty}">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="vm:ClipboardItemViewModel">
                                <StackPanel Spacing="0">
                                    <Grid ColumnDefinitions="Auto,*" Margin="4,12,4,6" IsVisible="{Binding ShowDayHeader}">
                                        <TextBlock Text="{Binding DayLabel}" Classes="label" Foreground="{DynamicResource TextSecondary}" />
                                        <TextBlock Grid.Column="1" Classes="label" Margin="8,0,0,0" Text="{Binding DayCount, StringFormat='{}{0} items'}" />
                                    </Grid>

                                    <Border Classes="clip-card">
                                        <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto">
                                            <!-- Thumbnail or Type Badge -->
                                            <Panel Grid.RowSpan="2" Margin="0,0,12,0" VerticalAlignment="Top" Width="36" Height="36">
                                                <Border CornerRadius="6" ClipToBounds="True" Width="36" Height="36"
                                                        IsVisible="{Binding Thumbnail, Converter={x:Static ObjectConverters.IsNotNull}}">
                                                    <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" Width="36" Height="36" />
                                                </Border>
                                                <!-- Text clip badge -->
                                                <Border Classes="type-badge" IsVisible="{Binding IsTextClip}">
                                                    <mi:MaterialIcon Kind="{Binding TypeIconKind}" Foreground="{Binding BadgeColor}" />
                                                </Border>
                                                <!-- Image placeholder badge -->
                                                <Border Classes="type-badge" IsVisible="{Binding IsImagePlaceholder}">
                                                    <mi:MaterialIcon Kind="{Binding TypeIconKind}" Foreground="{Binding BadgeColor}" />
                                                </Border>
                                                <!-- File clip badge -->
                                                <Border Classes="type-badge" IsVisible="{Binding IsFileClip}"
                                                        ToolTip.Tip="{Binding FileBadgeText}">
                                                    <mi:MaterialIcon Kind="{Binding TypeIconKind}" Foreground="{Binding BadgeColor}" />
                                                </Border>
                                            </Panel>

                                            <TextBlock Grid.Column="1" Text="{Binding PreviewTitle}" FontSize="13" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextPrimary}" TextTrimming="CharacterEllipsis" />

                                            <!-- Text clip subtitle -->
                                            <TextBlock Grid.Column="1" Grid.Row="1" FontSize="11" Foreground="{DynamicResource TextFaint}" Margin="0,3,0,0"
                                                       IsVisible="{Binding IsTextClip}">
                                                <Run Text="{Binding SourceDevice}" /><Run Text="   " /><Run Text="{Binding FormattedTime}" /><Run Text="   " /><Run Text="{Binding LineCount, StringFormat='{}{0} lines'}" />
                                            </TextBlock>

                                            <!-- Image clip subtitle -->
                                            <TextBlock Grid.Column="1" Grid.Row="1" FontSize="11" Foreground="{DynamicResource TextFaint}" Margin="0,3,0,0"
                                                       IsVisible="{Binding IsImage}">
                                                <Run Text="{Binding SourceDevice}" /><Run Text="   " /><Run Text="{Binding FormattedTime}" /><Run Text="   " /><Run Text="{Binding ImageFormatText}" />
                                            </TextBlock>

                                            <!-- File clip subtitle -->
                                            <TextBlock Grid.Column="1" Grid.Row="1" FontSize="11" Foreground="{DynamicResource TextFaint}" Margin="0,3,0,0"
                                                       IsVisible="{Binding IsFileClip}">
                                                <Run Text="{Binding SourceDevice}" /><Run Text="   " /><Run Text="{Binding FormattedTime}" /><Run Text="   " /><Run Text="{Binding FileSubtitle}" />
                                            </TextBlock>

                                            <mi:MaterialIcon Grid.Column="2" Grid.RowSpan="2" Kind="{Binding StarIcon}" Width="16" Height="16"
                                                             Foreground="{Binding StarColor}" Margin="8,0,0,0" IsVisible="{Binding IsPinned}" />
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Grid>

            <!-- Detail -->
            <Border Grid.Column="2" Classes="glass-card" Padding="16">
                <Grid>
                    <!-- Detail content when selected -->
                    <Grid IsVisible="{Binding SelectedClip, Converter={x:Static ObjectConverters.IsNotNull}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" MinHeight="120" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Action buttons row for Text -->
                        <WrapPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8"
                                    IsVisible="{Binding SelectedClip.IsTextClip}">
                            <Button Classes="primary-btn" Command="{Binding CopyClipCommand}" CommandParameter="{Binding SelectedClip}" Margin="0,0,6,6">
                                <StackPanel Classes="btn"><mi:MaterialIcon Kind="ContentCopy" /><TextBlock Text="Copy" /></StackPanel>
                            </Button>
                            <Button Classes="secondary-btn"
                                    IsVisible="{Binding SelectedClip.IsSensitive}"
                                    Content="{Binding SelectedClip.RevealButtonText}"
                                    Command="{Binding SelectedClip.ToggleRevealCommand}"
                                    ToolTip.Tip="Show or hide masked secret"
                                    Margin="0,0,6,6" />
                            <Button Classes="secondary-btn" Margin="0,0,6,6" ToolTip.Tip="Change case, trim, encode and more">
                                <StackPanel Classes="btn"><mi:MaterialIcon Kind="AutoFix" /><TextBlock Text="Transform" /><mi:MaterialIcon Kind="ChevronDown" Width="14" Height="14" /></StackPanel>
                                <Button.Flyout>
                                    <MenuFlyout ItemsSource="{Binding AvailableTransforms}">
                                        <MenuFlyout.ItemTemplate>
                                            <DataTemplate x:DataType="x:String">
                                                <MenuItem Header="{Binding}"
                                                          Command="{Binding #Root.((vm:ClipboardHistoryViewModel)DataContext).ApplyTransformCommand}"
                                                          CommandParameter="{Binding}" />
                                            </DataTemplate>
                                        </MenuFlyout.ItemTemplate>
                                    </MenuFlyout>
                                </Button.Flyout>
                            </Button>
                            <Button Classes="secondary-btn" Margin="0,0,6,6" ToolTip.Tip="Send this text to a paired computer">
                                <StackPanel Classes="btn"><mi:MaterialIcon Kind="SendOutline" /><TextBlock Text="Send to" /><mi:MaterialIcon Kind="ChevronDown" Width="14" Height="14" /></StackPanel>
                                <Button.Flyout>
                                    <MenuFlyout ItemsSource="{Binding SendablePeers}">
                                        <MenuFlyout.ItemTemplate>
                                            <DataTemplate x:DataType="net:DiscoveredPeer">
                                                <MenuItem Header="{Binding DeviceName}"
                                                          Command="{Binding #Root.((vm:ClipboardHistoryViewModel)DataContext).SendClipToPeerCommand}"
                                                          CommandParameter="{Binding}" />
                                            </DataTemplate>
                                        </MenuFlyout.ItemTemplate>
                                    </MenuFlyout>
                                </Button.Flyout>
                            </Button>
                            <Button Classes="secondary-btn" Command="{Binding ToggleStarCommand}" CommandParameter="{Binding SelectedClip}"
                                    Margin="0,0,6,6">
                                <StackPanel Classes="btn">
                                    <mi:MaterialIcon Kind="{Binding SelectedClip.StarIcon, FallbackValue=StarOutline}" />
                                    <TextBlock Text="{Binding SelectedClip.PinButtonText, FallbackValue=Pin}" />
                                </StackPanel>
                            </Button>
                            <Button Classes="icon-btn danger" Command="{Binding DeleteClipCommand}" CommandParameter="{Binding SelectedClip}"
                                    Margin="0,0,6,6" ToolTip.Tip="Delete this clip">
                                <mi:MaterialIcon Kind="DeleteOutline" Width="18" Height="18" />
                            </Button>
                        </WrapPanel>

                        <!-- Action buttons row for Image -->
                        <WrapPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8"
                                    IsVisible="{Binding SelectedClip.IsImage}">
                            <Button Classes="primary-btn" Command="{Binding CopyImageCommand}" CommandParameter="{Binding SelectedClip}" Margin="0,0,6,6">
                                <StackPanel Classes="btn"><mi:MaterialIcon Kind="ContentCopy" /><TextBlock Text="Copy image" /></StackPanel>
                            </Button>
                            <Button Classes="secondary-btn" Command="{Binding SaveImageAsCommand}" CommandParameter="{Binding SelectedClip}" Margin="0,0,6,6">
                                <StackPanel Classes="btn"><mi:MaterialIcon Kind="ContentSaveOutline" /><TextBlock Text="Save as…" /></StackPanel>
                            </Button>
                            <Button Classes="icon-btn" Command="{Binding OpenImageCommand}" CommandParameter="{Binding SelectedClip}" Margin="0,0,6,6"
                                    ToolTip.Tip="Open in your image viewer">
                                <mi:MaterialIcon Kind="OpenInNew" Width="18" Height="18" />
                            </Button>
                            <Button Classes="secondary-btn" Command="{Binding ToggleStarCommand}" CommandParameter="{Binding SelectedClip}"
                                    Margin="0,0,6,6">
                                <StackPanel Classes="btn">
                                    <mi:MaterialIcon Kind="{Binding SelectedClip.StarIcon, FallbackValue=StarOutline}" />
                                    <TextBlock Text="{Binding SelectedClip.PinButtonText, FallbackValue=Pin}" />
                                </StackPanel>
                            </Button>
                            <Button Classes="icon-btn danger" Command="{Binding DeleteClipCommand}" CommandParameter="{Binding SelectedClip}"
                                    Margin="0,0,6,6" ToolTip.Tip="Delete this clip">
                                <mi:MaterialIcon Kind="DeleteOutline" Width="18" Height="18" />
                            </Button>
                        </WrapPanel>

                        <!-- Action buttons row for Files -->
                        <WrapPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8"
                                    IsVisible="{Binding SelectedClip.IsFileClip}">
                            <Button Classes="primary-btn" Command="{Binding CopyFilesCommand}" CommandParameter="{Binding SelectedClip}" Margin="0,0,6,6">
                                <StackPanel Classes="btn"><mi:MaterialIcon Kind="ContentCopy" /><TextBlock Text="Copy" /></StackPanel>
                            </Button>
                            <Button Classes="secondary-btn" Command="{Binding SendFileToPeerCommand}" CommandParameter="{Binding SelectedClip}" Margin="0,0,6,6">
                                <StackPanel Classes="btn"><mi:MaterialIcon Kind="FileSendOutline" /><TextBlock Text="Send to…" /></StackPanel>
                            </Button>
                            <Button Classes="secondary-btn" Command="{Binding ToggleStarCommand}" CommandParameter="{Binding SelectedClip}"
                                    Margin="0,0,6,6">
                                <StackPanel Classes="btn">
                                    <mi:MaterialIcon Kind="{Binding SelectedClip.StarIcon, FallbackValue=StarOutline}" />
                                    <TextBlock Text="{Binding SelectedClip.PinButtonText, FallbackValue=Pin}" />
                                </StackPanel>
                            </Button>
                            <Button Classes="icon-btn danger" Command="{Binding DeleteClipCommand}" CommandParameter="{Binding SelectedClip}"
                                    Margin="0,0,6,6" ToolTip.Tip="Delete this clip">
                                <mi:MaterialIcon Kind="DeleteOutline" Width="18" Height="18" />
                            </Button>
                        </WrapPanel>

                        <!-- Tags row -->
                        <WrapPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
                            <ItemsControl ItemsSource="{Binding SelectedClip.Tags}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="vm:TagViewModel">
                                        <Border Background="{DynamicResource BgSunken}"
                                                BorderBrush="{DynamicResource BorderSubtle}"
                                                BorderThickness="1"
                                                CornerRadius="12"
                                                Padding="8,3"
                                                Margin="0,0,6,6"
                                                VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                <Rectangle Width="6" Height="6" RadiusX="3" RadiusY="3" Fill="{Binding Brush}" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding DisplayName}" FontSize="11" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" />
                                                <Button Classes="icon-btn" Padding="2" Margin="0"
                                                        ToolTip.Tip="Remove tag"
                                                        IsVisible="{Binding !IsSystem}"
                                                        Command="{Binding $parent[UserControl].((vm:ClipboardHistoryViewModel)DataContext).RemoveTagCommand}"
                                                        CommandParameter="{Binding}">
                                                    <mi:MaterialIcon Kind="Close" Width="11" Height="11" />
                                                </Button>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Button Classes="secondary-btn" Padding="8,4" FontSize="12" Margin="0,0,0,6" VerticalAlignment="Center" ToolTip.Tip="Add a tag">
                                <StackPanel Classes="btn" Spacing="4"><mi:MaterialIcon Kind="TagPlusOutline" Width="14" Height="14" /><TextBlock Text="Tag" /></StackPanel>
                                <Button.Flyout>
                                    <Flyout Placement="Bottom">
                                        <StackPanel Spacing="8" Width="200">
                                            <TextBox x:Name="AddTagBox" PlaceholderText="Tag name"
                                                     Text="{Binding NewTagName, Mode=TwoWay}">
                                                <TextBox.KeyBindings>
                                                    <KeyBinding Gesture="Enter"
                                                                Command="{Binding AddTagCommand}"
                                                                CommandParameter="{Binding Text, ElementName=AddTagBox}" />
                                                </TextBox.KeyBindings>
                                            </TextBox>
                                            <Button Classes="primary-btn" Content="Add" HorizontalAlignment="Stretch"
                                                    Command="{Binding AddTagCommand}"
                                                    CommandParameter="{Binding Text, ElementName=AddTagBox}" />
                                        </StackPanel>
                                    </Flyout>
                                </Button.Flyout>
                            </Button>
                        </WrapPanel>

                        <!-- Preview for Text -->
                        <Grid Grid.Row="2" RowDefinitions="*,Auto" IsVisible="{Binding SelectedClip.IsTextClip}">
                            <TextBox Grid.Row="0" Text="{Binding SelectedClip.DisplayText, Mode=OneWay, FallbackValue=''}"
                                     IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True"
                                     FontFamily="Cascadia Mono, Consolas, Menlo, monospace" FontSize="12"
                                     VerticalContentAlignment="Top" />

                            <!-- Transform Result Section -->
                            <Border Grid.Row="1" Margin="0,10,0,0" Padding="12,10"
                                    Background="{DynamicResource BgSurface}"
                                    BorderBrush="{DynamicResource AccentSoft}"
                                    BorderThickness="1" CornerRadius="8"
                                    IsVisible="{Binding HasTransformResult}">
                                <StackPanel Spacing="8">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Text="Result" Classes="label" VerticalAlignment="Center" />
                                        <Button Grid.Column="1" Classes="icon-btn" Padding="4"
                                                ToolTip.Tip="Close"
                                                Command="{Binding ClearTransformCommand}">
                                            <mi:MaterialIcon Kind="Close" Width="14" Height="14" />
                                        </Button>
                                    </Grid>
                                    <ScrollViewer MaxHeight="140" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                                        <TextBlock Text="{Binding TransformResult}" TextWrapping="Wrap"
                                                   FontFamily="Cascadia Mono, Consolas, Menlo, monospace" FontSize="12"
                                                   Foreground="{DynamicResource TextPrimary}" />
                                    </ScrollViewer>
                                    <Button Classes="primary-btn" Content="Copy result"
                                            HorizontalAlignment="Right"
                                            Command="{Binding CopyTransformResultCommand}" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Preview for Image -->
                        <Border Grid.Row="2" Background="{DynamicResource BgSunken}" CornerRadius="8" Padding="12"
                                IsVisible="{Binding SelectedClip.IsImage}">
                            <Grid RowDefinitions="Auto,*">
                                <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="6" Margin="0,0,0,8">
                                    <Button Classes="secondary-btn" Content="Fit" Padding="8,4" FontSize="11"
                                            Command="{Binding SetImageFitCommand}" />
                                    <Button Classes="secondary-btn" Content="100%" Padding="8,4" FontSize="11"
                                            Command="{Binding SetImageActualSizeCommand}" />
                                </StackPanel>

                                <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                                    <Image Source="{Binding SelectedClip.PreviewImage}"
                                           Stretch="{Binding ImageStretch}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                                </ScrollViewer>
                            </Grid>
                        </Border>

                        <!-- Preview for Files -->
                        <Border Grid.Row="2" Background="{DynamicResource BgSunken}" CornerRadius="8" Padding="12"
                                IsVisible="{Binding SelectedClip.IsFileClip}">
                            <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding SelectedClip.FileClipItems}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="vm:FileClipItemInfo">
                                            <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,4">
                                                <mi:MaterialIcon Grid.Column="0" Kind="{Binding Icon}" Foreground="{DynamicResource TextMuted}" Margin="0,0,8,0" />
                                                <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="12" Foreground="{DynamicResource TextPrimary}"
                                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip.Tip="{Binding Path}" />
                                                <TextBlock Grid.Column="2" Text="{Binding SizeOrType}" FontSize="11" Foreground="{DynamicResource TextMuted}"
                                                           HorizontalAlignment="Right" VerticalAlignment="Center" Margin="8,0,0,0" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Border>

                        <!-- Metadata card for Text -->
                        <Border Grid.Row="3" Classes="meta-card"
                                IsVisible="{Binding SelectedClip.IsTextClip}">
                            <StackPanel Spacing="4">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock Classes="label" Text="Details" VerticalAlignment="Center" />
                                    <Border Classes="nav-badge" IsVisible="{Binding SelectedClip.HasHtml}" Margin="4,0,0,0">
                                        <TextBlock Text="Rich" Foreground="{DynamicResource BadgeViolet}" FontSize="11" />
                                    </Border>
                                    <Border Classes="nav-badge" IsVisible="{Binding SelectedClip.IsSensitive}" Margin="4,0,0,0">
                                        <TextBlock Text="Sensitive" Foreground="{DynamicResource Danger}" FontSize="11" />
                                    </Border>
                                </StackPanel>
                                <TextBlock Classes="hint" FontSize="11" Foreground="{DynamicResource TextSecondary}">
                                    <Run Text="{Binding SelectedClip.ContentType}" /><Run Text=" from " /><Run Text="{Binding SelectedClip.SourceDevice}" /><Run Text=", " /><Run Text="{Binding SelectedClip.FormattedTime}" />
                                </TextBlock>
                                <TextBlock Classes="hint" FontSize="11" Foreground="{DynamicResource TextSecondary}"
                                           IsVisible="{Binding SelectedClip.HasSourceApp}">
                                    <Run Text="App: " /><Run Text="{Binding SelectedClip.SourceApp}" />
                                </TextBlock>
                                <TextBlock Classes="hint" FontSize="11" Foreground="{DynamicResource TextMuted}">
                                    <Run Text="{Binding SelectedClip.LineCount}" /><Run Text=" lines, " /><Run Text="{Binding SelectedClip.WordCount}" /><Run Text=" words, " /><Run Text="{Binding SelectedClip.CharCount, StringFormat='{}{0:N0}'}" /><Run Text=" characters" />
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <!-- Metadata card for Image -->
                        <Border Grid.Row="3" Classes="meta-card"
                                IsVisible="{Binding SelectedClip.IsImage}">
                            <StackPanel Spacing="4">
                                <TextBlock Classes="label" Text="Image details" />
                                <TextBlock Classes="hint" FontSize="11" Foreground="{DynamicResource TextSecondary}"
                                           IsVisible="{Binding SelectedClip.DimensionsText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                    <Run Text="Dimensions: " /><Run Text="{Binding SelectedClip.DimensionsText}" />
                                </TextBlock>
                                <TextBlock Classes="hint" FontSize="11" Foreground="{DynamicResource TextSecondary}">
                                    <Run Text="Format: " /><Run Text="{Binding SelectedClip.ImageFormatText}" />
                                </TextBlock>
                                <TextBlock Classes="hint" FontSize="11" Foreground="{DynamicResource TextSecondary}">
                                    <Run Text="Copied: " /><Run Text="{Binding SelectedClip.TimestampLocal, StringFormat='{}{0:MMM d, yyyy · HH:mm}'}" />
                                </TextBlock>
                                <TextBlock Classes="hint" FontSize="11" Foreground="{DynamicResource TextSecondary}"
                                           IsVisible="{Binding SelectedClip.HasSourceApp}">
                                    <Run Text="App: " /><Run Text="{Binding SelectedClip.SourceApp}" />
                                </TextBlock>
                                <TextBlock Classes="hint" FontSize="11" Foreground="{DynamicResource TextSecondary}">
                                    <Run Text="Device: " /><Run Text="{Binding SelectedClip.SourceDevice}" />
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <!-- Metadata card for Files -->
                        <Border Grid.Row="3" Classes="meta-card"
                                IsVisible="{Binding SelectedClip.IsFileClip}">
                            <StackPanel Spacing="4">
                                <TextBlock Classes="label" Text="File details" />
                                <TextBlock Classes="hint" FontSize="11" Foreground="{DynamicResource TextSecondary}">
                                    <Run Text="{Binding SelectedClip.FilePaths.Count, Mode=OneWay}" /><Run Text=" items from " /><Run Text="{Binding SelectedClip.SourceDevice}" /><Run Text=", " /><Run Text="{Binding SelectedClip.FormattedTime}" />
                                </TextBlock>
                                <TextBlock Classes="hint" FontSize="11" Foreground="{DynamicResource TextSecondary}"
                                           IsVisible="{Binding SelectedClip.HasSourceApp}">
                                    <Run Text="App: " /><Run Text="{Binding SelectedClip.SourceApp}" />
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <!-- Delivery status per device -->
                        <StackPanel Grid.Row="4" IsVisible="{Binding HasDeliveries}">
                            <TextBlock Text="{Binding DeliverySummaryHeader}" Classes="label" Margin="0,16,0,8" />
                            <Border Background="{DynamicResource BgRaised}" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1" CornerRadius="{DynamicResource ControlCornerRadius}" Padding="12">
                                <ItemsControl ItemsSource="{Binding SelectedClipDeliveries}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="vm:ClipDeliveryViewModel">
                                            <Grid ColumnDefinitions="Auto,*,Auto,Auto" Margin="0,4">
                                                <Ellipse Grid.Column="0" Width="8" Height="8" Fill="{Binding StatusBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                                <TextBlock Grid.Column="1" Text="{Binding DeviceName}" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="2" Text="{Binding StatusDisplay}" Foreground="{DynamicResource TextMuted}" Margin="8,0,0,0" VerticalAlignment="Center" />
                                                <mi:MaterialIcon Grid.Column="3" Kind="InformationOutline" Foreground="{DynamicResource Danger}" ToolTip.Tip="{Binding Error}" IsVisible="{Binding HasError}" Margin="6,0,0,0" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <!-- Centered empty state hint when no clip is selected -->
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="6"
                                IsVisible="{Binding SelectedClip, Converter={x:Static ObjectConverters.IsNull}}">
                        <mi:MaterialIcon Kind="CursorDefaultClickOutline" Width="32" Height="32" Foreground="{DynamicResource TextFaint}" HorizontalAlignment="Center" />
                        <TextBlock Classes="hint" Text="Pick a clip to read, copy or send it." HorizontalAlignment="Center" TextAlignment="Center" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <TextBlock Grid.Row="3" Classes="hint" Margin="0,12,0,0" Text="{Binding StatusMessage}" />
    </Grid>
    </Border>
    </ScrollViewer>
</UserControl>
