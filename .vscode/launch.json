{
    "version": "0.2.0",
    "configurations": [
        {
            "name": ".NET Core Launch (Mouser.UI)",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build",
            "program": "${workspaceFolder}/src/Mouser.UI/bin/Debug/net8.0/Mouser.UI.dll",
            "args": [],
